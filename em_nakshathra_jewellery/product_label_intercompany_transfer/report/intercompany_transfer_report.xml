<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_intercompany_delivery_challan" model="ir.actions.report">
        <field name="name">Delivery Challan / Stock Transfer</field>
        <field name="model">label.intercompany.transfer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_label_intercompany_transfer.report_intercompany_transfer_challan</field>
        <field name="report_file">product_label_intercompany_transfer.report_intercompany_transfer_challan</field>
        <field name="print_report_name">'Delivery_Challan_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_label_intercompany_transfer"/>
        <field name="binding_type">report</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_intercompany_transfer_challan">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 10.5px; color: #1e293b; line-height: 1.35;">
                        
                        <!-- Header Banner -->
                        <div style="border-bottom: 2px solid #0f2a4a; padding-bottom: 6px; margin-bottom: 10px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 58%; vertical-align: bottom;">
                                        <div style="font-size: 18px; font-weight: 800; color: #0f2a4a; text-transform: uppercase; letter-spacing: 0.5px;">
                                            DELIVERY CHALLAN
                                        </div>
                                        <div style="font-size: 10px; font-weight: 600; color: #475569; text-transform: uppercase; margin-top: 1px;">
                                            Inter-Company Stock Transfer (Rule 55 of CGST Rules)
                                        </div>
                                        <div style="font-size: 9px; color: #64748b; font-style: italic;">
                                            (Goods moved between sister entities for retail display &amp; sale)
                                        </div>
                                    </td>
                                    <td style="width: 42%; text-align: right; vertical-align: bottom;">
                                        <div style="display: inline-block; background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 10px; text-align: right;">
                                            <div style="font-size: 9px; color: #64748b; text-transform: uppercase; font-weight: 700;">Challan Reference</div>
                                            <div style="font-size: 13px; font-weight: 800; color: #0f2a4a; font-family: monospace;"><t t-esc="doc.name"/></div>
                                            <div style="font-size: 9.5px; color: #334155; margin-top: 1px;">
                                                <strong>Date:</strong> <span t-esc="doc.transfer_date" t-options='{"widget": "date"}'/>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Consignor & Consignee Side-by-Side Cards -->
                        <table style="width: 100%; border-collapse: separate; border-spacing: 6px 0; margin-bottom: 8px;">
                            <tr>
                                <!-- Consignor (Source) Card -->
                                <td style="width: 50%; vertical-align: top; border: 1px solid #cbd5e1; border-radius: 5px; background-color: #ffffff; padding: 0;">
                                    <div style="background-color: #0f2a4a; color: #ffffff; font-size: 9.5px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; border-top-left-radius: 4px; border-top-right-radius: 4px; letter-spacing: 0.5px;">
                                        Consignor (Dispatching Entity)
                                    </div>
                                    <div style="padding: 6px 8px; font-size: 10px;">
                                        <div style="font-size: 11.5px; font-weight: 800; color: #0f2a4a; margin-bottom: 2px;">
                                            <t t-esc="doc.source_company_id.name"/>
                                        </div>
                                        <t t-if="doc.source_branch_id">
                                            <div style="color: #334155;"><strong>Branch:</strong> <t t-esc="doc.source_branch_id.name"/></div>
                                        </t>
                                        <div style="color: #475569; font-size: 9.5px; margin-top: 1px;">
                                            <t t-if="doc.source_company_id.street"><t t-esc="doc.source_company_id.street"/>, </t>
                                            <t t-if="doc.source_company_id.city"><t t-esc="doc.source_company_id.city"/>, </t>
                                            <t t-if="doc.source_company_id.state_id"><t t-esc="doc.source_company_id.state_id.name"/> </t>
                                            <t t-if="doc.source_company_id.zip">- <t t-esc="doc.source_company_id.zip"/></t>
                                        </div>
                                        <div style="margin-top: 3px;">
                                            <strong>GSTIN:</strong>
                                            <span style="font-family: monospace; font-weight: 800; background-color: #e2e8f0; color: #0f2a4a; padding: 1px 4px; border-radius: 3px; font-size: 9.5px;">
                                                <t t-esc="doc.source_company_id.vat or 'N/A'"/>
                                            </span>
                                        </div>
                                        <div style="font-size: 9.5px; color: #334155; margin-top: 2px;">
                                            <strong>State:</strong> <t t-esc="doc.source_company_id.state_id.name or 'N/A'"/> (Code: <t t-esc="doc.source_company_id.state_id.code or 'N/A'"/>)
                                            <span style="margin-left: 8px;"><strong>Location:</strong> <t t-esc="doc.source_location_id.complete_name or 'Default'"/></span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Consignee (Destination) Card -->
                                <td style="width: 50%; vertical-align: top; border: 1px solid #cbd5e1; border-radius: 5px; background-color: #ffffff; padding: 0;">
                                    <div style="background-color: #334155; color: #ffffff; font-size: 9.5px; font-weight: 700; text-transform: uppercase; padding: 3px 8px; border-top-left-radius: 4px; border-top-right-radius: 4px; letter-spacing: 0.5px;">
                                        Consignee (Receiving Entity)
                                    </div>
                                    <div style="padding: 6px 8px; font-size: 10px;">
                                        <div style="font-size: 11.5px; font-weight: 800; color: #0f2a4a; margin-bottom: 2px;">
                                            <t t-esc="doc.dest_company_id.name"/>
                                        </div>
                                        <t t-if="doc.dest_branch_id">
                                            <div style="color: #334155;"><strong>Branch:</strong> <t t-esc="doc.dest_branch_id.name"/></div>
                                        </t>
                                        <div style="color: #475569; font-size: 9.5px; margin-top: 1px;">
                                            <t t-if="doc.dest_company_id.street"><t t-esc="doc.dest_company_id.street"/>, </t>
                                            <t t-if="doc.dest_company_id.city"><t t-esc="doc.dest_company_id.city"/>, </t>
                                            <t t-if="doc.dest_company_id.state_id"><t t-esc="doc.dest_company_id.state_id.name"/> </t>
                                            <t t-if="doc.dest_company_id.zip">- <t t-esc="doc.dest_company_id.zip"/></t>
                                        </div>
                                        <div style="margin-top: 3px;">
                                            <strong>GSTIN:</strong>
                                            <span style="font-family: monospace; font-weight: 800; background-color: #e2e8f0; color: #0f2a4a; padding: 1px 4px; border-radius: 3px; font-size: 9.5px;">
                                                <t t-esc="doc.dest_company_id.vat or 'N/A'"/>
                                            </span>
                                        </div>
                                        <div style="font-size: 9.5px; color: #334155; margin-top: 2px;">
                                            <strong>State:</strong> <t t-esc="doc.dest_company_id.state_id.name or 'N/A'"/> (Code: <t t-esc="doc.dest_company_id.state_id.code or 'N/A'"/>)
                                            <span style="margin-left: 8px;"><strong>Location:</strong> <t t-esc="doc.dest_location_id.complete_name or 'Default'"/></span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- Linked Documents & Compliance Strip -->
                        <div style="background-color: #f8fafc; border: 1px solid #cbd5e1; border-radius: 4px; padding: 5px 8px; margin-bottom: 8px; font-size: 9.5px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 32%; vertical-align: top;">
                                        <div><strong>Sale Order (Src):</strong> <t t-esc="doc.result_so_id.name or 'N/A'"/></div>
                                        <div><strong>Customer Invoice:</strong> <t t-esc="doc.result_invoice_id.name or 'N/A'"/></div>
                                    </td>
                                    <td style="width: 32%; vertical-align: top;">
                                        <div><strong>Purchase Order (Dest):</strong> <t t-esc="doc.result_po_id.name or 'N/A'"/></div>
                                        <div><strong>Vendor Bill:</strong> <t t-esc="doc.result_bill_id.name or 'N/A'"/></div>
                                    </td>
                                    <td style="width: 36%; vertical-align: top;">
                                        <div><strong>Tax Applied:</strong> <span style="font-weight: 700; color: #0f2a4a;"><t t-esc="doc.sale_tax_id.name or doc.purchase_tax_id.name or '3% GST'"/></span></div>
                                        <div><strong>HSN Codes:</strong> 7113 (Gold Ornaments) / 7102 (Diamonds)</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Labels Table -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 8px; font-size: 9.5px; border: 1px solid #cbd5e1;">
                            <thead>
                                <tr style="background-color: #0f2a4a; color: #ffffff; text-align: center;">
                                    <th style="width: 3%; padding: 5px 3px; border: 1px solid #0f2a4a;">#</th>
                                    <th style="width: 14%; padding: 5px 4px; text-align: left; border: 1px solid #0f2a4a;">Label No.</th>
                                    <th style="width: 14%; padding: 5px 4px; text-align: left; border: 1px solid #0f2a4a;">Barcode</th>
                                    <th style="width: 21%; padding: 5px 4px; text-align: left; border: 1px solid #0f2a4a;">Product Description</th>
                                    <th style="width: 8%; padding: 5px 3px; border: 1px solid #0f2a4a;">Purity</th>
                                    <th style="width: 8%; padding: 5px 4px; text-align: right; border: 1px solid #0f2a4a;">Gross Wt (g)</th>
                                    <th style="width: 8%; padding: 5px 4px; text-align: right; border: 1px solid #0f2a4a;">Net Wt (g)</th>
                                    <th style="width: 8%; padding: 5px 4px; text-align: right; border: 1px solid #0f2a4a;">Fine Wt (g)</th>
                                    <th style="width: 8%; padding: 5px 4px; text-align: right; border: 1px solid #0f2a4a;">Rate / g (₹)</th>
                                    <th style="width: 8%; padding: 5px 4px; text-align: right; border: 1px solid #0f2a4a;">Taxable (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="sl_no" t-value="1"/>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr t-attf-style="background-color: #{'#ffffff' if sl_no % 2 != 0 else '#f8fafc'}; border-bottom: 1px solid #e2e8f0;">
                                        <td style="text-align: center; padding: 4px 2px; border: 1px solid #e2e8f0;"><t t-esc="sl_no"/></td>
                                        <td style="font-weight: 700; color: #0f2a4a; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="line.label_id.name"/></td>
                                        <td style="font-family: monospace; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="line.barcode or '-'"/></td>
                                        <td style="padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="line.product_id.name"/></td>
                                        <td style="text-align: center; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="line.purity_id.name or '-'"/></td>
                                        <td style="text-align: right; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="'%.3f' % line.gross_weight"/></td>
                                        <td style="text-align: right; font-weight: 700; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="'%.3f' % line.net_weight"/></td>
                                        <td style="text-align: right; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="'%.3f' % line.fine_weight"/></td>
                                        <td style="text-align: right; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="'%.2f' % line.rate_per_gram"/></td>
                                        <td style="text-align: right; font-weight: 700; padding: 4px; border: 1px solid #e2e8f0;"><t t-esc="'%.2f' % line.subtotal"/></td>
                                    </tr>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #f1f5f9; font-weight: 800; border-top: 2px solid #0f2a4a; border-bottom: 2px solid #0f2a4a;">
                                    <td colspan="5" style="text-align: right; padding: 5px 6px; border: 1px solid #cbd5e1; color: #0f2a4a;">TOTAL:</td>
                                    <td style="text-align: right; padding: 5px 4px; border: 1px solid #cbd5e1;"><t t-esc="'%.3f' % doc.total_gross_weight"/></td>
                                    <td style="text-align: right; padding: 5px 4px; border: 1px solid #cbd5e1;"><t t-esc="'%.3f' % doc.total_net_weight"/></td>
                                    <td style="text-align: right; padding: 5px 4px; border: 1px solid #cbd5e1;"><t t-esc="'%.3f' % doc.total_fine_weight"/></td>
                                    <td style="border: 1px solid #cbd5e1;"></td>
                                    <td style="text-align: right; padding: 5px 4px; border: 1px solid #cbd5e1; color: #0f2a4a;">₹ <t t-esc="'%.2f' % doc.total_cost"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Totals & GST Summary Section -->
                        <table style="width: 100%; border-collapse: separate; border-spacing: 6px 0; margin-bottom: 12px;">
                            <tr>
                                <!-- Left Block: GST Breakdown & Remarks -->
                                <td style="width: 55%; vertical-align: top; border: 1px solid #cbd5e1; border-radius: 4px; padding: 6px 8px; background-color: #fafafa; font-size: 9.5px;">
                                    <div style="font-weight: 700; color: #0f2a4a; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 2px; margin-bottom: 4px;">
                                        Tax &amp; Compliance Summary
                                    </div>
                                    <t t-if="doc.sale_tax_id">
                                        <t t-set="tax_data" t-value="doc.sale_tax_id.compute_all(doc.total_cost, currency=doc.source_company_id.currency_id, quantity=1.0)"/>
                                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 4px;">
                                            <t t-foreach="tax_data.get('taxes', [])" t-as="tline">
                                                <tr>
                                                    <td style="color: #475569; padding: 1px 0;"><t t-esc="tline['name']"/>:</td>
                                                    <td style="text-align: right; font-weight: 700; padding: 1px 0;">₹ <t t-esc="'%.2f' % tline['amount']"/></td>
                                                </tr>
                                            </t>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 4px;">
                                            <t t-if="doc.is_interstate">
                                                <tr>
                                                    <td style="color: #475569; padding: 1px 0;">IGST @ 3.0%:</td>
                                                    <td style="text-align: right; font-weight: 700; padding: 1px 0;">₹ <t t-esc="'%.2f' % doc.total_tax"/></td>
                                                </tr>
                                            </t>
                                            <t t-else="">
                                                <tr>
                                                    <td style="color: #475569; padding: 1px 0;">CGST @ 1.5%:</td>
                                                    <td style="text-align: right; font-weight: 700; padding: 1px 0;">₹ <t t-esc="'%.2f' % (doc.total_tax / 2.0)"/></td>
                                                </tr>
                                                <tr>
                                                    <td style="color: #475569; padding: 1px 0;">SGST @ 1.5%:</td>
                                                    <td style="text-align: right; font-weight: 700; padding: 1px 0;">₹ <t t-esc="'%.2f' % (doc.total_tax / 2.0)"/></td>
                                                </tr>
                                            </t>
                                        </table>
                                    </t>

                                    <div style="border-top: 1px dashed #cbd5e1; padding-top: 4px; margin-top: 4px; color: #475569;">
                                        <strong>Remarks:</strong>
                                        <span t-esc="doc.notes or 'Transferred in tamper-evident sealed condition. Verified weights against hallmarked tag specifications.'"/>
                                    </div>
                                    <div style="font-size: 8.5px; color: #64748b; font-style: italic; margin-top: 4px;">
                                        <strong>Declaration:</strong> We declare that this delivery challan represents authentic gold jewellery stock moved exclusively between registered sister entities without commercial margin on transfer value.
                                    </div>
                                </td>

                                <!-- Right Block: Financial Summary -->
                                <td style="width: 45%; vertical-align: top; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0; background-color: #ffffff;">
                                    <table style="width: 100%; border-collapse: collapse; font-size: 9.5px;">
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 4px 8px; color: #475569;">Total Items / Labels:</td>
                                            <td style="padding: 4px 8px; text-align: right; font-weight: 700;"><t t-esc="doc.total_labels"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 4px 8px; color: #475569;">Total Gross Weight:</td>
                                            <td style="padding: 4px 8px; text-align: right;"><t t-esc="'%.3f' % doc.total_gross_weight"/> g</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 4px 8px; color: #475569;">Total Net Weight:</td>
                                            <td style="padding: 4px 8px; text-align: right; font-weight: 700;"><t t-esc="'%.3f' % doc.total_net_weight"/> g</td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 4px 8px; color: #475569;">Total Taxable Value:</td>
                                            <td style="padding: 4px 8px; text-align: right; font-weight: 700;">₹ <t t-esc="'%.2f' % doc.total_cost"/></td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #e2e8f0;">
                                            <td style="padding: 4px 8px; color: #475569;">Tax (<t t-esc="doc.sale_tax_id.name or '3% GST'"/>):</td>
                                            <td style="padding: 4px 8px; text-align: right; font-weight: 700;">₹ <t t-esc="'%.2f' % doc.total_tax"/></td>
                                        </tr>
                                        <tr style="background-color: #0f2a4a; color: #ffffff; font-size: 11px; font-weight: 800;">
                                            <td style="padding: 6px 8px;">Grand Total Value:</td>
                                            <td style="padding: 6px 8px; text-align: right;">₹ <t t-esc="'%.2f' % doc.total_amount_with_tax"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- Signatures Section -->
                        <div style="page-break-inside: avoid; margin-top: 15px; padding-top: 5px;">
                            <table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 9.5px;">
                                <tr>
                                    <td style="width: 25%; padding: 0 8px; vertical-align: bottom;">
                                        <div style="height: 38px;"></div>
                                        <div style="border-top: 1px solid #475569; padding-top: 4px;">
                                            <strong style="color: #0f2a4a;">Prepared By</strong><br/>
                                            <span style="color: #64748b; font-size: 8.5px;">(<t t-esc="doc.user_id.name or 'Staff'"/>)</span>
                                        </div>
                                    </td>
                                    <td style="width: 25%; padding: 0 8px; vertical-align: bottom;">
                                        <div style="height: 38px;"></div>
                                        <div style="border-top: 1px solid #475569; padding-top: 4px;">
                                            <strong style="color: #0f2a4a;">Courier / Custodian</strong><br/>
                                            <span style="color: #64748b; font-size: 8.5px;">(Signature &amp; Date)</span>
                                        </div>
                                    </td>
                                    <td style="width: 25%; padding: 0 8px; vertical-align: bottom;">
                                        <div style="height: 38px;"></div>
                                        <div style="border-top: 1px solid #475569; padding-top: 4px;">
                                            <strong style="color: #0f2a4a;">Authorized Signatory</strong><br/>
                                            <span style="color: #64748b; font-size: 8.5px;">(Consignor / Dispatch)</span>
                                        </div>
                                    </td>
                                    <td style="width: 25%; padding: 0 8px; vertical-align: bottom;">
                                        <div style="height: 38px;"></div>
                                        <div style="border-top: 1px solid #475569; padding-top: 4px;">
                                            <strong style="color: #0f2a4a;">Receiver's Seal &amp; Sign</strong><br/>
                                            <span style="color: #64748b; font-size: 8.5px;">(Consignee Showroom)</span>
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
