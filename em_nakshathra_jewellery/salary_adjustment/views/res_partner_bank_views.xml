<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_inherit_salary_adjustment" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.salary.adjustment</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <field name="acc_number" position="after">
                <field name="routing_code"/>
            </field>
        </field>
    </record>

    <record id="view_partner_bank_tree_inherit_salary_adjustment" model="ir.ui.view">
        <field name="name">res.partner.bank.tree.inherit.salary.adjustment</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_tree"/>
        <field name="arch" type="xml">
            <field name="acc_number" position="after">
                <field name="routing_code"/>
            </field>
        </field>
    </record>
</odoo>
