<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_salary_adjustment" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.salary.adjustment</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_empty" type="object" icon="fa-calendar">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="experience_in_months"/>
                        </span>
                        <span class="o_stat_text">Months Exp.</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Salary Adjustment Info" name="salary_adjustment_info">
                    <group>
                        <group string="GCC / Regional Identification">
                            <field name="national_id"/>
                            <field name="labor_card_no"/>
                        </group>
                        <group string="India Statutory Identification">
                            <field name="apply_esi"/>
                            <field name="esi_no"/>
                            <field name="pf_uan_no"/>
                        </group>
                        <group string="Malaysia Statutory Identification">
                            <field name="epf_no"/>
                            <field name="socso_no"/>
                            <field name="tax_no"/>
                        </group>
                        <group string="Employment &amp; Experience Info">
                            <field name="joining_date" readonly="1"/>
                            <field name="company_experience" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
