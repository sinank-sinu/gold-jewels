<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Salary Rule for Advance Salary Deduction -->
    <record id="hr_rule_salary_advance" model="hr.salary.rule">
        <field name="code">SAD</field>
        <field name="name">Salary Advance Deduction</field>
        <field name="category_id" ref="hr_payroll_community.DED"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.SAD and - (inputs.SAD.amount)</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="sequence" eval="195"/>
    </record>

    <!-- Rule Input for SAD -->
    <record id="hr_rule_input_salary_advance" model="hr.rule.input">
        <field name="code">SAD</field>
        <field name="name">Salary Advance Deduction</field>
        <field name="input_id" ref="hr_rule_salary_advance"/>
    </record>

    <!-- Salary Rule for Loan Deduction -->
    <record id="hr_rule_salary_loan" model="hr.salary.rule">
        <field name="code">LO</field>
        <field name="name">Loan Deduction</field>
        <field name="category_id" ref="hr_payroll_community.DED"/>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs.LO and - (inputs.LO.amount)</field>
        <field name="appears_on_payslip" eval="True"/>
        <field name="sequence" eval="196"/>
    </record>

    <!-- Rule Input for LO -->
    <record id="hr_rule_input_salary_loan" model="hr.rule.input">
        <field name="code">LO</field>
        <field name="name">Loan Deduction</field>
        <field name="input_id" ref="hr_rule_salary_loan"/>
    </record>

    <!-- Link rule to Base structure -->
    <record id="hr_payroll_community.structure_base" model="hr.payroll.structure">
        <field name="rule_ids" eval="[(4, ref('hr_rule_salary_advance')), (4, ref('hr_rule_salary_loan'))]"/>
    </record>

    <!-- Link rule to Salesman Target Incentive Structure -->
    <record id="salesman_target_incentive.hr_salary_structure_sales_incentive" model="hr.payroll.structure">
        <field name="rule_ids" eval="[(4, ref('hr_rule_salary_advance')), (4, ref('hr_rule_salary_loan'))]"/>
    </record>
</odoo>
