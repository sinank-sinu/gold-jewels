<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_label" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.label</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_id']" position="after">
                <field name="label_id" domain="[('product_id', '=', product_id)]"/>
            </xpath>
        </field>
    </record>
</odoo>
