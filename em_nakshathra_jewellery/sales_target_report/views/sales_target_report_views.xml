
<odoo>
    <record id="view_salesman_target_report_wizard" model="ir.ui.view">
        <field name="name">salesman.target.report.wizard.form</field>
        <field name="model">salesman.target.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Salesman Target Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="salesman_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object" string="Generate XLSX" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_salesman_target_report_wizard" model="ir.actions.act_window">
        <field name="name">Salesman Target Report</field>
        <field name="res_model">salesman.target.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_salesman_target_report"
              name="Sales Target Report"
              parent="salesman_target_incentive.menu_salesman_target_root"
              action="action_salesman_target_report_wizard"
              sequence="999"/>
</odoo>
