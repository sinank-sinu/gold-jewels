<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_branch_rule" model="ir.rule">
        <field name="name">Product Template Branch Restriction</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">
            [ '|', ('branch_id', '=', False), ('branch_id', 'in', user.branch_ids.ids) ]
        </field>
        <field name="groups" eval="[(4, ref('custom_label_user.group_product_label_user'))]"/>
    </record>

    <record id="product_template_branch_rule_manager" model="ir.rule">
        <field name="name">Product Template Branch Restriction Manager Bypass</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="product_product_branch_rule" model="ir.rule">
        <field name="name">Product Variant Branch Restriction</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">
            [ '|', ('branch_id', '=', False), ('branch_id', 'in', user.branch_ids.ids) ]
        </field>
        <field name="groups" eval="[(4, ref('custom_label_user.group_product_label_user'))]"/>
    </record>

    <record id="product_product_branch_rule_manager" model="ir.rule">
        <field name="name">Product Variant Branch Restriction Manager Bypass</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>