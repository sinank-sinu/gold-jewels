<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_location_wise_stock_tree" model="ir.ui.view">
        <field name="name">location.wise.stock.tree</field>
        <field name="model">location.wise.stock</field>

        <field name="arch" type="xml">
            <tree create="0" delete="0" edit="0">

                <field name="product_id"/>
                <field name="location_id"/>
                <field name="quantity"/>
                <field name="available_quantity"/>
                <field name="uom_id"/>

            </tree>
        </field>
    </record>

    <record id="action_location_wise_stock" model="ir.actions.act_window">
        <field name="name">Location Wise Products</field>
        <field name="res_model">location.wise.stock</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>