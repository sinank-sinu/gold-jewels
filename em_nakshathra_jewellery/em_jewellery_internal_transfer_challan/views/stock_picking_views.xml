<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_challan_transit" model="ir.ui.view">
        <field name="name">stock.picking.form.challan.transit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Challan / Transit Details" name="challan_transit_details" invisible="picking_type_code != 'internal'">
                    <group>
                        <group string="Transport &amp; E-Way Information">
                            <field name="eway_bill_number" placeholder="e.g. 231456789012"/>
                            <field name="vehicle_number" placeholder="e.g. KL 07 CD 1234"/>
                            <field name="transporter_name" placeholder="Courier docket / Driver / Staff name"/>
                            <field name="transfer_batch_no" placeholder="Batch or consignment number"/>
                        </group>
                        <group string="Challan Remarks">
                            <field name="challan_notes" placeholder="Notes printed under the verification section of the challan..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

