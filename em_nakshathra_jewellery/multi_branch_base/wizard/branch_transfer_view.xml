<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_branch_transfer_wizard" model="ir.ui.view">
        <field name="name">sale.order.branch.transfer.wizard.form</field>
        <field name="model">sale.order.branch.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Sale Orders to Branch">
                <group>
                    <field name="branch_id"/>
                </group>
                <footer>
                    <button string="Transfer"
                            type="object"
                            name="action_transfer_branch"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_sale_order_branch_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Transfer Branch</field>
        <field name="res_model">sale.order.branch.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>




</odoo>