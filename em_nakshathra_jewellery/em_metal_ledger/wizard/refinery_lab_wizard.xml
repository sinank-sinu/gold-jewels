<odoo>
    <record id="view_refinery_lab_wizard_form" model="ir.ui.view">
        <field name="name">refinery.lab.wizard.form</field>
        <field name="model">refinery.lab.wizard</field>
        <field name="arch" type="xml">
            <form string="Refinery Lab XLSX">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print_xlsx"
                            type="object"
                            string="Print XLSX"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_refinery_lab_wizard" model="ir.actions.act_window">
        <field name="name">Refinery Lab XLSX</field>
        <field name="res_model">refinery.lab.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>