<odoo>
    <record id="view_refinery_margin_wizard_form" model="ir.ui.view">
        <field name="name">refinery.margin.wizard.form</field>
        <field name="model">refinery.margin.wizard</field>
        <field name="arch" type="xml">
            <form string="Refinery Margin XLSX">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print_xlsx"
                            string="Print XLSX"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_refinery_margin_wizard" model="ir.actions.act_window">
        <field name="name">Refinery Margin XLSX</field>
        <field name="res_model">refinery.margin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>