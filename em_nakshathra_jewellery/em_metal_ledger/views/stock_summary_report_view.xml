<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard View -->
    <record id="view_stock_summary_report_wizard_form" model="ir.ui.view">
        <field name="name">stock.summary.report.wizard.form</field>
        <field name="model">stock.summary.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Stock Summary Report">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="branch_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button name="action_print_xlsx" string="Print XLSX" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_summary_report_wizard" model="ir.actions.act_window">
        <field name="name">Stock Summary Report Wizard</field>
        <field name="res_model">stock.summary.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Report Line View -->
    <record id="view_stock_summary_report_line_tree" model="ir.ui.view">
        <field name="name">stock.summary.report.line.tree</field>
        <field name="model">stock.summary.report.line</field>
        <field name="arch" type="xml">
            <tree string="Stock Summary Report" create="false" edit="false" delete="false">
                <field name="product_template_id" invisible="1"/>
                <field name="product_id" column_invisible="1"/>
                <!--Attributes-->
                <!-- <field name="attribute_values"/> -->
                <field name="type_value"/>
                <field name="variety_value"/>
                <field name="design_value"/>
                <field name="size_value"/>
                <field name="stone_colour_value"/>
                <field name="metal_colour_value"/>
                <field name ="purity_id"/>
                <field name="ageing" string="Ageing"/>
                <field name="opening_pcs" sum="Total Opening PCs"/>
                <field name="opening_gross_weight" sum="Total Opening Gross"/>
                <field name="opening_net_weight" sum="Total Opening Net"/>

                <field name="in_pcs" sum="Total In PCs"/>
                <field name="in_gross_weight" sum="Total In Gross"/>
                <field name="in_net_weight" sum="Total In Net"/>

                <field name="out_pcs" sum="Total Out PCs"/>
                <field name="out_gross_weight" sum="Total Out Gross"/>
                <field name="out_net_weight" sum="Total Out Net"/>

                <field name="closing_pcs" sum="Total Closing PCs"/>
                <field name="closing_gross_weight" sum="Total Closing Gross"/>
                <field name="closing_net_weight" sum="Total Closing Net"/>

                <field name="average_inventory" sum="Total Avg Inventory"/>
                <field name="no_of_days" avg="Average Days"/>
                <field name="min_stock_level" sum="Total Min Stock"/>
                <field name="turnover_ratio" sum="Total Turnover Ratio"/>
                <field name="dio" avg="Average DIO"/>
                <field name="stock_gap" sum="Total Stock Gap"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_summary_report_line_search" model="ir.ui.view">
        <field name="name">stock.summary.report.line.search</field>
        <field name="model">stock.summary.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_template_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_metal_ledger_reporting"
              name="Stock Summary Report"
              parent="menu_metal_ledger_root"
              action="action_stock_summary_report_wizard"
              sequence="40"/>

<!--    <menuitem id="menu_stock_summary_report"-->
<!--              name="Stock Summary Report"-->
<!--              parent="menu_metal_ledger_reporting"-->
<!--              action="action_stock_summary_report_wizard"-->
<!--              sequence="10"/>-->

</odoo>
