<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_replacement_costing_item_tree" model="ir.ui.view">
        <field name="name">replacement.costing.item.tree</field>
        <field name="model">replacement.costing.item</field>
        <field name="arch" type="xml">
            <tree string="Replacement Costing" create="False" edit="False">
                <field name="sale_date" string="Date"/>
                <field name="salesman_id"/>
                <field name="sales_voucher_name"/>
                <field name="label_id"/>
                <field name="product_id"/>
                <field name="purity_id" string="Caret"/>
                <field name="purity"/>
                <field name="pcs_from_sale"/>
                <field name="gross_weight_purchase"/>
                <field name="net_weight_purchase"/>
                <field name="diamond_weight_purchase"/>
                <field name="stone_weight_purchase"/>
                <field name="purchase_making_charge_type"/>
                <field name="purchase_mc_percent_fine"/>
                <field name="purchase_mc_amount"/>
                <field name="purchase_metal_rate"/>
                <field name="diamond_amount_purchase"/>
                <field name="stone_amount_purchase"/>
                <field name="purchase_mc_fine"/>
                <!-- <field name="rate_fine_next_day_1pm"/> -->
                <field name="metal_qty_on_fine" optional="show"/>
                <field name="metal_amount_purchase" optional="show"/>
                <field name="purchase_mc_on_fine_qty" optional="show"/>
                <field name="purchase_mc_value" optional="show"/>
                <field name="purchase_metal_amount_on_fine" optional="show"/>
                <field name="purchase_mc_amount_on_fine" optional="show"/>
                <field name="taxable_amount_purchase" optional="show"/>
                <field name="rate_fine_next_day_1pm"/>
                <field name="sale_mc_percent" optional="show"/>
                <field name="sale_metal_rate_manual"/>
                <field name="metal_amount_sale"/>
                <field name="mc_amount_sale"/>
                <field name="diamond_amount_sale"/>
                <field name="stone_amount_sale"/>
                <field name="sale_taxable_amount" optional="show"/>
                <field name="metal_profit" optional="show"/>
                <field name="mc_profit" optional="show"/>
                <field name="diamond_profit" optional="show"/>
                <field name="stone_profit" optional="show"/>
                <field name="total_gp" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_replacement_costing_vault_item_tree" model="ir.ui.view">
        <field name="name">replacement.costing.vault.item.tree</field>
        <field name="model">replacement.costing.item</field>
        <field name="arch" type="xml">
            <tree string="Replacement Costing Vault Item" create="False" edit="False">
                <field name="sale_date" string="Date"/>
                <field name="salesman_id"/>
                <field name="sales_voucher_name"/>
                <field name="product_id"/>
                <field name="purity_id" string="Caret"/>
                <field name="purity"/>
                <field name="gross_weight_purchase"/>
                <field name="net_weight_purchase"/>
                <field name="diamond_weight_purchase"/>
                <field name="stone_weight_purchase"/>
                <field name="purchase_making_charge_type"/>
                <field name="purchase_mc_percent_fine"/>
                <field name="purchase_mc_fine"/>
                <!-- <field name="rate_fine_next_day_1pm"/> -->
                <field name="metal_qty_on_fine" optional="show"/>
                <field name="purchase_metal_amount_on_fine" optional="show"/>
                <field name="purchase_mc_amount_on_fine" optional="show"/>
                <field name="rate_fine_next_day_1pm"/>
                <field name="sale_mc_percent" optional="show"/>
                <field name="sale_metal_rate_manual"/>
                <field name="metal_amount_sale"/>
                <field name="mc_amount_sale"/>
                <field name="diamond_amount_sale"/>
                <field name="stone_amount_sale"/>
                <field name="sale_taxable_amount" optional="show"/>
                <field name="metal_profit" optional="show"/>
                <field name="mc_profit" optional="show"/>
                <field name="diamond_profit" optional="show"/>
                <field name="stone_profit" optional="show"/>
                <field name="total_gp" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_replacement_costing_item" model="ir.actions.act_window">
        <field name="name">Replacement Costing Item Wise</field>
        <field name="res_model">replacement.costing.item</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_replacement_costing_item_tree"/>
        <field name="domain">[('product_id.product_tmpl_id.is_vault_item', '=', False)]</field>
    </record>

    <record id="action_replacement_costing_vault_item" model="ir.actions.act_window">
        <field name="name">Replacement Costing Vault Item Wise</field>
        <field name="res_model">replacement.costing.item</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_replacement_costing_vault_item_tree"/>
        <field name="domain">[('product_id.product_tmpl_id.is_vault_item', '=', True)]</field>
    </record>

    <menuitem id="menu_replacement_costing_item_head"
              name="Replacement Costing Item"
              parent="menu_metal_ledger_root"
              sequence="50"/>

     <menuitem id="menu_replacement_costing_item"
              name="Replacement Costing Item"
              action="action_replacement_costing_item"
              parent="menu_replacement_costing_item_head"
              sequence="10"/>

     <menuitem id="menu_replacement_costing_vault_item"
              name="Replacement Costing Vault Item"
              action="action_replacement_costing_vault_item"
              parent="menu_replacement_costing_item_head"
              sequence="20"/>
</odoo>
