<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_job_work_report_tree" model="ir.ui.view">
        <field name="name">job.work.report.tree</field>
        <field name="model">job.work.report</field>
        <field name="arch" type="xml">
            <tree string="Job Work Report" create="false" edit="false" 
                  decoration-danger="type == 'issue'" 
                  decoration-success="type == 'receive'">
                <field name="date"/>
                <field name="voucher_name"/>
                <field name="type" optional="hide"/>
                <field name="job_type" />
                <field name="partner_id"/>
                <field name="gross_weight" sum="Total Gross Weight" optional="show"/>
                <field name="stock_in" string="Fine Issue" sum="Total Fine Issue"/>
                <field name="stock_out" string="Fine Receipt" sum="Total Fine Receipt"/>
                <field name="purity_id"/>
                <field name="branch_id"/>
                <field name="balance_weight" string="Balance"/>
            </tree>
        </field>
    </record>

    <record id="view_job_work_report_form" model="ir.ui.view">
        <field name="name">job.work.report.form</field>
        <field name="model">job.work.report</field>
        <field name="arch" type="xml">
            <form string="Job Work Report" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="voucher_name"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="purity_id"/>
                            <field name="branch_id"/>
                            <field name="job_type" optional="hide"/>
                            <field name="gross_weight"/>
                            <field name="stock_in" string="Fine Issue"/>
                            <field name="stock_out" string="Fine Receipt"/>
                            <field name="balance_weight" string="Balance"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_job_work_report" model="ir.actions.act_window">
        <field name="name">Job Work Report</field>
        <field name="res_model">job.work.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No job work report records found.
            </p>
        </field>
    </record>
