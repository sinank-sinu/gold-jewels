    <!--Job Work Report Root Menu-->
    <menuitem id="menu_job_work_report_root"
          name="Job Work Reports"
          parent="menu_metal_ledger_root"
          sequence="20"/>
    <!--Job Work Report Sub Menu-->
    <menuitem id="menu_job_work_report"
          name="Job Work Report"
          parent="menu_job_work_report_root"
          action="action_job_work_report"
          sequence="10"/>

