<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Branch Detail Lines Tree View -->
    <record id="view_jewellery_branch_detail_line_tree" model="ir.ui.view">
        <field name="name">jewellery.branch.detail.line.tree</field>
        <field name="model">jewellery.branch.detail.line</field>
        <field name="arch" type="xml">
            <tree string="Branch Details" create="false" edit="false" delete="false">
                <field name="branch_id"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="transfer_type"/>
                <field name="particulars"/>
                <field name="location_id" optional="show"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="label_count" string="Labels Count"/>
                <button name="action_show_labels" type="object" string="View Labels" icon="fa-list" class="oe_highlight"/>
                <!-- Inward -->
                <field name="inward_gross_weight" sum="Total Inward Gross Wt"/>
                <field name="inward_net_weight" sum="Total Inward Net Wt"/>
                <field name="inward_stone_weight" sum="Total Inward Stone Wt"/>
                <field name="inward_diamond_weight" sum="Total Inward Diamond Wt"/>
                <!-- Outward -->
                <field name="outward_gross_weight" sum="Total Outward Gross Wt"/>
                <field name="outward_net_weight" sum="Total Outward Net Wt"/>
                <field name="outward_stone_weight" sum="Total Outward Stone Wt"/>
                <field name="outward_diamond_weight" sum="Total Outward Diamond Wt"/>
                <field name="outward_other_weight" sum="Total Outward Other Wt"/>
                <!-- Closing -->
                <field name="closing_net_weight" string="Closing Weight"/>
            </tree>
        </field>
    </record>

    <!-- Branch Detail Lines Search View -->
    <record id="view_jewellery_branch_detail_line_search" model="ir.ui.view">
        <field name="name">jewellery.branch.detail.line.search</field>
        <field name="model">jewellery.branch.detail.line</field>
        <field name="arch" type="xml">
            <search string="Search Branch Detail Line">
                <field name="branch_id"/>
                <field name="product_id"/>
                <group expand="1" string="Group By">
                    <filter string="Branch" name="group_by_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="Product Item" name="group_by_product" context="{'group_by':'product_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by':'transfer_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window Action for Branch Detail Lines -->
    <record id="action_jewellery_branch_detail_line" model="ir.actions.act_window">
        <field name="name">Branch Details</field>
        <field name="res_model">jewellery.branch.detail.line</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_jewellery_branch_detail_line_search"/>
        <field name="context">{'search_default_group_by_branch': 1, 'search_default_group_by_product': 1}</field>
        <field name="target">current</field>
    </record>

    <!-- Branch Detail Wizard Form View -->
    <record id="view_jewellery_branch_detail_wizard_form" model="ir.ui.view">
        <field name="name">jewellery.branch.detail.wizard.form</field>
        <field name="model">jewellery.branch.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Branch Details Report">
                <group>
                    <group>
                        <field name="branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_in_odoo" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action for Branch Detail Wizard -->
    <record id="action_jewellery_branch_detail_wizard" model="ir.actions.act_window">
        <field name="name">Branch Details Wizard</field>
        <field name="res_model">jewellery.branch.detail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Inventory module Reporting menu -->
    <menuitem
        id="menu_stock_branch_details_wizard"
        name="Branch Details"
        parent="stock.menu_warehouse_report"
        action="action_jewellery_branch_detail_wizard"
        sequence="170"
    />
</odoo>
