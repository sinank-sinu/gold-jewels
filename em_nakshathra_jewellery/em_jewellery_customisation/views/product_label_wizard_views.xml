<odoo>
    <record id="view_product_variant_wizard_form" model="ir.ui.view">
        <field name="name">product.variant.wizard.form</field>
        <field name="model">product.variant.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Variant">
                <group>
                    <field name="product_tmpl_id" invisible="1"/>
                    <field name="product_id" widget="radio" options="{'horizontal': false}"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <!-- <button string="Confirm" special="cancel" class="btn-primary"/> -->
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>