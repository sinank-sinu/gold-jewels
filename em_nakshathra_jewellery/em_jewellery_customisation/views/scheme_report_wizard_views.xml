<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scheme_report_wizard_form" model="ir.ui.view">
        <field name="name">scheme.report.wizard.form</field>
        <field name="model">scheme.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Combined Scheme Report">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <footer>
                    <button string="Print Combined Scheme" name="action_print_combined_report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scheme_report_wizard" model="ir.actions.act_window">
        <field name="name">Print Combined Report</field>
        <field name="res_model">scheme.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_print_combined_report_wizard"
              name="Print Combined Report"
              parent="em_jewellery_management.menu_scheme_enrollment_category"
              action="action_scheme_report_wizard"
              groups="em_jewellery_management.group_jewellery_manager"
              sequence="25"/>

</odoo>

