<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_jewellery_customisation" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.jewellery.customisation</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <field name="amount_rounding" invisible="not is_old_gold and not is_sale_return_po"/>
            </xpath>
        </field>
    </record>
</odoo>
