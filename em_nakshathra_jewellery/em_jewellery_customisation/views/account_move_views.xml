<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_scheme_redeem" model="ir.ui.view">
        <field name="name">account.move.form.inherit.scheme.redeem</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']" position="after">
                <field name="has_outstanding_scheme_payment" invisible="1"/>
                <div class="mt-2" invisible="not has_outstanding_scheme_payment">
                    <button name="action_redeem_outstanding_schemes"
                            type="object"
                            string="Redeem Scheme"
                            class="btn btn-primary"
                            confirm="Are you sure you want to redeem the outstanding scheme payment(s) against this invoice?"/>
                </div>
                <div class="mt-2" invisible="scheme_balance_to_pay_customer &lt;= 0">
                    <strong>Scheme Balance to Pay Customer: </strong>
                    <field name="scheme_balance_to_pay_customer" readonly="1" class="oe_inline mr-2"/>
                    <button name="action_pay_scheme_balance_to_customer"
                            type="object"
                            string="Pay Customer"
                            class="btn btn-secondary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='old_gold_price']" position="after">
                <field name="has_customer_payment" invisible="1"/>
                <field name="amount_rounding" string="Edit Round Off"
                       invisible="move_type == 'out_invoice' or (state != 'draft' or move_type not in ('out_refund', 'in_invoice', 'in_refund'))"
                       readonly="state == 'posted' and is_paid"/>
            </xpath>
        </field>
    </record>
</odoo>
