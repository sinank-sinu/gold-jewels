<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_short_code" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.short.code</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']//field[@name='code']" position="before">
                <field name="entries_count" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='bank_account']//field[@name='code']" position="attributes">
                <attribute name="readonly">entries_count &gt; 0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
