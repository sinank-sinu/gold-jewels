<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_inherit_em" model="ir.ui.view">
        <field name="name">product.template.form.inherit.em</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']/tree/field[@name='value_ids']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'color_field': 'color'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
