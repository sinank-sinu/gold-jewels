<odoo>
    <record id="view_product_label_form_custom" model="ir.ui.view">
        <field name="name">product.label.view.form.custom</field>
        <field name="model">product.label</field>
        <field name="inherit_id" ref="em_jewellery_management.view_product_label_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="widget">sol_product_many2one</attribute>
                <attribute name="readonly">is_stocked_in</attribute>
            </xpath>
            <!-- <field name="product_id" widget="sol_product_many2one"/> -->
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="product_template_id" readonly="is_stocked_in"/>
                <field name="product_uom" invisible="1"/>
                <field name="order_line" invisible="1"/>
                <field name="product_template_attribute_value_ids" invisible="1"/>
                <field name="product_no_variant_attribute_value_ids" invisible="1"/>
                <field name="product_custom_attribute_value_ids" invisible="1"/>
                <field name="product_uom_qty" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="pricelist_id" invisible="1"/>
                <field name="date_order" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="order_id" invisible="1"/>
                <field name="is_configurable_product" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='purchase_id']" position="attributes">
                <attribute name="domain">[('state', '=', 'purchase'), ('order_line.product_template_id', '=', product_template_id)]</attribute>
            </xpath>
            <xpath expr="//field[@name='purchase_id']" position="after">
                <field name="partner_id" string="Vendor" readonly="purchase_id != False" force_save="1" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='branch_location_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='source_location_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
