<odoo>
    <record id="view_product_label_form_custom" model="ir.ui.view">
        <field name="name">product.label.view.form.custom</field>
        <field name="model">product.label</field>
        <field name="inherit_id" ref="em_jewellery_management.view_product_label_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_tmpl_id" widget="product_template_variant_selector"/>
            </xpath>
            <xpath expr="//field[@name='branch_location_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='source_location_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
