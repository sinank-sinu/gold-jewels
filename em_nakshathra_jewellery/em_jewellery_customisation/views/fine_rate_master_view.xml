<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_fine_rate_master_form" model="ir.ui.view">
        <field name="name">fine.rate.master.form</field>
        <field name="model">fine.rate.master</field>
        <field name="arch" type="xml">
            <form string="Fine Rate">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_1pm_update"
                            type="object"
                            string="1PM Update"
                            class="btn-primary"/>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="fine_rate"/>
                    </group>
                    <notebook>
                        <page string="Fine Rate">
                            <group>
                                <field name="date"/>
                                <field name="fine_rate"/>
                            </group>
                        </page>
                        <page string="1PM Update History">
                            <field name="history_ids" readonly="1">
                                <tree create="0" delete="0">
                                    <field name="update_datetime"/>
                                    <field name="fine_rate"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fine_rate_master_tree" model="ir.ui.view">
        <field name="name">fine.rate.master.tree</field>
        <field name="model">fine.rate.master</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="fine_rate"/>
            </tree>
        </field>
    </record>

</odoo>