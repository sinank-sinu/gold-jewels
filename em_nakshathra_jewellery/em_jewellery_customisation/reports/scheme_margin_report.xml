<odoo>
    <record id="scheme_margin_xlsx_action" model="ir.actions.report">
        <field name="name">Scheme Report</field>
        <field name="model">jewellery.scheme.enrollment</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">em_jewellery_customisation.scheme_redeem_margin_xlsx</field>
        <field name="report_file">scheme_report</field>
    </record>

    <!-- For Combined Redeem Margin Report -->
    <record id="action_report_scheme_redeem_margin" model="ir.actions.report">
        <field name="name">Combined Scheme Report</field>
        <field name="model">jewellery.scheme.enrollment</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">em_jewellery_customisation.scheme_redeem_margin_xlsx</field>
        <field name="report_file">Scheme Redeem Margin Report</field>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>