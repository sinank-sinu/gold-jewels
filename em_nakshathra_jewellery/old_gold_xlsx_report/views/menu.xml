<odoo>

    <!-- Reporting Menu -->
    <menuitem
        id="menu_jewellery_reporting_root"
        name="Reporting"
        parent="em_jewellery_management.menu_jewellery_root"
        groups="em_jewellery_management.group_jewellery_manager,em_jewellery_management.group_jewellery_old_gold"
        sequence="21"
    />

    <!-- Old Gold Margin Wizard Action -->
    <record id="action_old_gold_margin_wizard" model="ir.actions.act_window">
        <field name="name">Old Gold Margin Report</field>
        <field name="res_model">old.gold.margin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Old Gold Refine Margin Wizard Action -->
    <record id="action_old_gold_refine_margin_wizard" model="ir.actions.act_window">
        <field name="name">Old Gold Refine Margin Report</field>
        <field name="res_model">old.gold.refine.margin.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Old Gold Purchase vs Market Fine Wizard Action -->
    <record id="action_old_gold_market_fine_wizard" model="ir.actions.act_window">
        <field name="name">Old Gold Purchase vs Market Fine Report</field>
        <field name="res_model">old.gold.market.fine.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Submenus -->
    <menuitem
        id="menu_old_gold_refine_margin_report"
        name="Old Gold Refine Margin Report"
        parent="menu_jewellery_reporting_root"
        action="action_old_gold_refine_margin_wizard"
        sequence="24"
    />
    <menuitem
        id="menu_old_gold_market_fine_report_jewellery"
        name="Old Gold Purchase vs Market Fine Report"
        parent="menu_jewellery_reporting_root"
        action="action_old_gold_market_fine_wizard"
        sequence="25"
    />
    <menuitem
        id="menu_old_gold_margin_report"
        name="Old Gold Margin Report"
        parent="purchase.purchase_report_main"
        action="action_old_gold_margin_wizard"
        sequence="40"
    />
    <menuitem
        id="menu_old_gold_market_fine_report_purchase"
        name="Old Gold Purchase vs Market Fine Report"
        parent="purchase.purchase_report_main"
        action="action_old_gold_market_fine_wizard"
        sequence="41"
    />

</odoo>