<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Scheme API Control Record -->
        <record id="record_scheme_api_control" model="scheme.api.control">
            <field name="name">Gold Scheme API Control</field>
            <field name="is_enabled">True</field>
            <field name="disabled_message">Gold Scheme API is currently disabled for maintenance. Please try again later.</field>
        </record>

        <!-- Default Scheme API System Parameters -->
        <function model="ir.config_parameter" name="set_param">
            <value>scheme_api.is_enabled</value>
            <value>True</value>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value>scheme_api.disabled_message</value>
            <value>Gold Scheme API is currently disabled for maintenance. Please try again later.</value>
        </function>

        <!-- Default Task Manager API System Parameters -->
        <function model="ir.config_parameter" name="set_param">
            <value>task_manager_api.is_enabled</value>
            <value>True</value>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value>task_manager_api.disabled_message</value>
            <value>Task Manager API is currently disabled for maintenance. Please try again later.</value>
        </function>

        <!-- Default HRMS API System Parameters -->
        <function model="ir.config_parameter" name="set_param">
            <value>hrms_api.is_enabled</value>
            <value>True</value>
        </function>

        <function model="ir.config_parameter" name="set_param">
            <value>hrms_api.disabled_message</value>
            <value>HRMS API is currently disabled for maintenance. Please try again later.</value>
        </function>
    </data>
</odoo>
