<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="expense_report_pivot_view" model="ir.ui.view">
        <field name="name">expense.report.pivot.view</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <pivot string="Expense Report" sample="1">
                <field name="branch_id" type="row"/>
                <field name="account_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="debit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_expense_report_pivot" model="ir.actions.act_window">
        <field name="name">Expense Report View</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,tree</field>
        <field name="domain">[('account_id.account_type', '=', 'expense'), ('account_id.name', 'not ilike', 'Stock input'), ('move_id.state', '=', 'posted')]</field>
    </record>

    <record id="action_expense_report_pivot_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="expense_report_pivot_view"/>
        <field name="act_window_id" ref="action_expense_report_pivot"/>
    </record>

    <menuitem
        id="menu_expense_report_pivot"
        name="Expense Report View"
        parent="purchase.purchase_report_main"
        action="action_expense_report_pivot"
        sequence="60"
    />
</odoo>
