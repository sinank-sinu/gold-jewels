<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Scheduler of Email for Vehicle Service -->
        <record id="fleet_mail_service" model="ir.cron">
                <field name="name">Jewelry DMS: Check Document Expirations</field>
                <field name="active" eval="True" />
                <field name="state">code</field>
                <field name="code">model.check_document_expiry_cron()</field>
                <field name="interval_number">1</field>
                <field name="interval_type">days</field>
                <field name="numbercall">-1</field>
                <field name="doall" eval="False" />
                <field name="model_id" ref="model_document_document"/>
        </record>
    </data>
</odoo>