<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_document_category_kanban" model="ir.ui.view">
        <field name="name">document.category.kanban</field>
        <field name="model">document.category</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard" create="true">
                <field name="name"/>
                <field name="document_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click" type="object" name="action_view_documents" 
                             style="border-top: 4px solid #714B67; border-radius: 4px; padding: 15px; min-height: 110px;">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary" style="font-size: 18px; font-weight: bold; color: #212529;">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <hr style="margin-top: 10px; margin-bottom: 10px; border-top: 1px solid #dee2e6;"/>
                            <div class="o_kanban_record_bottom" style="margin-top: auto;">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill bg-primary" style="font-size: 13px; padding: 5px 10px;">
                                        <t t-esc="record.document_count.raw_value"/> Documents
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button class="btn btn-sm btn-outline-secondary" type="object" name="action_view_documents">
                                        Open View
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_document_category_dashboard" model="ir.actions.act_window">
        <field name="name">Documents Dashboard</field>
        <field name="res_model">document.category</field>
        <field name="view_mode">kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Document Category!
            </p><p>
                Group records like Tenancy, Insurance, and ID Cards here to cleanly isolate high volumes of data.
            </p>
        </field>
    </record>

