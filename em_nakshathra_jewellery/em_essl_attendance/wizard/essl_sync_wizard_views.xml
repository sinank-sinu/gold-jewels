<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_essl_sync_wizard_form" model="ir.ui.view">
        <field name="name">essl.sync.wizard.form</field>
        <field name="model">essl.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync eSSL Attendance">
                <group>
                    <group>
                        <field name="from_date"/>
                    </group>
                    <group>
                        <field name="to_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_sync" string="Sync Attendance" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_essl_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync eSSL Attendance</field>
        <field name="res_model">essl.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_essl_sync_wizard"
              name="Sync eSSL Attendance"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="8"
              action="action_essl_sync_wizard"
              groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
