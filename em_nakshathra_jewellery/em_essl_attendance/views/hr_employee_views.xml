<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_essl" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.essl</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='hr_settings']/group/group[@name='active_group']" position="inside">
                <field name="essl_emp_code"/>
                <field name="essl_location_id"/>
            </xpath>
        </field>
    </record>
</odoo>
