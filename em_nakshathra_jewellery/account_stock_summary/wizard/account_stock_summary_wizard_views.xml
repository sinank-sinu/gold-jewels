<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="view_account_stock_summary_wizard_form" model="ir.ui.view">
        <field name="name">account.stock.summary.wizard.form</field>
        <field name="model">account.stock.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Account Stock Summary">

                <group>
                    <group>
                        <field name="date_from" required="1"/>
                        <field name="date_to" required="1"/>
                    </group>

                    <group>
                        <field name="branch_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </group>

                <footer>
                    <button
                        name="action_generate_report"
                        string="Generate Excel"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_account_stock_summary_wizard" model="ir.actions.act_window">
    <field name="name">Account Stock Summary</field>
    <field name="res_model">account.stock.summary.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_account_stock_summary_wizard_form"/>
    <field name="target">new</field>
</record>

</odoo>