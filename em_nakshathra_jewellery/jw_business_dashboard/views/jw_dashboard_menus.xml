<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action -->
        <record id="jw_business_dashboard_action" model="ir.actions.client">
            <field name="name">JW Business Dashboard</field>
            <field name="tag">jw_business_dashboard</field>
            <field name="target">current</field>
        </record>

        <!-- Top-Level App Menu -->
        <menuitem
            id="jw_dashboard_root_menu"
            name="JW Dashboard"
            web_icon="jw_business_dashboard,static/description/icon.png"
            sequence="3"
        />

        <!-- Main Dashboard Sub-menu -->
        <menuitem
            id="jw_dashboard_main_menu"
            name="Business Dashboard"
            parent="jw_dashboard_root_menu"
            action="jw_business_dashboard_action"
            sequence="1"
        />
    </data>
</odoo>
