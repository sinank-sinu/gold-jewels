<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add 'Pay via Pine Labs' button to Sales Order form view -->
    <record id="view_sale_order_pinelabs" model="ir.ui.view">
        <field name="name">sale.order.pinelabs</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-credit-card"
                        name="action_pay_via_pinelabs" type="object"
                        invisible="state not in ('sale', 'done')">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="pinelabs_transaction_ids" widget="statinfo"/>
                        </span>
                        <span class="o_stat_text">Pine Labs</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
