<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add 'Pay via Pine Labs' button to Account Payment form view -->
    <record id="view_account_payment_form_pinelabs" model="ir.ui.view">
        <field name="name">account.payment.form.pinelabs</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
           <xpath expr="//header" position="inside">
                <button name="action_pay_via_pinelabs"
                        string="Pay via Pine Labs"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft' or payment_type not in ('inbound', 'outbound') or pinelabs_transaction_id != False"/>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_suspense_payment" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//group[@name='main_group']" position="inside">
                <group name="pinelabs_details" string="Pine Labs"
                       invisible="not pinelabs_transaction_id">
                    <field name="pinelabs_transaction_id" readonly="1"/>
                    <field name="pinelabs_txn_ref"/>
                    <field name="pinelabs_approval_code"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
