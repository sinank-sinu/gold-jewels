<odoo>
    <record id="view_partner_form_inherit_custom" model="ir.ui.view">
        <field name="name">res.partner.form.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Add fields inside Sales & Purchase or create new group -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="additional_details" string="Additional Info">
                    <group string="Additional Info">
                    <field name="dob"/>
                        <field name="age" readonly="1"/>
                        <field name="ring_size"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//sheet/group/group[2]" position="inside">
                <field name="ring_size"/>
            </xpath>
        </field>
    </record>
</odoo>