<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scheme_collection_xlsx_wizard_form" model="ir.ui.view">
        <field name="name">scheme.collection.report.wizard.form</field>
        <field name="model">scheme.collection.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Scheme Collection Report Wizard">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="branch_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_xlsx" string="Download XLSX" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scheme_collection_xlsx_wizard" model="ir.actions.act_window">
        <field name="name">Scheme Collection Report</field>
        <field name="res_model">scheme.collection.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_scheme_collection_xlsx_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_scheme_collection_xlsx_report"
              name="Scheme Collection Report"
              parent="em_jewellery_management.menu_scheme_enrollment_category"
              action="action_scheme_collection_xlsx_wizard"
              sequence="25"/>
</odoo>
