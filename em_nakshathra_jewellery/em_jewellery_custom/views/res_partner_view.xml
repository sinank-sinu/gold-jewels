<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_job_worker_view_custom" model="ir.ui.view">
        <field name="name">res.partner.job.worker</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='website']" position="after">
               <field name="wedding_anniversary"/>
               <label for="instagram_id"/>
               <div class="o_row">
                   <span class="fa fa-instagram" title="Instagram"/>
                   <field name="instagram_id" placeholder="Instagram ID"/>
               </div>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form//field[@name='email']" position="after">
                <field name="parent_id" invisible="1"/>
                <field name="wedding_anniversary"/>
                <field name="birthday"/>
                <field name="instagram_id"/>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="string">WhatsApp Number</attribute>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="after">
                <span class="fa fa-whatsapp" title="WhatsApp" style="color: #25D366; font-size: 1.2em; margin-left: 5px;"/>
            </xpath>
        </field>
    </record>
</odoo>