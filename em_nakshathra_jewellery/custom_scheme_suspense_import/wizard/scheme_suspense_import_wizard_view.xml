<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_scheme_suspense_import_wizard_form" model="ir.ui.view">
        <field name="name">scheme.suspense.import.wizard.form</field>
        <field name="model">scheme.suspense.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Customer Payments">
                <field name="result_message" invisible="1"/>
                
                <div class="alert alert-info" role="alert" invisible="result_message">
                    Upload an Excel file (.xlsx) containing Customer Payments/Suspense details.
                    We will parse and validate the file, checking for duplicates. 
                    A <strong>Dry Run</strong> is checked by default to let you review the logs before saving.
                </div>
                
                <group invisible="result_message">
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group>
                        <field name="dry_run"/>
                    </group>
                </group>
                
                <group invisible="not result_message" string="Import Summary">
                    <field name="result_message" readonly="1" nolabel="1" class="text-monospace"/>
                </group>
                
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" invisible="result_message"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" invisible="result_message"/>
                    <button string="Close" class="btn-secondary" special="cancel" invisible="not result_message"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_scheme_suspense_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Customer Payments</field>
        <field name="res_model">scheme.suspense.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
