<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_label_import_wizard_form" model="ir.ui.view">
        <field name="name">product.label.import.wizard.form</field>
        <field name="model">product.label.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Label Import">
                <sheet>
                    <field name="state" invisible="1"/>
                    <field name="progress" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        Maximum <strong>1,000 labels</strong> can be imported per upload.
                    </div>
                    <group>
                        <group>
                            <field name="file" filename="filename" required="1" readonly="state == 'running'"/>
                            <field name="filename" invisible="1"/>
                        </group>
                        <group invisible="state == 'draft'">
                            <field name="total_rows"/>
                            <field name="processed_rows"/>
                            <field name="imported_count"/>
                            <field name="failed_count"/>
                        </group>
                    </group>
                    <div invisible="state == 'draft'" class="my-2">
                        <widget name="label_import_progress"/>
                        <div class="text-muted mt-1">
                            <field name="result_message" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    <notebook invisible="not failed_line_ids">
                        <page string="Unimported Labels" name="unimported_labels">
                            <div class="mb-2 d-flex justify-content-end">
                                <button name="action_export_failed_excel"
                                        string="Export Unimported Labels (Excel)"
                                        type="object"
                                        class="btn-success"
                                        icon="fa-file-excel-o"/>
                            </div>
                            <field name="failed_line_ids" readonly="1" nolabel="1">
                                <tree create="false" edit="false" delete="false" decoration-danger="1">
                                    <field name="row_number"/>
                                    <field name="label_name"/>
                                    <field name="reason"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_export_failed_excel"
                            string="Export Unimported Excel"
                            type="object"
                            class="btn-success"
                            icon="fa-download"
                            invisible="not failed_line_ids"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" invisible="state != 'draft'"/>
                    <button string="Close" class="btn-secondary" special="cancel" invisible="state == 'draft'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_label_import_wizard" model="ir.actions.act_window">
        <field name="name">Product Label Import</field>
        <field name="res_model">product.label.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('stock.group_stock_manager')), (4, ref('base.group_system'))]"/>
    </record>

    <menuitem
        id="menu_product_label_import_wizard"
        name="Product Label Import"
        parent="stock.menu_stock_warehouse_mgmt"
        action="action_product_label_import_wizard"
        groups="base.group_system"
        sequence="190"/>
</odoo>
