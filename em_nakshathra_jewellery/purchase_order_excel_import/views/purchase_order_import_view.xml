<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =======================================================
         Purchase Order Import Wizard
    ======================================================== -->

    <record id="view_purchase_order_import_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.import.wizard.form</field>
        <field name="model">purchase.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Purchase Orders">
                <sheet>

                    <group>

                        <field
                                name="file"
                                filename="file_name"
                                required="1"/>

                        <field
                                name="file_name"
                                invisible="1"/>

                    </group>

                    <group>
                        <div class="o_form_label">
                            Upload an Excel file (.xlsx) having the Purchase Order format.
                        </div>
                    </group>

                </sheet>

                <footer>

                    <button
                            name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"/>

                    <button
                            string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>

                </footer>

            </form>
        </field>
    </record>


    <!-- =======================================================
         Window Action
    ======================================================== -->

    <record id="action_purchase_order_excel_import" model="ir.actions.act_window">
        <field name="name">Import Purchase Orders</field>
        <field name="res_model">purchase.order.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_purchase_order_excel_import"
            name="Import Purchase Orders"
            parent="purchase.menu_purchase_config"
            action="action_purchase_order_excel_import"
            sequence="100"/>

</odoo>