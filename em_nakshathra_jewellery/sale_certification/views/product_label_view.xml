<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_label_form_inherit" model="ir.ui.view">
        <field name="name">product.label.form.inherit</field>
        <field name="model">product.label</field>
        <field name="inherit_id" ref="em_jewellery_management.view_product_label_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_fine_weight']" position="after">
                <field name="other_weight_g"/>
                <field name="other_weight_amount"/>
            </xpath>
        </field>
    </record>
</odoo>
