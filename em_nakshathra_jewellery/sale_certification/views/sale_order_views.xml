<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_order_certification_view" model="ir.ui.view">
        <field name="name">sale.order.certification.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='other_information']" position="inside">
                <group string="Certification">
                    <group>
                        <field name="certification_image"
                               widget="binary"
                               filename="certification_image_name"
                               string="Upload your file"/>
                        <field name="certification_image_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="diamond_certification" placeholder="Enter diamond certification details..."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>