<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Inherit the form add view to add the bank_reference field -->
    <record id="view_bank_statement_line_form_add_inherit_bank_ref" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.add.inherit.bank_ref</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_reconcile_oca.bank_statement_line_form_add_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ref']" position="before">
                <field name="bank_reference" />
            </xpath>
        </field>
    </record>

    <!-- Inherit the reconcile form view to add the bank_reference field -->
    <record id="view_bank_statement_line_form_reconcile_inherit_bank_ref" model="ir.ui.view">
        <field name="name">account.bank.statement.line.form.reconcile.inherit.bank_ref</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_reconcile_oca.bank_statement_line_form_reconcile_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='narration']//field[@name='payment_ref']" position="before">
                <field name="bank_reference" />
            </xpath>
        </field>
    </record>

    <!-- Inherit the tree view to add the bank_reference field -->
    <record id="view_bank_statement_line_tree_inherit_bank_ref" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree.inherit.bank_ref</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_statement_base.account_bank_statement_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_ref']" position="before">
                <field name="bank_reference" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Inherit the reconcile match widget tree view to add bank_reference -->
    <record id="view_account_move_line_tree_reconcile_inherit_bank_ref" model="ir.ui.view">
        <field name="name">account.move.line.tree.reconcile.inherit.bank_ref</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_reconcile_oca.account_move_line_tree_reconcile_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="bank_reference" optional="show" />
            </xpath>
        </field>
    </record>

</odoo>
