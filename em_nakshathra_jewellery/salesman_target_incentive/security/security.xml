<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Branch User Rule: Users can only see targets in their assigned branches -->
        <record id="salesman_target_branch_rule" model="ir.rule">
            <field name="name">Salesman Target: Branch User</field>
            <field name="model_id" ref="model_salesman_target"/>
            <field name="domain_force">[('branch_id', 'in', user.branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Admin Override Rule: ERP Managers can see all targets -->
        <record id="salesman_target_admin_rule" model="ir.rule">
            <field name="name">Salesman Target: Admin All</field>
            <field name="model_id" ref="model_salesman_target"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>
    </data>
</odoo>
