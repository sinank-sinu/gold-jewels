<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_transfer_manufacture" model="ir.ui.view">
        <field name="name">res.company.form.inherit.transfer.manufacture</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="transfer_manufacture_location_ids"
                       widget="many2many_tags"
                       string="Transfer Manufacture Location"
                       domain="id and [('usage', '=', 'internal'), ('company_id', '=', id)] or [('usage', '=', 'internal')]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
