<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sms_template_view_form_inherit_xpress" model="ir.ui.view">
        <field name="name">sms.template.view.form.inherit.xpress</field>
        <field name="model">sms.template</field>
        <field name="inherit_id" ref="sms.sms_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="xpresssms_template_id"/>
            </xpath>
        </field>
    </record>

    <record id="sms_template_view_tree_inherit_xpress" model="ir.ui.view">
        <field name="name">sms.template.view.tree.inherit.xpress</field>
        <field name="model">sms.template</field>
        <field name="inherit_id" ref="sms.sms_template_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="xpresssms_template_id"/>
            </xpath>
        </field>
    </record>
</odoo>
