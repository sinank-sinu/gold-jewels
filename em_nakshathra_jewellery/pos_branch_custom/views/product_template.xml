<odoo>
    <record id="product_template_search_inherit_branch" model="ir.ui.view">
        <field name="name">product.template.search.branch</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <!-- Add inside search -->
            <xpath expr="//filter[@name='filter_to_availabe_pos']" position="after">
                <!-- Branch filter -->
                <filter string="Branch" name="branch_id"/>
            </xpath>
        </field>
    </record>


</odoo>