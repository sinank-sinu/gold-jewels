<odoo>

    <record id="view_sale_register_wizard"
            model="ir.ui.view">
        <field name="name">sale.register.wizard.form</field>
        <field name="model">sale.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale Register Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="branch_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_download_report"
                            string="Download"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_register_wizard" model="ir.actions.act_window">
        <field name="name">Sale Register Report</field>
        <field name="res_model">sale.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_sale_register_report"
        name="Sale Register Report"
        parent="sale.menu_sale_report"
        action="action_sale_register_wizard"
        sequence="60"/>

</odoo>
