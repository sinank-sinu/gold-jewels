<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_transfer_custom" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.transfer.custom</field>
        <field name="model">sale.order</field>
        <!-- We can inherit from the base sale.order view -->
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Transfer Remaining">
                    <group>
                        <group>
                            <field name="is_transfer_remaining" widget="boolean_toggle"/>
                            <field name="available_transfer_label_ids" invisible="1"/>
                            <field name="transfer_label_id" invisible="not is_transfer_remaining" options="{'no_create': True, 'no_open': True}" domain="[('id', 'in', available_transfer_label_ids)]"/>
                        </group>
                        <group>
                            <field name="cutpiece_location_dest_id" invisible="not is_transfer_remaining" required="is_transfer_remaining" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                            <field name="dest_location_weight" invisible="not is_transfer_remaining"/>
                            <field name="transfer_weight" invisible="not is_transfer_remaining"/>
                            <field name="is_transferred" invisible="1"/>
                        </group>
                    </group>
                    <div class="oe_right" invisible="not is_transfer_remaining or is_transferred">
                        <button name="action_transfer_remaining_stock"
                                type="object"
                                string="Transfer Remaining"
                                class="btn-primary"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
