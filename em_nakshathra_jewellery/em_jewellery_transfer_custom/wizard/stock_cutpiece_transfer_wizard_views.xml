<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cutpiece Stock Transfer Wizard Form View -->
    <record id="view_stock_cutpiece_transfer_wizard_form" model="ir.ui.view">
        <field name="name">stock.cutpiece.transfer.wizard.form</field>
        <field name="model">stock.cutpiece.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Cutpiece Stock Transfer">
                <sheet>
                    <div class="alert alert-info py-2" role="alert">
                        <i class="fa fa-info-circle me-1"/>
                        Transfer cutpiece scrap stock to another location (e.g. Branch Main Stock, Melting, HO, or Refinery).
                    </div>
                    <group>
                        <group string="Source Details">
                            <field name="location_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                            <field name="branch_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="purity_summary" readonly="1" string="Purity"/>
                        </group>
                        <group string="Transfer Destination">
                            <field name="location_dest_id" 
                                   required="1" 
                                   options="{'no_create': True}" 
                                   placeholder="Select destination location..."/>
                            <field name="dest_branch_id" readonly="1" options="{'no_open': True}"/>
                            <field name="picking_type_id" 
                                   required="1" 
                                   options="{'no_create': True}"/>
                            <field name="transfer_date" required="1"/>
                            <field name="notes" placeholder="e.g. Cutpiece Stock Transfer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items to Transfer">
                            <field name="line_ids">
                                <tree editable="bottom" create="false" delete="true">
                                    <field name="quant_id" invisible="1"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="purity_id" readonly="1" force_save="1"/>
                                    <field name="available_qty" readonly="1" force_save="1" string="On Hand Qty (g)"/>
                                    <field name="quantity" string="Transfer Qty (g)" class="fw-bold text-primary"/>
                                    <field name="product_uom_id" readonly="1" force_save="1" string="UoM"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_quantity" readonly="1" class="fw-bold text-success" string="Total Transfer Weight (g)"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_transfer" 
                            string="Transfer" 
                            type="object" 
                            class="btn-primary" 
                            icon="fa-exchange"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server Action: Transfer under Actions Menu in Stock Quant List View -->
    <record id="action_stock_quant_cutpiece_transfer" model="ir.actions.server">
        <field name="name">Transfer</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="binding_model_id" ref="stock.model_stock_quant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_cutpiece_transfer_wizard()
        </field>
    </record>
</odoo>

