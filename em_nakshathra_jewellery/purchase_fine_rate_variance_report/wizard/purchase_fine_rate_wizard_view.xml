<odoo>

    <record id="view_purchase_fine_rate_wizard"
            model="ir.ui.view">
        <field name="name">purchase.fine.rate.wizard.form</field>
        <field name="model">purchase.fine.rate.wizard</field>
        <field name="arch" type="xml">
            <form string="Purchase Fine Rate Variance">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            string="Print Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_purchase_fine_rate_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Fine Rate Variance Report</field>
        <field name="res_model">purchase.fine.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem
        id="menu_purchase_fine_rate_variance"
        name="Purchase Fine Rate Variance"
        parent="purchase.purchase_report_main"
        action="action_purchase_fine_rate_wizard"
        sequence="50"/>

</odoo>