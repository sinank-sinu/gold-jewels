<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="product_label_bulk_import.LabelBulkImportWizard">
  <div class="po-bulk-import">

    <!-- ── Step indicator ── -->
    <div class="po-import-steps">
      <t t-foreach="steps" t-as="s" t-key="s.key">
        <div t-attf-class="po-import-step #{state.step === s.key ? 'active' : (stepIndex(s.key) &lt; stepIndex(state.step) ? 'done' : '')}">
          <div class="po-import-step-num">
            <t t-if="stepIndex(s.key) &lt; stepIndex(state.step)">✓</t>
            <t t-else=""><t t-esc="s_index + 1"/></t>
          </div>
          <span><t t-esc="s.label"/></span>
        </div>
        <t t-if="!s_last">
          <div t-attf-class="po-import-step-sep #{stepIndex(s.key) &lt; stepIndex(state.step) ? 'done' : ''}"/>
        </t>
      </t>
    </div>

    <!-- ── Error banner ── -->
    <div t-if="state.globalError" class="po-alert po-alert-error">
      <strong>Error:</strong> <t t-esc="state.globalError"/>
    </div>

    <!-- ═══════════ STEP 1: Upload ═══════════ -->
    <t t-if="state.step === 'upload'">
      <div class="po-import-card">
        <h2>Step 1 – Upload File</h2>

        <div class="po-upload-zone" t-on-click="triggerFileInput"
             t-on-dragover.prevent="onDragOver" t-on-dragleave="onDragLeave"
             t-on-drop.prevent="onDrop" t-ref="dropzone">
          <div class="upload-icon">📂</div>
          <div>Drag &amp; drop a <strong>CSV</strong> or <strong>XLSX</strong> file here, or <u>click to browse</u></div>
          <input type="file" accept=".csv,.xlsx,.xls" t-ref="fileInput" t-on-change="onFileChange"/>
          <div t-if="state.fileName" class="file-name">✓ <t t-esc="state.fileName"/></div>
        </div>

        <div class="mb-3">
          <a href="/product_label/import/download_template" class="dl-template" target="_blank"
             style="font-size:13px;text-decoration:none;">⬇ Download Import Template (Product Label)</a>
        </div>

        <!-- Sheet selector -->
        <t t-if="state.sheetNames.length > 1">
          <div class="alert alert-info py-2 mt-2">
            <strong>Multiple sheets detected.</strong> Select which sheet to import:
            <select class="form-select form-select-sm mt-1"
                    t-on-change="(e) => state.selectedSheet = e.target.value">
              <t t-foreach="state.sheetNames" t-as="sn" t-key="sn">
                <option t-att-value="sn" t-att-selected="state.selectedSheet === sn"><t t-esc="sn"/></option>
              </t>
            </select>
          </div>
        </t>

        <div class="row g-3">
          <!-- Unique field -->
          <div class="col-md-6">
            <label class="form-label fw-semibold">Unique Key Field</label>
            <t t-if="state.loadingFields">
              <div class="form-control text-muted" style="background:#f8f9fa">
                <span class="po-spinner"/>Loading fields…
              </div>
            </t>
            <t t-else="">
              <select class="form-select" t-on-change="(e) => state.uniqueField = e.target.value">
                <t t-foreach="state.modelFields" t-as="f" t-key="f.name">
                  <option t-att-value="f.name" t-att-selected="state.uniqueField === f.name">
                    <t t-esc="f.label"/> (<t t-esc="f.name"/>)<t t-if="f.required"> *</t>
                  </option>
                </t>
              </select>
            </t>
            <small class="text-muted">Field used to detect existing labels (create vs update). Default: name</small>
          </div>

          <!-- Batch size -->
          <div class="col-md-6">
            <label class="form-label fw-semibold">Batch Size</label>
            <input type="number" class="form-control" min="100" max="100000"
                   t-att-value="state.batchSize"
                   t-on-change="(e) => state.batchSize = (~~e.target.value) || 10000"/>
            <small class="text-muted">Rows per batch (default 10 000)</small>
          </div>
        </div>

        <!-- Toggles -->
        <div class="lines-config-box mt-3">
          <div class="lines-toggle-row">
            <label class="form-check-label">
              <input type="checkbox" class="form-check-input me-2"
                     t-att-checked="state.autoCreateM2o"
                     t-on-change="(e) => state.autoCreateM2o = e.target.checked"/>
              Auto-Create Missing Records &#160;<small class="text-muted">(create product / purity / branch if not found)</small>
            </label>
          </div>
          <div class="lines-toggle-row mt-2">
            <label class="form-check-label">
              <input type="checkbox" class="form-check-input me-2"
                     t-att-checked="state.autoTransfer"
                     t-on-change="(e) => state.autoTransfer = e.target.checked"/>
              Auto-Transfer (Stock-In) &#160;<small class="text-muted">(run the internal transfer for each label right after import)</small>
            </label>
          </div>
        </div>
      </div>
      <div class="po-import-footer">
        <button class="btn btn-primary" t-on-click="goToMapping"
                t-att-disabled="!state.fileName || !state.uniqueField || state.loading">
          <span t-if="state.loading" class="po-spinner"/>
          Preview Headers →
        </button>
      </div>
    </t>

    <!-- ═══════════ STEP 2: Field Mapping ═══════════ -->
    <t t-if="state.step === 'mapping'">
      <div class="po-import-card">
        <h2>Step 2 – Map Columns to Product Label Fields</h2>
        <div class="mapping-model-badge">
          Model: <strong>Product Label</strong>
          <span class="mapping-model-tech">(product.label)</span>
          — <t t-esc="state.modelFields.length"/> fields available
        </div>
        <div class="d-flex align-items-center justify-content-between mb-2">
          <p class="text-muted small mb-0">
            For each column choose the corresponding Odoo field. Leave as <em>— Skip —</em> to ignore.
            Fields marked <strong>*</strong> are required by Odoo.
          </p>
          <button class="btn btn-sm btn-outline-secondary ms-3" t-on-click="reAutoMap"
                  title="Re-run auto-detection for all unmapped columns">⟳ Auto-Map</button>
        </div>
        <div class="mapping-table-wrapper">
          <table class="mapping-table">
            <thead>
              <tr>
                <th style="width:42%">Excel Column</th>
                <th style="width:4%" class="col-arrow"/>
                <th>Product Label Field</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="state.headers" t-as="col" t-key="col_index">
                <tr t-attf-class="#{state.mapping[col] ? 'mapped-row' : ''}">
                  <td><strong><t t-esc="col"/></strong></td>
                  <td class="col-arrow">
                    <t t-if="state.mapping[col]">✓</t>
                    <t t-else="">→</t>
                  </td>
                  <td>
                    <select t-on-change="(e) => this.setMapping(col, e.target.value)"
                            t-attf-class="field-select #{state.mapping[col] ? 'is-mapped' : ''}">
                      <option value="">— Skip —</option>
                      <t t-foreach="state.modelFields" t-as="f" t-key="f.name">
                        <option t-att-value="f.name" t-att-selected="state.mapping[col] === f.name">
                          <t t-esc="f.label"/>&#160;(<t t-esc="f.name"/>)<t t-if="f.required">&#160;*</t>
                        </option>
                      </t>
                    </select>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>
      </div>
      <div class="po-import-footer">
        <button class="btn btn-secondary" t-on-click="() => state.step = 'upload'">← Back</button>
        <button class="btn btn-primary" t-on-click="goToPreview" t-att-disabled="state.loading">
          <span t-if="state.loading" class="po-spinner"/>
          Preview Data →
        </button>
      </div>
    </t>

    <!-- ═══════════ STEP 3: Preview ═══════════ -->
    <t t-if="state.step === 'preview'">
      <div class="po-import-card">
        <h2>Step 3 – Preview (First 20 Rows)</h2>
        <t t-if="state.previewRows.length">
          <div class="preview-wrapper">
            <table class="preview-table">
              <thead>
                <tr>
                  <t t-foreach="previewColumns()" t-as="col" t-key="col_index">
                    <th><t t-esc="col"/></th>
                  </t>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="state.previewRows" t-as="row" t-key="row_index">
                  <tr>
                    <t t-foreach="previewColumns()" t-as="col" t-key="col_index">
                      <td><t t-esc="row[col] != null ? ('' + row[col]) : ''"/></td>
                    </t>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </t>
        <t t-else="">
          <div class="po-alert po-alert-info">No data rows found in file.</div>
        </t>
      </div>
      <div class="po-import-footer">
        <button class="btn btn-secondary" t-on-click="() => state.step = 'mapping'">← Back</button>
        <button class="btn btn-success" t-on-click="startImport" t-att-disabled="state.loading">
          <span t-if="state.loading" class="po-spinner"/>
          Start Import
        </button>
      </div>
    </t>

    <!-- ═══════════ STEP 4: Importing ═══════════ -->
    <t t-if="state.step === 'importing'">
      <div class="po-import-card">
        <h2>Step 4 – Import Progress</h2>

        <div class="batch-info-bar">
          <span>Batch <strong><t t-esc="state.currentBatch"/> / <t t-esc="state.totalBatches"/></strong></span>
          <span>Offset <strong><t t-esc="state.currentOffset"/></strong></span>
          <span>Processed <strong><t t-esc="state.processedRows"/> / <t t-esc="state.totalRows"/></strong></span>
          <span>Remaining <strong><t t-esc="state.totalRows - state.processedRows > 0 ? state.totalRows - state.processedRows : 0"/></strong></span>
        </div>

        <div class="progress-bar-wrap">
          <div class="progress-bar-fill" t-attf-style="width:#{progressPct()}%">
            <t t-if="progressPct() > 8"><t t-esc="progressPct()"/>%</t>
          </div>
        </div>
        <div class="text-end small text-muted mb-3"><t t-esc="progressPct()"/>% complete</div>

        <t t-if="state.batchRunning">
          <div class="po-alert po-alert-info">
            <span class="po-spinner"/>Processing batch <t t-esc="state.currentBatch"/>… please wait.
          </div>
        </t>

        <t t-if="state.batchComplete and !state.allDone">
          <div class="po-alert po-alert-success">
            ✓ Batch <strong><t t-esc="state.currentBatch"/></strong> complete.
            Progress: <strong><t t-esc="state.processedRows"/> / <t t-esc="state.totalRows"/></strong> rows.
          </div>

          <h4 class="mt-3" style="font-size:14px; font-weight:600;">This Batch</h4>
          <div class="stats-grid">
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.batchStats.created"/></div><div class="stat-lbl">Created</div></div>
            <div class="stat-card updated"><div class="stat-val"><t t-esc="state.batchStats.updated"/></div><div class="stat-lbl">Updated</div></div>
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.batchStats.transferred"/></div><div class="stat-lbl">Transferred</div></div>
            <div class="stat-card skipped"><div class="stat-val"><t t-esc="state.batchStats.skipped"/></div><div class="stat-lbl">Skipped</div></div>
            <div class="stat-card errors"><div class="stat-val"><t t-esc="state.batchStats.errors"/></div><div class="stat-lbl">Errors</div></div>
          </div>

          <h4 class="mt-3" style="font-size:14px; font-weight:600;">Cumulative Totals</h4>
          <div class="stats-grid">
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.totalStats.created"/></div><div class="stat-lbl">Created</div></div>
            <div class="stat-card updated"><div class="stat-val"><t t-esc="state.totalStats.updated"/></div><div class="stat-lbl">Updated</div></div>
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.totalStats.transferred"/></div><div class="stat-lbl">Transferred</div></div>
            <div class="stat-card skipped"><div class="stat-val"><t t-esc="state.totalStats.skipped"/></div><div class="stat-lbl">Skipped</div></div>
            <div class="stat-card errors"><div class="stat-val"><t t-esc="state.totalStats.errors"/></div><div class="stat-lbl">Errors</div></div>
          </div>

          <t t-if="state.skippedReasons.length">
            <div class="reason-summary skipped-reasons">
              <strong>Skipped – Top Reasons:</strong>
              <ul class="reason-list">
                <t t-foreach="state.skippedReasons" t-as="r" t-key="r.reason">
                  <li><span class="reason-count"><t t-esc="r.count"/></span> <t t-esc="r.reason"/></li>
                </t>
              </ul>
            </div>
          </t>
          <t t-if="state.errorReasons.length">
            <div class="reason-summary error-reasons">
              <strong>Errors – Top Reasons:</strong>
              <ul class="reason-list">
                <t t-foreach="state.errorReasons" t-as="r" t-key="r.reason">
                  <li><span class="reason-count"><t t-esc="r.count"/></span> <t t-esc="r.reason"/></li>
                </t>
              </ul>
            </div>
          </t>
          <div class="download-btns mt-2">
            <a t-attf-href="/product_label/import/download/#{state.jobId}/updated" class="dl-updated" target="_blank">⬇ Download Updated</a>
            <a t-attf-href="/product_label/import/download/#{state.jobId}/skipped" class="dl-skipped" target="_blank">⬇ Download Skipped</a>
            <a t-attf-href="/product_label/import/download/#{state.jobId}/error" class="dl-error" target="_blank">⬇ Download Errors</a>
          </div>
        </t>
      </div>

      <t t-if="!state.allDone">
        <div class="po-import-footer">
          <button class="btn btn-danger" t-on-click="cancelImport" t-att-disabled="state.batchRunning">Cancel Import</button>
          <button class="btn btn-warning" t-on-click="backToMapping" t-att-disabled="state.batchRunning"
                  title="Stop and go back to re-configure the field mapping">↩ Back to Mapping</button>
          <button class="btn btn-primary" t-on-click="continueImport"
                  t-att-disabled="state.batchRunning or !state.batchComplete"
                  invisible="state.allDone">Continue →</button>
        </div>
      </t>
    </t>

    <!-- ═══════════ STEP 5: Done ═══════════ -->
    <t t-if="state.step === 'done'">
      <div class="po-done-banner">
        <h2>🎉 Import Completed!</h2>
        <p>All <strong><t t-esc="state.totalRows"/></strong> rows have been processed.</p>
      </div>

      <div class="po-import-card">
        <h2>Final Statistics</h2>
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-val" style="color:#212529"><t t-esc="state.totalRows"/></div><div class="stat-lbl">Total Rows</div></div>
          <div class="stat-card created"><div class="stat-val"><t t-esc="state.totalStats.created"/></div><div class="stat-lbl">Labels Created</div></div>
          <div class="stat-card updated"><div class="stat-val"><t t-esc="state.totalStats.updated"/></div><div class="stat-lbl">Labels Updated</div></div>
          <div class="stat-card created"><div class="stat-val"><t t-esc="state.totalStats.transferred"/></div><div class="stat-lbl">Transferred</div></div>
          <div class="stat-card skipped"><div class="stat-val"><t t-esc="state.totalStats.skipped"/></div><div class="stat-lbl">Skipped</div></div>
          <div class="stat-card errors"><div class="stat-val"><t t-esc="state.totalStats.errors"/></div><div class="stat-lbl">Errors</div></div>
        </div>

        <t t-if="state.skippedReasons.length or state.errorReasons.length">
          <div class="row g-2 mt-2">
            <t t-if="state.skippedReasons.length">
              <div class="col-md-6">
                <div class="reason-summary skipped-reasons">
                  <strong>Skipped – Top Reasons:</strong>
                  <ul class="reason-list">
                    <t t-foreach="state.skippedReasons" t-as="r" t-key="r.reason">
                      <li><span class="reason-count"><t t-esc="r.count"/></span> <t t-esc="r.reason"/></li>
                    </t>
                  </ul>
                </div>
              </div>
            </t>
            <t t-if="state.errorReasons.length">
              <div class="col-md-6">
                <div class="reason-summary error-reasons">
                  <strong>Errors – Top Reasons:</strong>
                  <ul class="reason-list">
                    <t t-foreach="state.errorReasons" t-as="r" t-key="r.reason">
                      <li><span class="reason-count"><t t-esc="r.count"/></span> <t t-esc="r.reason"/></li>
                    </t>
                  </ul>
                </div>
              </div>
            </t>
          </div>
        </t>
        <div class="download-btns mt-3">
          <a t-attf-href="/product_label/import/download/#{state.jobId}/updated" class="dl-updated" target="_blank">⬇ Download Updated</a>
          <a t-attf-href="/product_label/import/download/#{state.jobId}/skipped" class="dl-skipped" target="_blank">⬇ Download Skipped</a>
          <a t-attf-href="/product_label/import/download/#{state.jobId}/error" class="dl-error" target="_blank">⬇ Download Errors</a>
        </div>
      </div>

      <!-- Update Source Location Result Panel -->
      <t t-if="state.updateSourceLocationResult">
        <div class="po-import-card" style="margin-top:8px;">
          <h2 style="font-size:15px;margin:0 0 12px;">📍 Update Source Location Results</h2>
          <div class="stats-grid" style="margin-bottom:12px;">
            <div class="stat-card updated"><div class="stat-val"><t t-esc="state.updateSourceLocationResult.success"/></div><div class="stat-lbl">Updated</div></div>
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.updateSourceLocationResult.created"/></div><div class="stat-lbl">Created</div></div>
            <div class="stat-card errors"><div class="stat-val"><t t-esc="state.updateSourceLocationResult.failed"/></div><div class="stat-lbl">Failed</div></div>
          </div>
          <t t-if="state.updateSourceLocationResult.errors and state.updateSourceLocationResult.errors.length">
            <div class="reason-summary error-reasons" style="margin-bottom:8px;">
              <strong>Failure Reasons:</strong>
              <ul class="reason-list">
                <t t-foreach="state.updateSourceLocationResult.errors" t-as="e" t-key="e"><li><t t-esc="e"/></li></t>
              </ul>
            </div>
          </t>
          <t t-if="state.updateSourceLocationResult.failed_labels and state.updateSourceLocationResult.failed_labels.length">
            <div class="reason-summary" style="background:#fff3cd;border-color:#ffc107;">
              <strong>Failed Labels:</strong>
              <p style="margin:4px 0 0;font-size:12px;word-break:break-all;">
                <t t-esc="state.updateSourceLocationResult.failed_labels.join(', ')"/>
                <t t-if="state.updateSourceLocationResult.failed > state.updateSourceLocationResult.failed_labels.length">
                  … and <t t-esc="state.updateSourceLocationResult.failed - state.updateSourceLocationResult.failed_labels.length"/> more
                </t>
              </p>
            </div>
          </t>
        </div>
      </t>

      <!-- Transfer Result Panel -->
      <t t-if="state.transferResult">
        <div class="po-import-card" style="margin-top:8px;">
          <h2 style="font-size:15px;margin:0 0 12px;">Transfer Results</h2>
          <div class="stats-grid" style="margin-bottom:12px;">
            <div class="stat-card created"><div class="stat-val"><t t-esc="state.transferResult.success"/></div><div class="stat-lbl">Transferred</div></div>
            <div class="stat-card errors"><div class="stat-val"><t t-esc="state.transferResult.failed"/></div><div class="stat-lbl">Failed</div></div>
          </div>
          <t t-if="state.transferResult.errors and state.transferResult.errors.length">
            <div class="reason-summary error-reasons" style="margin-bottom:8px;">
              <strong>Failure Reasons:</strong>
              <ul class="reason-list">
                <t t-foreach="state.transferResult.errors" t-as="e" t-key="e"><li><t t-esc="e"/></li></t>
              </ul>
            </div>
          </t>
          <t t-if="state.transferResult.failed_labels and state.transferResult.failed_labels.length">
            <div class="reason-summary" style="background:#fff3cd;border-color:#ffc107;">
              <strong>Failed Labels:</strong>
              <p style="margin:4px 0 0;font-size:12px;word-break:break-all;">
                <t t-esc="state.transferResult.failed_labels.join(', ')"/>
                <t t-if="state.transferResult.failed > state.transferResult.failed_labels.length">
                  … and <t t-esc="state.transferResult.failed - state.transferResult.failed_labels.length"/> more
                </t>
              </p>
            </div>
          </t>
        </div>
      </t>

      <div class="po-import-footer">
        <button class="btn btn-secondary" t-on-click="startNewImport">← New Import</button>
        <button class="btn btn-warning" t-on-click="backToMapping"
                title="Keep the same file, but re-configure the field mapping">↩ Back to Mapping</button>
        <button class="btn btn-info" t-on-click="updateSourceLocations" t-att-disabled="state.transferLoading">
          <t t-if="state.transferLoading"><span class="spinner-border spinner-border-sm me-1"/>Updating...</t>
          <t t-else="">📍 Update Source Location</t>
        </button>
        <button class="btn btn-success" t-on-click="triggerLabelTransfers" t-att-disabled="state.transferLoading">
          <t t-if="state.transferLoading"><span class="spinner-border spinner-border-sm me-1"/>Transferring...</t>
          <t t-else="">⇄ Transfer Imported Labels</t>
        </button>
        <button class="btn btn-primary" t-on-click="viewHistory">View Import History</button>
      </div>
    </t>

  </div>
</t>

</templates>