<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_customer_schemes" model="ir.ui.view">
        <field name="name">account.move.form.inherit.customer.schemes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//group[@name='sale_info_group']" position="inside">
                <field name="is_scheme_redeemed" invisible="1"/>
                <field name="customer_schemes" widget="many2many_tags" domain="[('partner_id', '=', partner_id)]" readonly="is_scheme_redeemed"/>
            </xpath>
        </field>
    </record>
</odoo>
