<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_customer_schemes" model="ir.ui.view">
        <field name="name">account.move.form.inherit.customer.schemes</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_in_gst_treatment']" position="after">
                <field name="phone" invisible="1"/>
                <field name="is_scheme_redeemed" invisible="1"/>
                <field name="other_person_phone"
                       readonly="is_scheme_redeemed"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="customer_schemes" widget="many2many_tags"
                       domain="[('state', 'in', ('running', 'completed')), ('phone', '!=', False), '|', ('phone', '=', phone), ('phone', '=', other_person_phone)]"
                       readonly="is_scheme_redeemed"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="scheme_amount" string="Customer Paid" readonly="1"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
