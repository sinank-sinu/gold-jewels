<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action: Main Stock Inflow & Outflow Dashboard -->
        <record id="action_stock_inflow_outflow_dashboard" model="ir.actions.client">
            <field name="name">Stock Inflow &amp; Outflow</field>
            <field name="tag">stock_inflow_outflow_dashboard</field>
            <field name="target">current</field>
            <field name="context">{'default_tab': 'inflow_outflow'}</field>
        </record>

        <!-- Client Action: Direct Jump to Vendor-Wise Labels Tab -->
        <record id="action_stock_inflow_outflow_vendor_labels" model="ir.actions.client">
            <field name="name">Vendor-Wise Labels</field>
            <field name="tag">stock_inflow_outflow_dashboard</field>
            <field name="target">current</field>
            <field name="context">{'default_tab': 'vendor_labels'}</field>
        </record>

        <!-- Separate Standalone App Menu -->
        <menuitem
            id="menu_stock_inflow_outflow_root"
            name="Stock Inflow Outflow"
            web_icon="stock_inflow_outflow,static/description/icon.png"
            sequence="22"
            groups="base.group_user"
        />

        <menuitem
            id="menu_stock_inflow_outflow_main"
            name="Stock Inflow &amp; Outflow"
            parent="menu_stock_inflow_outflow_root"
            action="action_stock_inflow_outflow_dashboard"
            sequence="1"
            groups="base.group_user"
        />

        <menuitem
            id="menu_stock_inflow_outflow_vendor_labels"
            name="Vendor-Wise Labels"
            parent="menu_stock_inflow_outflow_root"
            action="action_stock_inflow_outflow_vendor_labels"
            sequence="2"
            groups="base.group_user"
        />
    </data>
</odoo>

