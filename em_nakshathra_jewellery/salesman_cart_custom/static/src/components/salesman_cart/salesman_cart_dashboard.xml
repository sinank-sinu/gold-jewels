<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="salesman_cart.SalesmanCartDashboard" owl="1">
        <div class="d-flex h-100 bg-100 p-3 flex-column flex-md-row gap-3 overflow-hidden">
            <div class="flex-grow-1 overflow-auto bg-white rounded shadow-sm p-3">
                
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom pb-2 mb-3 gap-2">
                    <h4 class="mb-0 font-weight-bold text-dark">Jewellery Catalog Showcase</h4>
                    <!--ORIGINAL-->
                    <div class="input-group" style="max-width: 320px;">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="fa fa-search"/>
                        </span>
                        <input type="text" 
                               class="form-control border-start-0 ps-0 shadow-none" 
                               placeholder="Search jewelry pieces..."
                               t-model="state.searchQuery"
                               t-on-input="onSearchInput"/>
                        <t t-if="state.searchQuery">
                            <button class="btn btn-outline-secondary border-start-0" 
                                    t-on-click="clearSearch">
                                <i class="fa fa-times"/>
                            </button>
                        </t>
                    </div>
                </div>
                
                <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                    <t t-foreach="filteredProducts" t-as="item" t-key="item.unique_id">
                        <div class="col">
                            <div class="card h-100 border-2 shadow-sm rounded-lg hover-elevation">
                                <div class="bg-light d-flex align-items-center justify-content-center p-3 border-bottom" style="height: 140px;">
                                    <img t-attf-src="/web/image/product.product/{{item.product_id}}/image_128" 
                                         alt="Jewelry Piece" class="img-fluid rounded" style="max-height: 120px; object-fit: contain;"/>
                                </div>
                                <div class="card-body p-2 d-flex flex-column justify-content-between">
                                    <div>
                                        <h6 class="card-title text-truncate text-primary mb-1 font-weight-bold"><t t-esc="item.name"/></h6>
                                        <small class="text-muted d-block text-truncate mb-1"><t t-esc="item.sub_name"/></small>
                                        <div class="d-flex justify-content-between align-items-center text-muted small mb-2">
                                            <span t-if="item.price_info" class="text-success font-weight-bold h6 mb-0"><t t-esc="item.price_info"/></span>
                                            <span t-else=""></span>
                                            <span><t t-esc="item.type === 'label' ? 'Weight' : 'Avail'"/>: <span class="badge bg-info"><t t-esc="item.weight"/> g</span></span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center justify-content-between mt-2 border-top pt-2 gap-2">
                                        <t t-if="item.type === 'vault' || item.type === 'product'">
                                            <div class="input-group input-group-sm" style="width: 110px;">
                                                <input type="number" 
                                                       class="form-control" 
                                                       t-att-value="state.inputWeights[item.unique_id] !== undefined ? state.inputWeights[item.unique_id] : (item.inputWeight || 1.0)" 
                                                       t-on-input="(ev) => this.onWeightInput(item.unique_id, ev)"
                                                       step="0.001" 
                                                       min="0.001" 
                                                       placeholder="Wgt"/>
                                                <span class="input-group-text">g</span>
                                            </div>
                                        </t>
                                        <div t-else=""></div>
                                        <button t-attf-class="btn btn-sm px-3 rounded-pill #{item.in_tray ? 'btn-secondary text-white' : 'btn-primary'}" 
                                                style="max-width: fit-content;"
                                                t-att-disabled="state.loading || item.in_tray"
                                                t-on-click="() => this.addToCart(item.unique_id)">
                                            <i t-attf-class="fa #{item.in_tray ? 'fa-check' : 'fa-shopping-basket'} me-1"/>
                                            <t t-if="item.in_tray">In Tray</t>
                                            <t t-else="">Add to Tray</t>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <t t-if="filteredProducts.length === 0">
                    <div class="text-center text-muted my-5">
                        <i class="fa fa-search fa-3x mb-3 text-secondary"/>
                        <p>No matching jewelry pieces found for "<t t-esc="state.searchQuery"/>".</p>
                    </div>
                </t>
            </div>

            <div class="bg-dark text-white rounded shadow p-3 d-flex flex-column justify-content-between flex-shrink-0" style="width: 350px; min-height: 400px;">
                <div>
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3">
                        <h5 class="mb-0 text-warning"><i class="fa fa-folder-open me-2"/>My Salesman Tray</h5>
                    </div>

                    <div class="overflow-auto pe-1" style="max-height: 55vh;">
                        <t t-if="state.cartLines.length === 0">
                            <div class="text-center text-muted my-5">
                                <i class="fa fa-tags fa-3x mb-3 text-secondary"/>
                                <p>No pieces selected yet.<br/>Tap product item cards to stack.</p>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="d-flex flex-column gap-2">
                                <t t-foreach="state.cartLines" t-as="line" t-key="line.id">
                                    <div class="bg-secondary bg-opacity-20 p-2 rounded d-flex justify-content-between align-items-center border border-secondary">
                                        <div>
                                            <span class="d-block text-truncate text-wrap font-weight-bold text-dark" style="max-width: 200px; color: #000000;">
                                                <t t-esc="line.label_id ? line.label_id[1] : line.product_id[1]"/>
                                            </span>
                                            <small class="text-warning">Wgt: <t t-esc="line.qty"/> g</small>
                                        </div>
                                        
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-success font-weight-bold"><t t-esc="line.price_subtotal"/></span>
                                            <button t-attf-class="btn btn-link p-0 border-0 ms-1 shadow-none #{line.is_locked ? 'text-warning' : 'text-secondary'}" 
                                                    t-att-disabled="state.loading"
                                                    t-on-click="() => this.toggleLock(line.id)"
                                                    title="Lock for Checkout">
                                                <i t-attf-class="fa #{line.is_locked ? 'fa-lock' : 'fa-unlock'} fs-5"/>
                                            </button>
                                            <button class="btn btn-link text-danger p-0 border-0 ms-1 shadow-none" 
                                                    t-att-disabled="state.loading"
                                                    t-on-click="() => this.removeFromCart(line.id)"
                                                    title="Remove from Tray">
                                                <i class="fa fa-trash-o fs-5"/>
                                            </button>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

                <div class="border-top border-secondary pt-3 mt-3">
                    <button class="btn btn-warning w-100 py-2 font-weight-bold rounded-pill shadow" 
                            t-att-disabled="state.cartLines.length === 0"
                            t-on-click="proceedToCheckout">
                        <i class="fa fa-credit-card-alt me-2"/> Send to Billing Counter
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>

