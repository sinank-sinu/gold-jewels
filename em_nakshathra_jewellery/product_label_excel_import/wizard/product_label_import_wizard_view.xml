<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form -->
    <record id="view_product_label_import_wizard_form" model="ir.ui.view">
        <field name="name">product.label.import.wizard.form</field>
        <field name="model">product.label.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Product Labels">

                <sheet>

                    <group>

                        <field
                                name="file"
                                filename="filename"
                                required="1"/>

                        <field
                                name="filename"
                                invisible="1"/>

                    </group>

                </sheet>

                <footer>

                    <button
                            name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"/>

                    <button
                            string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_product_label_import_wizard"
            model="ir.actions.act_window">

        <field name="name">Import Product Labels</field>
        <field name="res_model">product.label.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

</odoo>