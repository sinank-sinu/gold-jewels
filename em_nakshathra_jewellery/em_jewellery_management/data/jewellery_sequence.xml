    <record id="loc_branch_old_gold" model="stock.location">
        <field name="name">Old Gold</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_stock"/>
    </record>
    <record id="seq_old_gold_purchase" model="ir.sequence">
        <field name="name">Old Gold Purchase</field>
        <field name="code">old.gold.purchase</field>
        <field name="prefix">OGP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_old_gold_ho_verification" model="ir.sequence">
        <field name="name">Old Gold HO Verification</field>
        <field name="code">old.gold.ho.verification</field>
        <field name="prefix">OG-HO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="loc_refinery" model="stock.location">
        <field name="name">Refinery</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_locations"/>
        <field name="company_id" eval="False"/>
    </record>
    <record id="product_bullion_gold" model="product.product">
        <field name="name">Gold Bullion</field>
        <field name="type">product</field>
        <field name="is_bullion_product">True</field>
<!--        <field name="sale_ok">True</field>-->
        <field name="purchase_ok">True</field>
        <field name="tracking">none</field>
    </record>
    <record id="action_old_gold_ho_transfer_server" model="ir.actions.server">
        <field name="name">HO Transfer</field>
        <field name="model_id" ref="model_old_gold_purchase"/>
        <field name="binding_model_id" ref="model_old_gold_purchase"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
            <field name="code">
    action = {
        'type': 'ir.actions.act_window',
        'res_model': 'old.gold.ho.transfer.wizard',
        'view_mode': 'form',
        'target': 'new',
        'context': {
            'active_ids': records.ids,
            'active_model': 'old.gold.purchase',
        }
    }
            </field>
    </record>

    <record id="action_sale_old_gold_line_ho_transfer_server" model="ir.actions.server">
        <field name="name">HO Transfer</field>
        <field name="model_id" ref="model_sale_old_gold_line"/>
        <field name="binding_model_id" ref="model_sale_old_gold_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_old_gold')), (4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_ho_transfer_wizard()
        </field>
    </record>

    <record id="action_create_refinery_issue" model="ir.actions.server">
        <field name="name">Create Melting</field>
        <field name="model_id" ref="model_old_gold_batch"/>
        <field name="binding_model_id" ref="model_old_gold_batch"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_old_gold')), (4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
            records.action_create_refinery_issue()
        </field>
    </record>

    <record id="action_batch_diamond_transfer" model="ir.actions.server">
        <field name="name">Diamond Transfer</field>
        <field name="model_id" ref="model_old_gold_batch"/>
        <field name="binding_model_id" ref="model_old_gold_batch"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_old_gold')), (4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('base.group_system'))]"/>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_diamond_transfer_wizard()
        </field>
    </record>
    <record id="product_add_less_old_gold" model="product.product">
        <field name="name">Add/Less Old Gold</field>
        <field name="type">product</field> <!-- stockable product -->
        <field name="sale_ok">False</field> <!-- Not for sale -->
        <field name="purchase_ok">False</field> <!-- Not for purchase -->
        <field name="tracking">none</field>
    </record>
    <record id="product_scrap" model="product.product">
        <field name="name">Scrap Bar</field>
        <field name="type">product</field> <!-- stockable product -->
        <field name="uom_id" ref="uom.product_uom_gram"/>
        <field name="uom_po_id" ref="uom.product_uom_gram"/>
        <field name="sale_ok">False</field> <!-- Not for sale -->
        <field name="purchase_ok">False</field> <!-- Not for purchase -->
        <field name="is_old_gold">True</field>
        <field name="tracking">none</field>
    </record>

<!--    Sequence Generation-->

     <record id="seq_product_label" model="ir.sequence">
        <field name="name">Product Label</field>
        <field name="code">product.label</field>
        <field name="prefix">LBL/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_jewellery_scheme_enrollment" model="ir.sequence">
        <field name="name">Jewellery Scheme Ticket</field>
        <field name="code">jewellery.scheme.enrollment</field>
        <field name="prefix">SWSMB-1-M-</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

     <record id="seq_jewellery_job_work" model="ir.sequence">
        <field name="name">Jewellery Job Work</field>
        <field name="code">jewellery.job.work</field>
        <field name="prefix">JW/</field>
        <field name="padding">5</field>
         <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_jewellery_issue_voucher" model="ir.sequence">
        <field name="name">Jewellery Issue Voucher</field>
        <field name="code">jewellery.issue.voucher</field>
        <field name="prefix">IV/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_jewellery_receive_voucher" model="ir.sequence">
        <field name="name">Jewellery Receive Voucher</field>
        <field name="code">jewellery.receive.voucher</field>
        <field name="prefix">RV/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_refinery" model="ir.sequence">
        <field name="name">Refinery Order</field>
        <field name="code">jewellery.refinery</field>
        <field name="prefix">REF/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>

    </record>




</data>



</odoo>
