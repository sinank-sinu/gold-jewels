<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_label_form" model="ir.ui.view">
        <field name="name">product.label.form</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                            name="action_set_active"
                            type="object"
                            string="Set Active"
                            class="btn-primary"
                            invisible="active"
                    />
                    <button
                            name="action_stock_in"
                            type="object"
                            string="Transfer"
                            class="btn-primary"
                            invisible="is_stocked_in"
                    />
                    <field name="active" widget="boolean_toggle"/>
                    <field name="is_stocked_in" invisible="1"/>
                    <field name="picking_id" invisible="1"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Picking</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="age" readonly="1"/>
                        <field name="product_id"/>
                        <field name="branch_id"/>
                        <field name="source_location_id" required="1"/>
                        <field name="branch_location_id" required="1"/>
                        <field name="tag_weight"/>
                        <field name="purity_id"/>

                    </group>

                    <notebook>
                        <page name="Details">
                            <group string="Barcode">
                                <field name="barcode" readonly="active" />
                            </group>
                            <group>
                                <field name="job_work_id"
                                       domain="[('state', 'in', ['received', 'done']),('job_work_line_ids.product_id','=',product_id)]"/>
                                <field name="unlabelled_weight_jw"/>

                                <field name="purchase_id"/>
                                <field name="unlabelled_weight"/>


                            </group>
                            <group string="Diamond Certificate">
                                <field name="diamond_certificate"
                                       filename="diamond_certificate_filename"/>
                                <field name="diamond_certificate_filename"
                                       invisible="1"/>

                            </group>
                        </page>
                        <page name="Sale Details">
                            <group string="Jewellery Sale Details">
                                <group>
                                    <!--                                    <field name="sale_purity_id"/>-->
                                    <!--                                    <field name="sale_price_per_gram"/>-->
                                    <field name="sale_fine_weight"/>
                                    <field name="other_weight_g"/>
                                    <field name="other_weight_amount"/>
                                </group>

                                <group string="Weights">
                                    <field name="sale_gross_weight"/>
                                    <field name="sale_stone_weight"/>
                                    <field name="sale_stone_weight_ct"/>
                                    <field name="sale_diamond_weight_gm"/>
                                    <field name="sale_diamond_weight_ct"/>
                                    <field name="sale_net_weight" readonly="1"/>
                                </group>

                                <group string="Rates">
                                    <!--                                    <field name="sale_metal_rate"/>-->
                                    <field name="sale_stone_rate"/>
                                    <field name="sale_diamond_rate"/>
                                </group>

                                <group string="Making Charge">
                                    <field name="sale_making_charge_type"/>
                                    <field name="sale_making_charge_value"/>
                                    <field name="sale_making_charge_min"/>
                                    <field name="sale_making_charge_amount" readonly="1" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="Purchase Details">
                            <group string="Jewellery Purchase Details">
                                <group>
                                    <!--                                    <field name="purchase_purity_id"/>-->
                                    <field name="purchase_price_per_gram"/>
                                    <field name="purchase_fine_weight"/>
                                    <field name="certification_charge"/>
                                    <field name="transportation_charge"/>
                                    <field name="cargo_charge"/>
                                    <field name="others"/>

                                </group>

                                <group string="Weights">
                                    <field name="purchase_gross_weight"/>
                                    <field name="purchase_stone_weight"/>
                                    <field name="purchase_stone_weight_ct"/>
                                    <field name="purchase_diamond_weight_gm"/>
                                    <field name="purchase_diamond_weight_ct"/>
                                    <field name="purchase_net_weight" readonly="1"/>
                                </group>

                                <group string="Rates">
                                    <field name="purchase_metal_rate"/>
                                    <field name="purchase_stone_rate"/>
                                    <field name="purchase_diamond_rate"/>
                                </group>

                                <group string="Making Charge">
                                    <field name="purchase_making_charge_type"/>
                                    <field name="purchase_making_charge_value"/>
                                    <field name="mc_fine"/>
                                    <field name="purchase_making_charge_amount" readonly="1"/>
                                </group>
                            </group>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_label_tree" model="ir.ui.view">
        <field name="name">product.label.tree</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="age" readonly="1"/>
                <field name="product_tmpl_id"/>

            </tree>
        </field>
    </record>

    <record id="view_product_label_search" model="ir.ui.view">
        <field name="name">product.label.search</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Label Reference"/>
                <field name="product_tmpl_id"/>
                <separator/>
                <filter string="Sold / Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_product_label" model="ir.actions.act_window">
        <field name="name">Product Labels</field>
        <field name="res_model">product.label</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('branch_id', '=', False), ('branch_id.company_id', 'in', allowed_company_ids)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create product-specific labels with weight and price breakup.
            </p>
        </field>
    </record>

    <!-- NEW TRACKER FORM VIEW -->
    <record id="view_product_label_tracker_form" model="ir.ui.view">
        <field name="name">product.label.tracker.form</field>
        <field name="model">product.label</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="product_tmpl_id" readonly="1"/>
                    </group>
                    
                    <!-- THE VISUAL TIMELINE -->
                    <field name="visual_html" widget="html" readonly="1" nolabel="1" style="width:100%; border:none;"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TRACKER ACTION -->
    <record id="action_product_label_tracker" model="ir.actions.act_window">
        <field name="name">Label Tracker</field>
        <field name="res_model">product.label</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('branch_id', '=', False), ('branch_id.company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track all labels, including sold/inactive ones.
            </p>
        </field>
    </record>

    <!-- BIND TRACKER ACTION TO TRACKER FORM -->
    <record id="action_product_label_tracker_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_label_tracker_form"/>
        <field name="act_window_id" ref="action_product_label_tracker"/>
    </record>

    <!-- BIND TRACKER ACTION TO STANDARD TREE -->
    <record id="action_product_label_tracker_tree_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_product_label_tree"/>
        <field name="act_window_id" ref="action_product_label_tracker"/>
    </record>

</odoo>