<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_scheme_tree" model="ir.ui.view">
        <field name="name">scheme.tree</field>
        <field name="model">jewellery.scheme.enrollment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="ticket_number"/>
                <field name="partner_id"/>
                <field name="total_paid"/>
                <field name="balance_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_scheme_form" model="ir.ui.view">
        <field name="name">scheme.form</field>
        <field name="model">jewellery.scheme.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_set_active_rate"
                        type="object"
                        string="Set Active"
                        class="btn-primary"
                        invisible="active"
                    />
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_number" readonly="active"/>
                            <field name="partner_id" readonly="active"/>
                            <field name="phone" readonly="active"/>
                            <field name="whatsapp_number"/>
                            <field name="address"/>
                            <field name="nominee" readonly="active"/>
                            <field name="nominee_phone" readonly="active"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_of_joining" readonly="active"/>
                            <field name="duration" readonly="1"/>
                            <field name="branch_id"/>
                            <field name="installment_amount" readonly="active"/>
                            <field name="total_paid" readonly="1"/>
                            <field name="balance_amount" readonly="1"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments">
                            <field name="scheme_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="journal_id"/>
                                    <field name="state"/>
                                    <button name="action_confirm_payment"
                                            type="object"
                                            string="Confirm Payment"
                                            class="btn-primary"
                                            invisible="state == 'paid'"/>
                                    <field name="is_transferred" invisible="1"/>
                                    <button name="action_transfer"
                                            type="object"
                                            string="Transfer"
                                            class="btn-secondary"
                                            invisible="is_transferred or state == 'paid'"/>
                                    <field name="move_id"/>
                                    <field name="transaction_id"/>
                                    <field name="remark"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_scheme_search" model="ir.ui.view">
        <field name="name">scheme.search</field>
        <field name="model">jewellery.scheme.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Scheme Name"/>
                <field name="ticket_number"/>
                <field name="partner_id" string="Customer"/>
                <field name="phone"/>
                <field name="whatsapp_number"/>
                <field name="nominee"/>
                <field name="nominee_phone"/>
                <separator/>
                <filter string="Running" name="filter_running" domain="[('state', '=', 'running')]"/>
                <filter string="Redeemed" name="filter_redeemed" domain="[('state', '=', 'redeemed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_by_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_scheme_enrollment" model="ir.actions.act_window">
        <field name="name">Jewellery Schemes</field>
        <field name="res_model">jewellery.scheme.enrollment</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
