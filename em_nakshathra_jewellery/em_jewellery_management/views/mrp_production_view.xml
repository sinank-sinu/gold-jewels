<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_jewellery" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.jewellery</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="branch_id"/>
                <field name="purity_id"/>
                <field name="total_grams"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_uom_qty']" position="after">
                <field name="grams" optional="show"/>
                <field name="purity_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="product_template_id" required="1"/>
                <field name="product_uom" invisible="1"/>
                <field name="order_line" invisible="1"/>
                <field name="product_template_attribute_value_ids" invisible="1"/>
                <field name="product_no_variant_attribute_value_ids" invisible="1"/>
                <field name="product_custom_attribute_value_ids" invisible="1"/>
                <field name="product_uom_qty" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="pricelist_id" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="date_order" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="order_id" invisible="1"/>
                <field name="is_configurable_product" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">Product Variant</attribute>
                <attribute name="domain">[('product_tmpl_id', '=', product_template_id)]</attribute>
                <attribute name="widget">sol_product_many2one</attribute>
            </xpath>
        </field>
    </record>
</odoo>
