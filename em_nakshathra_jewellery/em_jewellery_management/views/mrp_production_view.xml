<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_view_inherit_jewellery" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.jewellery</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="branch_id"/>
                <field name="purity_id"/>
                <field name="total_grams"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_uom_qty']" position="after">
                <field name="grams" optional="show"/>
                <field name="purity_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
