<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Customer Payments Action for Jewellery / Schemes -->
    <record id="action_jewellery_customer_payments" model="ir.actions.act_window">
        <field name="name">Customer Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{
            'default_payment_type': 'inbound',
            'default_partner_type': 'customer',
            'search_default_inbound_filter': 1,
            'default_move_journal_types': ('bank', 'cash'),
        }</field>
        <field name="view_id" ref="account.view_account_payment_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a customer payment
            </p>
            <p>
                Payments are used to track customer payments. Click New to register a payment.
            </p>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_jewellery" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.jewellery</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][1]" position="attributes">
                <attribute name="context">{'default_is_company': True, 'default_phone': phone, 'default_mobile': phone}</attribute>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="attributes">
                <attribute name="context">{'default_is_company': True, 'default_phone': phone, 'default_mobile': phone}</attribute>
            </xpath>
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="after">
                <field name="phone" widget="phone" invisible="is_internal_transfer" readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="invoice_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                <field name="sale_id" readonly="1" invisible="not sale_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_jewellery_phone" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.jewellery.phone</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="phone" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_inherit_jewellery_phone" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.jewellery.phone</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', '|', ('name', 'ilike', self), ('partner_id', 'ilike', self), ('phone', 'ilike', self), ('ref', 'ilike', self), ('amount_company_currency_signed', 'ilike', self), ('amount', 'ilike', self)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="phone"/>
            </xpath>
        </field>
    </record>
</odoo>
