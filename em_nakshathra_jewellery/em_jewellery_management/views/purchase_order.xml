<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_inherit2" model="ir.ui.view">
        <field name="name">purchase.order.inherit2</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="attributes">
                <attribute name="style">max-width: 2320px;</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="replace">
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='qty_invoiced']/following-sibling::field[@name='product_uom']" position="replace">
            </xpath>
             <xpath expr="//field[@name='effective_date']" position="after">
                <field name="is_old_gold" widget="boolean_toggle" string="OG" readonly="is_diamond_og or is_purchase_expense or unfix" force_save="1"/>
                   <field name="is_diamond_og" widget="boolean_toggle" readonly="is_old_gold or is_purchase_expense or unfix" force_save="1"/>
                <field name="is_purchase_expense" widget="boolean_toggle" readonly="is_old_gold or is_diamond_og or unfix" force_save="1"/>
                <field name="unfix" widget="boolean_toggle" readonly="is_old_gold or is_diamond_og or is_purchase_expense" force_save="1"/>
                <field name="is_sale_return_po" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="date_order" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="sale_id"/>
                <field name="total_weight" readonly="1"/>
                <field name="total_labelled" readonly="1"/>
                <field name="total_unlabelled" readonly="1"/>
            </xpath>


            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="attributes">
                    <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_qty']" position="attributes">
                    <attribute name="string">Gross weight</attribute>
                    <attribute name="sum">Total</attribute>
                    <attribute name="digits">[16, 3]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='taxes_id']" position="attributes">
                <attribute name="column_invisible">parent.is_purchase_expense</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_create_sale_order"
                    type="object"
                    string="Create Sale Order"
                    class="btn-primary"
                    invisible="sale_id != False or not unfix"
                />
                 <button name="action_create_bill_and_pay"
                    type="object"
                    string="Create Bill &amp; Pay"
                    class="btn-primary"
                    invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_qty']" position="after">
                <field name="stone_weight" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="diamond_weight_gm" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="net_weight" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="fine_weight" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="gold_rate" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>
                <field name="metal_amount" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>
                <field name="purchase_making_charge_type" column_invisible="parent.is_purchase_expense"/>
<!--                jafar side-->
                <field name="rate_value" optional="show" column_invisible="parent.is_purchase_expense"/>
                <field name="mc_percent" readonly="purchase_making_charge_type != 'percent'" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>
                <field name="purchase_making_charge_value" readonly="purchase_making_charge_type != 'amount'" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>

                <field name="mc_fine" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>
                <field name="mc_amount" column_invisible="parent.is_old_gold or parent.is_purchase_expense"/>
                <field name="stone_rate" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="diamond_rate" optional="hide" column_invisible="parent.is_purchase_expense"/>
                <field name="price_subtotal"/>
                <field name="total_fine" sum="Total Fine" digits="[16, 3]" column_invisible="parent.is_purchase_expense"/>

            </xpath>
            <xpath expr="//form" position="attributes">
                <attribute name="chatter">false</attribute>
            </xpath>
            <xpath expr="//form/div[contains(@class,'oe_chatter')]" position="replace"/>
            <xpath expr="//sheet" position="inside">
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'always'}"/>
                    </div>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_form_matrix" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.matrix</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_product_matrix.purchase_order_form_matrix"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="after">
                <field name="product_id" string="Variety" widget="sol_product_many2one" column_invisible="parent.is_purchase_expense" domain="[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), ('is_old_gold', '=', parent.is_old_gold), ('is_diamond_og', '=', parent.is_diamond_og), ('is_purchase_expense', '=', parent.is_purchase_expense)]"/>
                <field name="product_uom" string="UOM" column_invisible="parent.is_purchase_expense"/>
                <field name="purity_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" column_invisible="parent.is_purchase_expense" domain="[('is_diamond_og', '=', True)] if parent.is_diamond_og else ([('is_diamond_og', '=', False)] if parent.is_old_gold else [])"/>
                <field name="product_template_attribute_value_ids" column_invisible="1"/>
                <field name="product_no_variant_attribute_value_ids" column_invisible="1"/>
                <field name="product_custom_attribute_value_ids" column_invisible="1"/>
                <field name="product_uom_qty" column_invisible="1"/>
                <field name="product_type" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_configurable_product" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="attributes">
                <attribute name="string">Product</attribute>
                <attribute name="widget"></attribute>
                <attribute name="column_invisible">parent.is_old_gold or parent.is_diamond_og</attribute>
                <attribute name="required">not display_type and not parent.is_old_gold and not parent.is_diamond_og</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), ('is_old_gold', '=', parent.is_old_gold), ('is_diamond_og', '=', parent.is_diamond_og), ('is_purchase_expense', '=', parent.is_purchase_expense)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id'][1]" position="attributes">
                <attribute name="required">not display_type and not parent.is_purchase_expense</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), ('is_old_gold', '=', parent.is_old_gold), ('is_diamond_og', '=', parent.is_diamond_og), ('is_purchase_expense', '=', parent.is_purchase_expense)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), ('is_old_gold', '=', parent.is_old_gold), ('is_diamond_og', '=', parent.is_diamond_og), ('is_purchase_expense', '=', parent.is_purchase_expense)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>