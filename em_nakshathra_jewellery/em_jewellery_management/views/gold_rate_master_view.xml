<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_gold_rate_master_form" model="ir.ui.view">
        <field name="name">gold.rate.master.form</field>
        <field name="model">gold.rate.master</field>
        <field name="arch" type="xml">
            <form string="Gold Rate">
                <header>
                    <button
                        name="action_set_active_rate"
                        type="object"
                        string="Set Active"
                        class="btn-primary"
                        invisible="active"
                    />
                    <button
                        name="action_log_rate_update"
                        type="object"
                        string="Update"
                        class="btn-primary"
                    />
                    <field name="active" widget="boolean_toggle"/>
                </header>

                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="rate_type"/>
                        <field name="rate_per_gram"/>
                        <field name="purity_id"/>
<!--                       from jafar side-->
                        <!-- <field name="fine_rate"/> -->
                        <field name="board_rate" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gold_rate_master_tree" model="ir.ui.view">
        <field name="name">gold.rate.master.tree</field>
        <field name="model">gold.rate.master</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="rate_per_gram"/>
                <field name="rate_type"/>
<!--                form jafar side-->
                <field name="board_rate" column_invisible="1"/>
                <!-- <field name="fine_rate"/> -->
                <field name="purity_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_gold_rate_master" model="ir.actions.act_window">
        <field name="name">Gold Rates</field>
        <field name="res_model">gold.rate.master</field>
        <field name="view_mode">tree,form</field>
            <field name="context">{'active_test': False}</field>

    </record>
    <record id="view_gold_rate_update_log_form" model="ir.ui.view">
        <field name="name">gold.rate.update.log.form</field>
        <field name="model">gold.rate.update.log</field>
        <field name="arch" type="xml">
            <form string="Gold Rate Update">
                <sheet>
                    <group>
                        <field name="rate_datetime" readonly="1"/>
                        <field name="purity_id" readonly="1"/>
                        <field name="rate_type"/>

                    </group>
                    <group>
                        <field name="rate_per_gram" readonly="1"/>
                        <field name="board_rate" readonly="1"/>
                    </group>
                    <group>
                        <field name="master_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gold_rate_update_log_tree" model="ir.ui.view">
        <field name="name">gold.rate.update.log.tree</field>
        <field name="model">gold.rate.update.log</field>
        <field name="arch" type="xml">
            <tree string="Gold Rate Update Log" create="false">
                <field name="rate_datetime"/>
                <field name="purity_id"/>
                <field name="rate_type"/>
                <field name="rate_per_gram"/>
                <field name="board_rate"/>
                <field name="master_id"/>
            </tree>
        </field>
    </record>

    <record id="action_gold_rate_update_log" model="ir.actions.act_window">
        <field name="name">Gold Rate Updates</field>
        <field name="res_model">gold.rate.update.log</field>
        <field name="view_mode">tree,form</field>
    </record>




</odoo>