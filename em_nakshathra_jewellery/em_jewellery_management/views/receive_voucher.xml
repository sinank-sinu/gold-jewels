<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_receive_voucher_tree" model="ir.ui.view">
        <field name="name">jewellery.receive.voucher.tree</field>
        <field name="model">jewellery.receive.voucher</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="wastage_weight"/>
                <field name="state"/>
                    <field name="total_net_weight" readonly="1"/>

            </tree>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_receive_voucher_form" model="ir.ui.view">
        <field name="name">jewellery.receive.voucher.form</field>
        <field name="model">jewellery.receive.voucher</field>
        <field name="arch" type="xml">
            <form string="Receive Voucher">
                 <header>
                      <button name="action_dept_approve" string="Department Approve" type="object"
                                class="oe_highlight"
                                groups="cr_material_purchase_requisitions.department_access"
                                invisible="state not in ('draft', 'waiting_department_approval')"/>
                      <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                                groups="cr_material_purchase_requisitions.user_access"
                                invisible="state not in ('draft','waiting_department_approval','waiting_ir_approval')"/>
                      <button name="action_done"
                            type="object"
                            string="Confirm"
                            class="btn-primary"
                            invisible="state not in 'approved'"/>
                      <button
                              name="action_create_making_charge_bill"
                              type="object" string="Making Charge Bill" class="btn-secondary"
                              invisible="making_charge_bill_id or job_type_selection != 'gold_alloy'"/>
                      <field name="state" widget="statusbar" statusbar_visible="draft,waiting_department_approval,waiting_ir_approval,approved,done"/>
                 </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_making_charge_bills"
                                    string="Vendor Bills"
                                    type="object"
                                    class="oe_link"
                                    invisible="not making_charge_bill_id"/>
                        <button
                                name="action_view_bullion_transfers"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                string="Transfers"/>
                    </div>
                    <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                    <group>
                        <field name="issue_voucher_id" readonly="1" invisible="not issue_voucher_id"/>
                        <field name="is_refinery" widget="boolean_toggle"/>
                        <field name="job_work_id" invisible="is_refinery" required="not is_refinery"/>
                        <field name="job_worker_id" invisible="is_refinery" required="not is_refinery"/>
                        <field name="refinery_id" invisible="not is_refinery" required="is_refinery"/>
                        <field name="wastage_weight"/>
                        <field name="total_net_weight" readonly="1"/>
                        <field name="job_type_selection"/>
                        <field name="making_charge_type" invisible="job_type_selection != 'gold_alloy'"/>
                        <field name="mc_percent" invisible="making_charge_type != 'percent' or job_type_selection != 'gold_alloy'"/>
                        <field name="fine_rate" invisible="making_charge_type != 'percent' or job_type_selection != 'gold_alloy'" string="Fine Rate (g)"/>
                        <field name="mc_fine" invisible="making_charge_type != 'percent' or job_type_selection != 'gold_alloy'" readonly="1" string="MC Fine"/>
                        <field name="making_charge_value" invisible="making_charge_type != 'amount' or job_type_selection != 'gold_alloy'"/>
                        <field name="rate_value" invisible="making_charge_type != 'rate_per_gram' or job_type_selection != 'gold_alloy'"/>
                        <field name="making_charge_amount" invisible="job_type_selection != 'gold_alloy'" />
                        <field name="making_charge_bill_id" invisible="1"/>
                        <field name="source_location_id"/>
                        <field name="received_location_id"/>
                    </group>
                    <notebook>
                        <page string="Ornaments">
                            <field name="line_ids">
                                <tree editable="bottom">

                                    <field name="product_template_id"
                                    string="Product" readonly="False"/>
                                    <field
                                    name="product_id"
                                    string="Variant"
                                    widget="sol_product_many2one"
                                    readonly="False"/>

                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="purity_id"/>
                                    <field name="lab_purity" column_invisible="not parent.is_refinery"/>
                                    <field name="gross_weight" />
                                    <field name="stone_weight" column_invisible="parent.is_refinery"/>
                                    <field name="diamond_weight" column_invisible="parent.is_refinery"/>
                                    <field name="net_weight" column_invisible="parent.is_refinery"/>
                                    <field name="purchase_making_charge_value" string="MC%"/>
                                    <field name="mc_fine"/>
                                    <field name="fine_weight" optional="hide"/>
                                    <field name="total_fine"/>
                                    <field name="issue_voucher_line_id" 
                                           domain="[('voucher_id', '=', parent.issue_voucher_id)]"
                                           column_invisible="not parent.issue_voucher_id"
                                           optional="show"/>
                                    <field name="fine_gms_price" optional="hide"/>
                                    <field name="total_receive_fine_amount"/>
                                    <field name="fine_balance_amount"/>
                                    <field name="is_lab_line" column_invisible="not parent.is_refinery"/>
                                    <field name="lab_tester_id" invisible="not is_lab_line" column_invisible="not parent.is_refinery"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Information">
                                <group>
                                    <group>
                                        <field name="confirmed_by_id"/>
                                        <field name="department_manager_id"/>
                                        <field name="approved_id"/>
                                    </group>
                                    <group>
                                        <field name="confirmed_date"/>
                                        <field name="department_approval_date"/>
                                        <field name="approved_date"/>
                                    </group>
                                </group>
                            </page>
<!--                        <page string="Detailed List">-->
<!--                            <field name="active_package_line_ids" nolabel="1">-->
<!--                                <tree>-->
<!--                                    <field name="product_id"/>-->
<!--                                    <field name="qty"/>-->
<!--                                    <field name="uom_id"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
    <record id="action_receive_voucher" model="ir.actions.act_window">
        <field name="name">Receive Vouchers</field>
        <field name="res_model">jewellery.receive.voucher</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>