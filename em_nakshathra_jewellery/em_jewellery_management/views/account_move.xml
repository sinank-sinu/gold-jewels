<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add "Asset Category" to supplier invoices -->
    <record model="ir.ui.view" id="view_invoice_label_purity">
        <field name="name">account.invoice.purity.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="after">
                <field name="purity_id"/>
                <field name="label_id"/>
            </xpath>
             <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='name']" position="attributes">
                <attribute name="string">Description</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='analytic_distribution']" position="replace">
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <field name="is_old_gold_bill" invisible="1"/>
                <field name="unfix" invisible="1"/>
                <field name="old_gold_price"  invisible="not old_gold_price"/>
                <field name="sale_return_price" invisible="not sale_return_price"/>
                <field name="vendor_bill_amount" string="PO Amount" invisible="not unfix or move_type != 'out_invoice' or not vendor_bill_amount"/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="is_old_gold" widget="boolean_toggle" readonly="1" invisible="move_type == 'entry'"/>
                <field name="is_diamond_og" widget="boolean_toggle" readonly="1" invisible="move_type == 'entry'"/>
            </xpath>
            <xpath expr="//button[@name='action_register_payment']" position="attributes">
                <attribute name="invisible">state != 'posted' or payment_state not in ('not_paid', 'partial') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or is_old_gold_bill or (unfix and move_type == 'in_invoice')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or (move_type == 'in_invoice' and not is_approved)</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="unfix" invisible="1"/>
                <field name="amount_total" invisible="1"/>
                <field name="is_approved" invisible="1"/>
                <field name="show_approve_bill" invisible="1"/>
                <button name="action_approve_bill" string="Approve Bill" type="object" class="btn-success"
                        invisible="not show_approve_bill"
                        groups="em_jewellery_management.group_jewellery_manager,em_jewellery_management.group_jewellery_billing_staff"/>
                <button name="action_open_customer_payment_wizard"
                        string="Create Customer Payment"
                        type="object"
                        class="btn-danger"
                        invisible="state != 'posted' or move_type != 'out_invoice' or custom_total &gt;= 0 or is_paid"/>
            </xpath>
             <xpath expr="//field[@name='narration']" position="before">
                <group>
                    <field name="custom_total" class="oe_inline"/>
                    <field name="is_paid" class="oe_inline"/>
                    <field name="payment_to_id" class="oe_inline"/>
                </group>
            </xpath>

        </field>
    </record>
</odoo>