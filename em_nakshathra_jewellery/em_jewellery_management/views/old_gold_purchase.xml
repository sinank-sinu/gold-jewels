<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_old_gold_purchase_tree" model="ir.ui.view">
        <field name="name">old.gold.purchase.tree</field>
        <field name="model">old.gold.purchase</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id" optional="hide"/>
                <field name="date"/>
                <field name="total_gross_weight"/>
                <field name="total_amount"/>
                <field name="purchase_per_rate"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_old_gold_purchase_form" model="ir.ui.view">
        <field name="name">old.gold.purchase.form</field>
        <field name="model">old.gold.purchase</field>
        <field name="arch" type="xml">
            <form string="Old Gold Purchase">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Verified"
                            class="btn-primary"
                            invisible="state != 'ho_transfer'"/>
                    <button name="action_transfer_to_ho"
                            type="object"
                            string="HO Transfer"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_transfer_add_less"
                            type="object"
                            string="Transfer Add/Less"
                            class="btn-primary"
                            invisible="add_less ==0 or add_less_transferred "/>
                    <button name="action_open_smith_transfer_wizard"
                            type="object"
                            string="Transfer to Smith"
                            class="btn-primary"
                            invisible="state not in ['done', 'ho_verified'] or not is_smith_transfer or smith_transferred"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet style="max-width: 2320px;">
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_old_gold_transfers"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-truck"
                            string="Transfers"/>
<!--                        <button-->
<!--                            name="action_view_ho_verified"-->
<!--                            type="object"-->
<!--                            class="oe_stat_button"-->
<!--                            icon="fa-truck"-->
<!--                            string="HO Verified"/>-->
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="sale_id"/>
                            <field name="purchase_order_id"/>
                            <field name="branch_location_id" string="Source Location"/>
                            <field name="ho_location_id" string="HO Location"/>
                            <field name="branch_id" />
                            <field name="company_id" />
                            <field name="is_smith_transfer" widget="boolean_toggle" readonly="smith_transferred"/>
                            <field name="smith_transferred" invisible="1"/>


                        </group>
                        <group>
                            <field name="total_gross_weight" readonly="1"/>
                            <field name="total_net_weight" readonly="1"/>
                            <field name="total_verified_net_weight" readonly="1"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="purchase_per_rate" readonly="1"/>
                            <field name="add_less" readonly="1"/>
                            <field name="add_less_location_id"/>
                            <field name="add_less_transferred" invisible="1"/>


                        </group>
                    </group>

                    <notebook>
                        <page string="Old Gold Details">
                            <field name="old_gold_line_ids">
                                <tree editable="bottom">
                                    <field name="purity_id"/>
                                    <field name="verified_purity_id"/>

                                    <field name="gross_weight" sum="Total"/>
                                    <field name="verified_gross_weight" sum="Total"/>

                                    <field name="stone_weight" />
                                    <field name="verified_stone_weight"/>

                                    <field name="net_weight" readonly="1" sum="Total"/>
                                    <field name="verified_net_weight" sum="Total"/>

                                    <field name="fine" readonly="1" sum="Total"/>
                                    <field name="fine_verified" sum="Total"/>

                                    <field name="transferred_weight" sum="Total" readonly="1" column_invisible="parent.state not in ['done', 'ho_verified'] or not parent.is_smith_transfer"/>
                                    <field name="diamond_amount" sum="Total"/>
                                    <field name="rate"/>
                                    <field name="amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Stock Traceability">
                            <field name="old_gold_line_ids">
                                <tree>
                                    <field name="stock_move_id"/>
                                    <field name="ho_transfer_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_old_gold_purchase_search" model="ir.ui.view">
        <field name="name">old.gold.purchase.search</field>
        <field name="model">old.gold.purchase</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <filter string="Exclude Batched" name="exclude_batched" domain="[('state', '!=', 'batched')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Sale Old Gold Line Views (Line-level list and form for Old Gold Purchase) -->
    <record id="view_sale_old_gold_line_tree" model="ir.ui.view">
        <field name="name">sale.old.gold.line.tree</field>
        <field name="model">sale.old.gold.line</field>
        <field name="arch" type="xml">
            <tree create="false" action="action_view_old_gold_purchase" type="object">
                <field name="old_gold_purchase_id" string="Old Gold Purchase"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="branch_id"/>
                <field name="company_id" optional="hide"/>
                <field name="purity_id"/>
                <field name="verified_purity_id"/>
                <field name="gross_weight" sum="Total"/>
                <field name="verified_gross_weight" sum="Total"/>
                <field name="stone_weight" sum="Total"/>
                <field name="verified_stone_weight" sum="Total"/>
                <field name="net_weight" sum="Total"/>
                <field name="verified_net_weight" sum="Total"/>
                <field name="fine" sum="Total" optional="hide"/>
                <field name="fine_verified" sum="Total" optional="hide"/>
                <field name="diamond_amount" sum="Total"/>
                <field name="rate"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'ho_transfer'"
                       decoration-success="state == 'done'"
                       decoration-primary="state == 'batched'"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_old_gold_line_form" model="ir.ui.view">
        <field name="name">sale.old.gold.line.form</field>
        <field name="model">sale.old.gold.line</field>
        <field name="arch" type="xml">
            <form string="Old Gold Purchase Line" create="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ho_transfer,done,batched"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_old_gold_purchase"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Old Gold Purchase"
                                invisible="not old_gold_purchase_id"/>
                    </div>
                    <group>
                        <group string="Purchase Information">
                            <field name="old_gold_purchase_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="batch_id" readonly="1" invisible="not batch_id"/>
                        </group>
                        <group string="Purity &amp; Valuation">
                            <field name="purity_id" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="verified_purity_id" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="rate" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="diamond_amount" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="amount" readonly="1"/>
                            <field name="is_diamond_og" readonly="state not in ('draft', 'ho_transfer')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Branch Weights">
                            <field name="gross_weight" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="stone_weight" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="net_weight" readonly="1"/>
                            <field name="fine" readonly="1"/>
                        </group>
                        <group string="Verified Weights">
                            <field name="verified_gross_weight" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="verified_stone_weight" readonly="state not in ('draft', 'ho_transfer')"/>
                            <field name="verified_net_weight" readonly="1"/>
                            <field name="fine_verified" readonly="1"/>
                            <field name="transferred_weight" readonly="1"/>
                            <field name="remaining_weight" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_old_gold_line_search" model="ir.ui.view">
        <field name="name">sale.old.gold.line.search</field>
        <field name="model">sale.old.gold.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="old_gold_purchase_id" string="Purchase"/>
                <field name="partner_id"/>
                <field name="purity_id"/>
                <field name="verified_purity_id"/>
                <field name="branch_id"/>
                <field name="company_id"/>

                <filter string="Exclude Batched" name="exclude_batched" domain="[('state', '!=', 'batched')]"/>
                <separator/>
                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="HO Transfer" name="state_ho_transfer" domain="[('state', '=', 'ho_transfer')]"/>
                <filter string="Verified" name="state_done" domain="[('state', '=', 'done')]"/>
                <filter string="Batched" name="state_batched" domain="[('state', '=', 'batched')]"/>
                <separator/>
                <filter string="Diamond OG" name="diamond_og" domain="[('is_diamond_og', '=', True)]"/>

                <group expand="0" string="Group By">
                    <filter string="Purity" name="group_by_purity" context="{'group_by': 'purity_id'}"/>
                    <filter string="Verified Purity" name="group_by_verified_purity" context="{'group_by': 'verified_purity_id'}"/>
                    <filter string="Old Gold Purchase" name="group_by_purchase" context="{'group_by': 'old_gold_purchase_id'}"/>
                    <filter string="Branch" name="group_by_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Old Gold Purchase Action pointing to Lines -->
    <record id="action_old_gold_purchase" model="ir.actions.act_window">
        <field name="name">Old Gold Purchase</field>
        <field name="res_model">sale.old.gold.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('old_gold_purchase_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_sale_old_gold_line_search"/>
        <field name="context">{'search_default_exclude_batched': 1}</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_old_gold')), (4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Old Gold Purchase Lines found
            </p>
        </field>
    </record>

    <record id="action_old_gold_purchase_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_sale_old_gold_line_tree"/>
        <field name="act_window_id" ref="action_old_gold_purchase"/>
    </record>

    <record id="action_old_gold_purchase_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_old_gold_line_form"/>
        <field name="act_window_id" ref="action_old_gold_purchase"/>
    </record>

    <!-- Parent Old Gold Purchase Action (Preserved for direct document access) -->
    <record id="action_old_gold_purchase_parent" model="ir.actions.act_window">
        <field name="name">Old Gold Purchases</field>
        <field name="res_model">old.gold.purchase</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_exclude_batched': 1}</field>
        <field name="groups_id" eval="[(4, ref('em_jewellery_management.group_jewellery_old_gold')), (4, ref('em_jewellery_management.group_jewellery_manager')), (4, ref('base.group_system'))]"/>
    </record>

    <!-- Main Jewellery Menu -->

    <menuitem id="menu_old_gold_root"
              name="Old Gold"
              parent="em_jewellery_management.menu_jewellery_root"
              groups="em_jewellery_management.group_jewellery_manager,em_jewellery_management.group_jewellery_billing_staff,em_jewellery_management.group_jewellery_old_gold,base.group_system"
              sequence="20"/>

    <!-- Old Gold Purchase -->
    <menuitem id="menu_old_gold_purchase"
              name="Old Gold Purchase"
              parent="menu_old_gold_root"
              action="action_old_gold_purchase"
              groups="em_jewellery_management.group_jewellery_old_gold,em_jewellery_management.group_jewellery_manager,base.group_system"
              sequence="10"/>
    <menuitem id="menu_old_gold_batch_root"
              name="Batch Creation"
              parent="menu_old_gold_root"
              action="em_jewellery_management.action_old_gold_batch_wizard"
              groups="em_jewellery_management.group_jewellery_old_gold,em_jewellery_management.group_jewellery_manager,base.group_system"
              sequence="20"/>
    <menuitem id="menu_old_gold_batch"
          name="Old Gold Batches"
          parent="menu_old_gold_root"
          action="em_jewellery_management.action_old_gold_batch"
          groups="em_jewellery_management.group_jewellery_old_gold,em_jewellery_management.group_jewellery_manager,base.group_system"
          sequence="30"/>
    <menuitem id="menu_old_gold_internal_transfers"
              name="Internal Transfers"
              parent="menu_old_gold_root"
              action="stock.action_picking_tree_internal"
              groups="em_jewellery_management.group_jewellery_old_gold,em_jewellery_management.group_jewellery_manager,base.group_system"
              sequence="35"/>

    <menuitem id="menu_old_gold_refinery_issue"
              name="Melting"
              parent="menu_old_gold_root"
              action="em_jewellery_management.action_old_gold_refinery_issue"
              groups="em_jewellery_management.group_jewellery_manager,base.group_system"
              sequence="40"/>

    <menuitem id="menu_old_gold_bullion_issue"
          name="Bullion Issue" parent="menu_old_gold_root"
          action="em_jewellery_management.action_old_gold_bullion_issue"
          groups="em_jewellery_management.group_jewellery_manager,base.group_system"
          sequence="50"/>
    <menuitem id="menu_old_gold_bullion_receipt"
          name="Bullion Receipts" parent="menu_old_gold_root"
          action="em_jewellery_management.action_old_gold_bullion_receipt"
          groups="em_jewellery_management.group_jewellery_manager,base.group_system"
          sequence="60"/>
</odoo>