<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit_jewellery_backorder" model="ir.ui.view">
        <field name="name">res.users.form.inherit.jewellery.backorder</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Jewellery Management Permissions">
                    <field name="allow_backorder_creation" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
