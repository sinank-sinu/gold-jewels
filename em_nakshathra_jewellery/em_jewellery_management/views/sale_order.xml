<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_line_label" model="ir.ui.view">
        <field name="name">sale.order.line.label</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_invoice_and_pay"
                        type="object"
                        string="Create Invoice &amp; Pay"
                        class="btn-primary"
                        invisible="1"/>
                <button name="action_advance_payment"
                        type="object"
                        string="Advance Payment"
                        class="btn-primary"
                        invisible="state != 'draft' or advance_payment_count != 0"/>
                <button name="action_edit_main_order"
                        type="object"
                        string="Edit Order"
                        class="btn-secondary"
                        groups="base.group_system"
                        invisible="state not in ('sale', 'done') or is_editing_main_so == True"/>
                <button name="action_save_main_order"
                        type="object"
                        string="Save Order"
                        class="btn-primary"
                        groups="base.group_system"
                        invisible="is_editing_main_so == False"/>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <field name="is_editing_main_so" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'default_phone': phone, 'default_mobile': phone}</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="phone" widget="phone"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Gross Weight</attribute>
                <attribute name="digits">[16, 3]</attribute>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="replace">
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom'][2]" position="replace">
            </xpath>

            <xpath expr="//sheet" position="attributes">
                <attribute name="style">max-width: 2320px;</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="before">
                <field name="label_id" domain="[('active', '=', True), ('product_id', '=?', product_id)]" options="{'no_create': True, 'no_create_edit': True, 'no_open': True, 'no_quick_create': True}" />
                <field name="purity_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True, 'no_quick_create': True}"/>
                <field name="product_uom" string="UOM" optional="show"/>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="after">
                <field name="sale_stone_weight" optional="hide"/>
                <field name="sale_stone_weight_ct" optional="hide"/>
                <field name="sale_diamond_weight_gm" optional="hide"/>
                <field name="sale_diamond_weight_ct" optional="hide"/>
                <field name="net_weight" optional="hide"/>
                <field name="gold_rate"/>
                <field name="mc_percent" optional="hide"/>
                <field name="sale_making_charge_min" column_invisible="1"/>
                <field name="sale_making_charge_fixed_amount_min" column_invisible="1"/>
                <field name="mc_amount" optional="hide" readonly="0" force_save="1"/>
                <field name="metal_amount" />
                <field name="sale_stone_rate" optional="hide"/>
                <field name="sale_diamond_rate" optional="hide"/>
                <field name="other_weight_g" optional="hide"/>
                <field name="other_weight_amount" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="before">
                    <field name="fine_weight" optional="hide"/>
                    <field name="price_subtotal_actual" optional="hide"/>
                    <field name="price_subtotal"/>
                    <field name="mc_discount" optional="hide"/>
                    <field name="mc_amount_actual" readonly="0" force_save="1"/>
                    <field name="mc_percent_actual"/>
                    <field name="tag_weight" column_invisible="1"/>


            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="replace">
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="attributes">
                <attribute name="string">Product</attribute>
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="after">
                <field name="product_id" string="Variety" options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
<!--                <attribute name="optional">hide</attribute>-->
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
             <xpath expr="//field[@name='order_line']/tree//field[@name='qty_delivered']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='qty_invoiced']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <group>
                    <field name="has_old_gold" widget="boolean_toggle"/>
                    <field name="is_sale_return" widget="boolean_toggle"/>
                </group>
                 <group>
                    <field name="has_diamond_og" invisible="1"/>
                    <field name="has_regular_og" invisible="1"/>
                    <field name="branch_location_id" string="Old Gold Location" readonly="old_gold_bill_id != False" required="has_old_gold" invisible="not has_old_gold or (has_diamond_og and not has_regular_og)"/>
                    <field name="diamond_og_location_id" string="Diamond OG Location" readonly="1" invisible="not has_diamond_og"/>
                    <field name="sale_return_branch_location_id" readonly="sale_return_bill_id != False" required="is_sale_return"/>
                </group>
<!--                <group>-->
                     <button name="action_apply_old_gold"
                            type="object"
                            string="Apply Old Gold"
                            style="width: 600px;"
                            invisible="has_old_gold == False or old_gold_bill_id != False"/>
                     <button name="action_edit_old_gold"
                            type="object"
                            string="Edit Old Gold"
                            class="btn-secondary"
                            groups="base.group_system"
                            invisible="old_gold_bill_id == False or is_editing_old_gold == True"/>
                     <button name="action_save_old_gold"
                            type="object"
                            string="Save Old Gold"
                            class="btn-primary"
                            groups="base.group_system"
                            invisible="is_editing_old_gold == False"/>
                     <button name="action_apply_sale_return"
                            type="object"
                            string="Apply Sale Return"
                            style="width: 600px;"
                            invisible="is_sale_return == False or sale_return_bill_id != False"/>
                     <button name="action_edit_sale_return"
                            type="object"
                            string="Edit Sale Return"
                            class="btn-secondary"
                            groups="base.group_system"
                            invisible="sale_return_bill_id == False or is_editing_sale_return == True"/>
                     <button name="action_save_sale_return"
                            type="object"
                            string="Save Sale Return"
                            class="btn-primary"
                            groups="base.group_system"
                            invisible="is_editing_sale_return == False"/>
<!--                    </group>-->

                            <div class="clearfix"/>

                <!--                <group invisible="has_old_gold == False">-->
                <field name="old_gold_line_ids" no_label="1" invisible="has_old_gold == False"
                       readonly="old_gold_bill_id != False and not is_editing_old_gold">
                    <tree editable="bottom">
                        <field name="purity_id"/>
                        <field name="is_diamond_og" string="Diamond OG" optional="show" widget="boolean_toggle"/>
                        <field name="location_id" string="Location" readonly="1" options="{'no_open': True}"/>
                        <field name="gross_weight"/>
                        <field name="stone_weight"/>
                        <field name="net_weight" readonly="1"/>
                        <field name="rate"/>
                        <field name="diamond_amount"/>
                        <field name="round_off" string="Round Off"/>
                        <field name="amount" readonly="1"/>
                    </tree>
                </field>
                <field name="sale_return_line_ids" no_label="1" invisible="is_sale_return == False"
                       readonly="sale_return_bill_id != False and not is_editing_sale_return">
                    <tree editable="bottom">
                        <field name="product_template_id" string="Product"
                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                        <field name="product_id" string="Variety"
                               domain="[('product_tmpl_id', '=', product_template_id)] if product_template_id else []"
                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                        <field name="name" string="Description" optional="hide"/>
                        <field name="purity_id"
                               options="{'no_open': True, 'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"
                               string="Purity"/>
                        <field name="product_uom" string="UOM" optional="show"/>
                        <field name="gross_weight" string="Gross Weight"/>
                        <field name="sale_stone_weight" string="Stone Weight (g)" optional="hide"/>
                        <field name="sale_stone_weight_ct" string="Stone Weight (ct)" optional="hide"/>
                        <field name="sale_diamond_weight_gm" string="Diamond Weight (g)" optional="show"/>
                        <field name="sale_diamond_weight_ct" string="Diamond Weight (ct)" optional="show"/>
                        <field name="net_weight" string="Net Weight (g)" optional="hide"/>
                        <field name="rate" string="Gold Rate(g)"/>
                        <field name="mc_percent" string="Max mc" optional="hide"/>
                        <field name="mc_amount" string="MC Amt" optional="hide"/>
                        <field name="metal_amount" string="Metal Amt" readonly="1"/>
                        <field name="sale_stone_rate" string="Stone Amt" optional="hide"/>
                        <field name="sale_diamond_rate" string="Diamond Amt" optional="hide"/>
                        <field name="other_weight_g" string="Other Weight (g)" optional="hide"/>
                        <field name="other_weight_amount" string="Other Weight Amount" optional="hide"/>
                        <field name="fine_weight" string="Fine Weight (g)"/>
                        <field name="price_subtotal_actual" string="MRP" optional="hide"/>
                        <field name="mc_discount" string="Discount" optional="hide"/>
                        <field name="mc_amount_actual" string="MC"/>
                        <field name="mc_percent_actual" string="MC%"/>
                        <field name="round_off" string="Round Off"/>
                        <field name="amount" string="Subtotal" readonly="1"/>
                    </tree>
                </field>
                <!--                </group>-->
            </xpath>
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="purchase_order_id"/>
                <field name="old_gold_bill_id"/>
                <field name="old_gold_bill_amount"/>
                <field name="old_gold_entry_id" invisible="old_gold_entry_id == False"/>
                <field name="sale_return_po_id" invisible="is_sale_return == False"/>
                <field name="sale_return_bill_id" invisible="is_sale_return == False"/>
                <field name="sale_return_bill_amount" invisible="is_sale_return == False"/>
                <field name="sale_return_entry_id" invisible="sale_return_entry_id == False"/>
                <field name="unfix" widget="boolean_toggle"/>
                <field name="is_editing_old_gold" invisible="1"/>
                <field name="is_editing_sale_return" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
               <button name="action_open_old_gold_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="old_gold_bill_id==False">
<!--                    <field name="old_gold_bill_amount" widget="monetary"/>-->
                    <span class="o_stat_text">Customer Bill</span>
                </button>
               <button name="action_open_sale_return_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="sale_return_bill_id==False">
                    <span class="o_stat_text">Return Bill</span>
                </button>
                <button name="action_view_advance_payments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="advance_payment_count == 0">
                    <field name="advance_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <field name="scheme_line_id" invisible="1"/>
                <field name="is_scheme_redeemed" invisible="1"/>
                <group>
                    <field name="apply_scheme" widget="boolean_toggle" readonly="is_scheme_redeemed"/>
                    <field name="customer_schemes" widget="many2many_tags" invisible="not apply_scheme" readonly="is_scheme_redeemed" domain="[('state', 'in', ('running', 'completed')), ('phone', '!=', False), '|', ('phone', '=', phone), ('phone', '=', other_person_phone)]"/>
                    <field name="other_person_phone" string="Other Person Phone" invisible="not apply_scheme" readonly="is_scheme_redeemed" placeholder="Enter phone to add other person's scheme"/>
                    <field name="scheme_amount" string="Customer Paid" readonly="1" invisible="not apply_scheme"/>
                    <field name="active_scheme_id" invisible="1"/>
<!--                    <button-->
<!--                        name="action_apply_scheme"-->
<!--                        string="Apply Scheme"-->
<!--                        type="object"-->
<!--                        class="btn-primary"-->
<!--                        invisible="not apply_scheme or state not in ('draft', 'sent', 'sale') or scheme_line_id != False"/>-->
                    <button
                        name="action_remove_scheme"
                        string="Remove Scheme"
                        type="object"
                        class="btn-secondary"
                        invisible="not apply_scheme or scheme_line_id == False or state not in ('draft', 'sent', 'sale')"/>
                </group>
            </xpath>
            <xpath expr="//form/div[contains(@class,'oe_chatter')]" position="replace"/>
            <xpath expr="//sheet" position="inside">
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'always'}"/>
                    </div>
            </xpath>
        </field>
    </record>

</odoo>