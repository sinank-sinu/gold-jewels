<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_line_label" model="ir.ui.view">
        <field name="name">sale.order.line.label</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
             <xpath expr="//header" position="inside">
                <button name="action_create_invoice_and_pay"
                        type="object"
                        string="Create Invoice &amp; Pay"
                        class="btn-primary"
                        invisible="invoice_status == 'invoiced'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="attributes">
                <attribute name="string">Gross Weight</attribute>
                <attribute name="digits">[16, 3]</attribute>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="replace">
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom'][2]" position="replace">
            </xpath>

            <xpath expr="//sheet" position="attributes">
                <attribute name="style">max-width: 2320px;</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="before">
                <field name="label_id" domain="[('product_id', '=', product_id),('active', '=', True)]" />
                <field name="purity_id"/>
                <field name="product_uom" string="UOM" optional="show"/>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="after">
                <field name="sale_stone_weight" optional="hide"/>
                <field name="sale_diamond_weight_gm" optional="hide"/>
                <field name="net_weight" optional="hide"/>
                <field name="gold_rate"/>
                <field name="mc_percent" optional="hide"/>
                <field name="sale_making_charge_min" column_invisible="1"/>
                <field name="mc_amount" optional="hide"/>
                <field name="metal_amount" />
                <field name="sale_stone_rate" optional="hide"/>
                <field name="sale_diamond_rate" optional="hide"/>

            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="before">
                    <field name="fine_weight" optinal="hide"/>
                    <field name="price_subtotal_actual" optional="hide"/>
                    <field name="price_subtotal"/>
                    <field name="mc_discount" optional="hide"/>
                    <field name="mc_amount_actual"/>
                    <field name="mc_percent_actual"/>
                    <field name="tag_weight" column_invisible="1"/>


            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="replace">
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="attributes">
                <attribute name="string">Product</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_template_id']" position="after">
                <field name="product_id" string="Variety"/>
<!--                <attribute name="optional">hide</attribute>-->
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
             <xpath expr="//field[@name='order_line']/tree//field[@name='qty_delivered']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='qty_invoiced']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <group>
                    <field name="has_old_gold" widget="boolean_toggle"/>
                </group>
                 <group>
                    <field name="branch_location_id" readonly="old_gold_bill_id != False" required="has_old_gold"/>
                </group>
<!--                <group>-->
                     <button name="action_apply_old_gold"
                            type="object"
                            string="Apply Old Gold"
                            style="width: 600px;"
                            invisible="has_old_gold == False or old_gold_bill_id != False"/>
<!--                    </group>-->

                            <div class="clearfix"/>

<!--                <group invisible="has_old_gold == False">-->
                    <field name="old_gold_line_ids" no_label="1" invisible="has_old_gold == False" readonly="old_gold_bill_id != False">
                        <tree editable="bottom" >
                            <field name="purity_id"/>
                            <field name="gross_weight"/>
                            <field name="stone_weight"/>
                            <field name="net_weight" readonly="1"/>
                            <field name="rate"/>
                            <field name="amount" readonly="1"/>
                        </tree>
                    </field>
<!--                </group>-->
            </xpath>
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="purchase_order_id"/>
                <field name="old_gold_bill_id"/>
                <field name="old_gold_bill_amount"/>
                <field name="unfix" widget="boolean_toggle"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
               <button name="action_open_old_gold_bill"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        invisible="old_gold_bill_id==False">
<!--                    <field name="old_gold_bill_amount" widget="monetary"/>-->
                    <span class="o_stat_text">Customer Bill</span>
                </button>

            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <group>
                    <field name="apply_scheme" readonly="state !='draft'" widget="boolean_toggle"/>
                    <button
                        name="action_apply_scheme"
                        string="Apply Scheme"
                        type="object"
                        class="btn-primary"
                        invisible="not apply_scheme or state not in ('draft', 'sent')"/>

                    <button
                        name="action_remove_scheme"
                        string="Remove Scheme"
                        type="object"
                        class="btn-secondary"
                        invisible="not apply_scheme or state not in ('draft', 'sent')"/>
                </group>
            </xpath>
            <xpath expr="//form/div[contains(@class,'oe_chatter')]" position="replace"/>
            <xpath expr="//sheet" position="inside">
                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'always'}"/>
                    </div>
            </xpath>
        </field>
    </record>

</odoo>