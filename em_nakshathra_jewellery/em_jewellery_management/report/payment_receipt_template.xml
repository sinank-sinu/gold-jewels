<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat assignment for Payment Receipt to match Jewellery Invoice alignment on pre-printed stationery -->
    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="paperformat_id" ref="em_jewellery_management.paperformat_jewellery_invoice"/>
    </record>

    <!-- Grouping Template Override: Groups multiple selected payments per Sales Order / Partner into a single consolidated receipt -->
    <template id="report_payment_receipt_inherit_grouping" inherit_id="account.report_payment_receipt">
        <xpath expr="//t[@t-foreach='docs']" position="replace">
            <t t-set="groups_to_render" t-value="payment_groups if payment_groups else [{'main_payment': o, 'payments': o, 'total_amount': o.amount, 'sale_id': o.sale_id, 'partner_id': o.partner_id, 'disp_pay_method': False, 'disp_payment_ref': False, 'date': o.date, 'is_consolidated': False} for o in docs]"/>
            <t t-foreach="groups_to_render" t-as="group">
                <t t-set="o" t-value="group['main_payment']"/>
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="account.report_payment_receipt_document" t-lang="lang"/>
            </t>
        </xpath>
    </template>

    <template id="report_payment_receipt_document_inherit_sale" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page jewellery-receipt">
                <style>
                    .jewellery-receipt {
                        font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        color: #333333;
                    }
                    .article { padding-top: 0 !important; margin-top: 0 !important; }
                    .page { padding-top: 0 !important; margin-top: 0 !important; }
                    
                    .jewellery-info-box {
                        background-color: #fcfcfc;
                        border: 1px solid #e0e0e0;
                        border-radius: 6px;
                        padding: 10px 14px;
                        margin-bottom: 12px;
                        font-size: 0.9em;
                        line-height: 1.6;
                    }
                    .jewellery-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 8px;
                        font-size: 0.85em;
                    }
                    .jewellery-table th {
                        background-color: #f8f9fa !important;
                        color: #000000 !important;
                        padding: 6px 8px;
                        text-align: center;
                        border: 1px solid #000000 !important;
                        font-weight: bold !important;
                        font-size: 0.9em;
                        vertical-align: middle;
                        text-transform: uppercase;
                    }
                    .jewellery-table td {
                        padding: 6px 8px;
                        border: 1px solid #e0e0e0;
                        text-align: right;
                        vertical-align: middle;
                    }
                    .jewellery-table td.text-left {
                        text-align: left;
                    }
                    .jewellery-table tr:nth-child(even) {
                        background-color: #fdfdfd;
                    }
                </style>

                <!-- Centered Title with Gold Accent Underline -->
                <div style="text-align: center; width: 100%; margin-top: 0; margin-bottom: 20px;">
                    <h3 style="text-align: center; text-transform: uppercase; font-weight: bold; letter-spacing: 2px; color: #2C3E50; margin: 0; padding-bottom: 5px; border-bottom: 2px solid #DAA520; display: inline-block;">
                        Payment Receipt
                    </h3>
                </div>

                <!-- Resolve dynamic Payment Method strictly as Bank, Cash, UPI, or Card for single payment fallback -->
                <t t-set="disp_pay_method" t-value="'Bank'"/>
                <t t-if="o.journal_id">
                    <t t-if="o.journal_id.type == 'cash' or 'cash' in (o.journal_id.name or '').lower()">
                        <t t-set="disp_pay_method" t-value="'Cash'"/>
                    </t>
                    <t t-elif="'pinelabs_transaction_id' in o and o.pinelabs_transaction_id">
                        <t t-if="(o.pinelabs_transaction_id.card_type or '').upper() == 'UPI' or (o.pinelabs_transaction_id.payment_mode or '').upper() == 'UPI'">
                            <t t-set="disp_pay_method" t-value="'UPI'"/>
                        </t>
                        <t t-else="">
                            <t t-set="disp_pay_method" t-value="'Card'"/>
                        </t>
                    </t>
                    <t t-elif="'upi' in (o.journal_id.name or '').lower() or ('ref' in o and o.ref and ('upi' in o.ref.lower() or 'gpay' in o.ref.lower() or 'phonepe' in o.ref.lower() or 'paytm' in o.ref.lower()))">
                        <t t-set="disp_pay_method" t-value="'UPI'"/>
                    </t>
                    <t t-elif="'card' in (o.journal_id.name or '').lower() or 'pine' in (o.journal_id.name or '').lower() or ('ref' in o and o.ref and ('card' in o.ref.lower() or 'pos' in o.ref.lower() or 'pine' in o.ref.lower()))">
                        <t t-set="disp_pay_method" t-value="'Card'"/>
                    </t>
                    <t t-else="">
                        <t t-set="disp_pay_method" t-value="'Bank'"/>
                    </t>
                </t>

                <!-- Metadata 2-Column Section Matching Invoice Alignment -->
                <table style="width: 100%; border: none; margin-bottom: 12px; border-collapse: collapse;">
                    <tr style="border: none;">
                        <td style="width: 55%; vertical-align: top; border: none; padding: 0 10px 0 0;">
                            <div class="jewellery-info-box">
                                <div><strong>Customer: </strong> <span t-field="o.partner_id"/></div>
                                <t t-if="o.partner_id.street or o.partner_id.street2 or o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">
                                    <div style="color: #555555; font-size: 0.95em; line-height: 1.3;">
                                        <span t-if="o.partner_id.street"><span t-esc="o.partner_id.street"/>, </span>
                                        <span t-if="o.partner_id.street2"><span t-esc="o.partner_id.street2"/>, </span>
                                        <span t-if="o.partner_id.city" t-esc="o.partner_id.city"/>
                                        <span t-if="o.partner_id.city and (o.partner_id.state_id or o.partner_id.zip)">, </span>
                                        <span t-if="o.partner_id.state_id" t-esc="o.partner_id.state_id.name"/>
                                        <span t-if="o.partner_id.zip"> - <span t-esc="o.partner_id.zip"/></span>
                                    </div>
                                </t>
                                <t t-if="o.partner_id.mobile or o.partner_id.phone or (o.sale_id and 'phone' in o.sale_id and o.sale_id.phone)">
                                    <div style="color: #555555;">
                                        <strong>Phone: </strong><span t-esc="o.partner_id.mobile or o.partner_id.phone or (o.sale_id.phone if (o.sale_id and 'phone' in o.sale_id) else '')"/>
                                    </div>
                                </t>
                                <t t-set="receipt_date" t-value="group.get('date') if (group and group.get('date')) else o.date"/>
                                <div><strong>Date: </strong> <span t-esc="receipt_date.strftime('%d/%m/%Y') if receipt_date else ''"/></div>
                                <t t-if="o.sale_id">
                                    <div><strong>Sales Order: </strong> <span t-field="o.sale_id.name"/></div>
                                    <t t-if="o.sale_id.user_id">
                                        <div><strong>Sales Person: </strong> <span t-field="o.sale_id.user_id.name"/></div>
                                    </t>
                                    <t t-elif="o.create_uid">
                                        <div><strong>Sales Person: </strong> <span t-field="o.create_uid.name"/></div>
                                    </t>
                                </t>
                            </div>
                        </td>
                        <td style="width: 45%; vertical-align: top; border: none; padding: 0;">
                            <div class="jewellery-info-box">
                                <div>
                                    <strong>Payment Method: </strong>
                                    <span t-esc="group['disp_pay_method'] if (group and group.get('disp_pay_method')) else disp_pay_method"/>
                                </div>
                                <div>
                                    <strong>Payment Reference: </strong>
                                    <span t-esc="group['disp_payment_ref'] if (group and group.get('disp_payment_ref')) else (o.bank_reference if ('bank_reference' in o and o.bank_reference) else (o.name or '-'))"/>
                                </div>
                                <div>
                                    <strong>Due Date: </strong>
                                    <t t-if="o.sale_id and (o.sale_id.commitment_date or o.sale_id.expected_date)">
                                        <span t-esc="(o.sale_id.commitment_date or o.sale_id.expected_date).strftime('%d/%m/%Y')"/>
                                    </t>
                                    <t t-else="">
                                        <span>-</span>
                                    </t>
                                </div>
                                <t t-if="o.ref and o.ref != o.name">
                                    <div><strong>Memo: </strong> <span t-field="o.ref"/></div>
                                </t>
                            </div>
                        </td>
                    </tr>
                </table>

                <!-- Highlighted Amount Received Block -->
                <div style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 6px; padding: 12px 18px; margin-bottom: 16px; text-align: center;">
                    <span style="font-size: 1.1em; font-weight: bold; color: #2C3E50;">Amount Received: </span>
                    <t t-if="group and 'total_amount' in group">
                        <span style="font-size: 1.3em; font-weight: bold; color: #27AE60;" t-out="group['total_amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </t>
                    <t t-else="">
                        <span style="font-size: 1.3em; font-weight: bold; color: #27AE60;" t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                    </t>
                </div>

                <!-- Advance Items Table from Sales Order Products -->
                <t t-if="o.sale_id and o.sale_id.order_line">
                    <div style="margin-top: 14px; margin-bottom: 6px;">
                        <h5 style="color: #2C3E50; font-weight: bold; font-size: 1rem; margin-bottom: 6px; text-transform: uppercase;">
                            Advance Items
                        </h5>
                    </div>
                    <table class="jewellery-table">
                        <thead>
                            <tr>
                                <th class="text-left" style="width: 35%;">Product</th>
                                <th style="width: 20%;">Purity</th>
                                <th style="width: 25%;">Gross Weight (g)</th>
                                <th style="width: 20%;">Gold Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="total_gross" t-value="0.0"/>
                            <tr t-foreach="o.sale_id.order_line" t-as="line">
                                <t t-set="total_gross" t-value="total_gross + (line.product_uom_qty or 0.0)"/>
                                <td class="text-left">
                                    <strong style="color: #2C3E50;">
                                        <span t-field="line.product_template_id.name"/>
                                    </strong>
                                </td>
                                <td>
                                    <span t-esc="line.purity_id.name if line.purity_id else '-'"/>
                                </td>
                                <td>
                                    <span t-esc="'%.3f' % line.product_uom_qty"/> g
                                </td>
                                <td>
                                    <t t-if="'gold_rate' in line and line.gold_rate">
                                        <span t-field="line.gold_rate" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/> / g
                                    </t>
                                    <t t-else="">
                                        <span>-</span>
                                    </t>
                                </td>
                            </tr>
                            <tr style="font-weight: bold; background-color: #f8f9fa;">
                                <td class="text-left" colspan="2">Total Gross Weight:</td>
                                <td><span t-esc="'%.3f' % total_gross"/> g</td>
                                <td></td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <!-- Narrations (Terms and conditions from Sales Order) -->
                <t t-if="o.sale_id and o.sale_id.note">
                    <div style="margin-top: 14px; margin-bottom: 10px;">
                        <strong style="color: #2C3E50; font-size: 0.95em;">Narrations:</strong>
                        <div style="border: 1px solid #e0e0e0; border-radius: 4px; padding: 8px 12px; margin-top: 4px; background-color: #fdfdfd; font-size: 0.9em; white-space: pre-wrap; color: #555555;">
                            <span t-field="o.sale_id.note"/>
                        </div>
                    </div>
                </t>

                <!-- Applied Invoices (if reconciled invoices exist) -->
                <t t-set="invoices" t-value="o.reconciled_invoice_ids or o.reconciled_bill_ids"/>
                <t t-if="invoices">
                    <div style="margin-top: 16px; margin-bottom: 6px;">
                        <h5 style="color: #2C3E50; font-weight: bold; font-size: 1rem; margin-bottom: 6px; text-transform: uppercase;">
                            Applied Invoices
                        </h5>
                    </div>
                    <table name="invoices" class="jewellery-table">
                        <t t-foreach="invoices" t-as="inv">
                            <t t-if="any(inv.currency_id != par[2].currency_id for par in inv._get_reconciled_invoices_partials()[0])" t-set="otherCurrency" t-value="True"/>
                        </t>
                        <thead>
                            <tr>
                                <th class="text-left"><span>Invoice Date</span></th>
                                <th><span>Invoice Number</span></th>
                                <th><span>Reference</span></th>
                                <th t-if="otherCurrency"><span>Amount In Currency</span></th>
                                <th><span>Amount</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <t t-if="inv.move_type != 'entry'">
                                    <tr>
                                        <td class="text-left"><span t-esc="inv.invoice_date.strftime('%d/%m/%Y') if inv.invoice_date else ''"/></td>
                                        <td><span t-field="inv.name"/></td>
                                        <td><span t-field="inv.ref"/></td>
                                        <td t-if="otherCurrency"/>
                                        <td><span t-field="inv.amount_total"/></td>
                                    </tr>
                                    <tr t-foreach="inv._get_reconciled_invoices_partials()[0]" t-as="par">
                                        <t t-set="payment" t-value="par[2].move_id"/>
                                        <td class="text-left"><span t-esc="payment.date.strftime('%d/%m/%Y') if payment.date else ''"/></td>
                                        <td><span t-field="payment.name"/></td>
                                        <td><span t-field="payment.ref"/></td>
                                        <t t-set="amountPayment" t-value="-(par[0].debit_amount_currency if par[2].debit > 0 else par[0].credit_amount_currency)"/>
                                        <t t-set="amountInvoice" t-value="-par[1]"/>
                                        <t t-set="currencyPayment" t-value="payment.currency_id"/>
                                        <t t-set="currencyInvoice" t-value="inv.currency_id"/>
                                        <td t-if="otherCurrency"><span t-if="currencyPayment != currencyInvoice" t-out="amountPayment" t-options="{'widget': 'monetary', 'display_currency': currencyPayment}"/></td>
                                        <td><span t-out="amountInvoice" t-options="{'widget': 'monetary', 'display_currency': currencyInvoice}"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </t>

                <!-- Thank You Note -->
                <div style="text-align: center; color: #777777; margin-top: 25px; margin-bottom: 20px; font-size: 0.9em;">
                    <em>Thank you for your business!</em>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
