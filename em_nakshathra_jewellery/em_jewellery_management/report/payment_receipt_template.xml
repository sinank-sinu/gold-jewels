<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_receipt_document_inherit_sale" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <div class="page">
                <div class="text-center mb-5 mt-4">
                    <h2 class="text-uppercase" style="color: #6c757d; font-weight: bold; letter-spacing: 2px;">
                        Payment Receipt
                    </h2>
                    <h5 class="text-muted"><t t-esc="o.name"/></h5>
                </div>

                <div class="row mt-4 mb-4 border-top border-bottom py-3" style="font-size: 1.1em;">
                    <div class="col-6">
                        <strong>Customer: </strong> <span t-field="o.partner_id"/><br/>
                        <strong>Date: </strong> <span t-field="o.date"/><br/>
                        <t t-if="o.sale_id">
                            <strong>Sales Order: </strong> <span t-field="o.sale_id.name"/><br/>
                        </t>
                    </div>
                    <div class="col-6 text-end">
                        <strong>Payment Method: </strong> <span t-field="o.payment_method_id.name"/><br/>
                        <t t-if="o.ref">
                            <strong>Memo: </strong> <span t-field="o.ref"/><br/>
                        </t>
                    </div>
                </div>

                <div class="row mb-5 mt-4 text-center">
                    <div class="col-12">
                        <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #dee2e6;">
                            <h4 style="margin: 0; color: #495057;">
                                <strong>Amount Received: </strong> 
                                <span style="color: #28a745; font-size: 1.2em;" t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </h4>
                        </div>
                    </div>
                </div>

                <!-- Only show invoices if there are actually reconciled invoices/bills -->
                <t t-set="invoices" t-value="o.reconciled_invoice_ids or o.reconciled_bill_ids"/>
                <t t-if="invoices">
                    <h5 class="mt-5 mb-3" style="color: #6c757d;">Applied Invoices</h5>
                    <table name="invoices" class="table table-sm table-striped">
                        <!-- Check if invoices include different currencies -->
                        <t t-foreach="invoices" t-as="inv">
                            <t t-if="any(inv.currency_id != par[2].currency_id for par in inv._get_reconciled_invoices_partials()[0])" t-set="otherCurrency" t-value="True"/>
                        </t>
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th><span>Invoice Date</span></th>
                                <th><span>Invoice Number</span></th>
                                <th><span>Reference</span></th>
                                <th t-if="otherCurrency" class="text-end"><span>Amount In Currency</span></th>
                                <th class="text-end"><span>Amount</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="invoices" t-as="inv">
                                <t t-if="inv.move_type != 'entry'">
                                    <tr>
                                        <td><span t-field="inv.invoice_date"/></td>
                                        <td><span t-field="inv.name"/></td>
                                        <td><span t-field="inv.ref"/></td>
                                        <td t-if="otherCurrency"/>
                                        <td class="text-end"><span t-field="inv.amount_total"/></td>
                                    </tr>
                                    <tr t-foreach="inv._get_reconciled_invoices_partials()[0]" t-as="par">
                                        <t t-set="payment" t-value="par[2].move_id"/>
                                        <td><span t-field="payment.date"/></td>
                                        <td><span t-field="payment.name"/></td>
                                        <td><span t-field="payment.ref"/></td>
                                        <t t-set="amountPayment" t-value="-(par[0].debit_amount_currency if par[2].debit > 0 else par[0].credit_amount_currency)"/>
                                        <t t-set="amountInvoice" t-value="-par[1]"/>
                                        <t t-set="currencyPayment" t-value="payment.currency_id"/>
                                        <t t-set="currencyInvoice" t-value="inv.currency_id"/>
                                        <td t-if="otherCurrency" class="text-end"><span t-if="currencyPayment != currencyInvoice" t-out="amountPayment" t-options="{'widget': 'monetary', 'display_currency': currencyPayment}"/></td>
                                        <td class="text-end"><span t-out="amountInvoice" t-options="{'widget': 'monetary', 'display_currency': currencyInvoice}"/></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </t>

                <div class="row mt-5">
                    <div class="col-12 text-center text-muted">
                        <small>Thank you for your business!</small>
                    </div>
                </div>

            </div>
        </xpath>
    </template>
</odoo>
