<odoo>
    <template id="report_product_label">
        <t t-call="web.basic_layout">
            <div class="page" style="width: 100%; padding: 0; margin: 0;">
                <t t-foreach="docs" t-as="o">
                    
                    <div style="
                        width: 32%;
                        height: 25mm;
                        border: 1px solid #000;
                        padding: 1mm;
                        margin-bottom: 3mm;
                        margin-right: 1%;
                        font-size: 9px;
                        display: inline-block;
                        vertical-align: top;
                        box-sizing: border-box;
                    ">
                        <table style="width: 100%; border-collapse: collapse; table-layout: fixed; height: 100%;">
                            <tr>
                                <td style="width: 49%; vertical-align: top; text-align: center; padding: 0;">
                                    <t t-if="o.barcode">
                                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', o.barcode, 600, 120)"
                                             style="width: 100%; height: 10mm; display: block; margin: 0 auto;"/>
                                    </t>
                                    <div style="font-size: 8px; text-align: left; margin-top: 1mm; line-height: 1.1; font-weight: bold; padding-left: 2px;">
                                        G.Wt: <t t-esc="o.sale_gross_weight or '0.000'"/><br/>
                                        S.Wt: <t t-esc="o.sale_stone_weight or '0.000'"/><br/>
                                        N.Wt: <t t-esc="o.sale_net_weight or '0.000'"/>
                                    </div>
                                </td>

                                <td style="width: 2%;"></td>

                                <td style="width: 49%; vertical-align: top; text-align: center; padding: 0;">
                                    
                                    <div style="font-size: 8px; font-weight: bold; height: 3.5mm; overflow: hidden; white-space: nowrap; text-align: center;">
                                        <t t-esc="o.name"/> / Max MC:<t t-esc="o.sale_making_charge_value"/>
                                    </div>

                                    <t t-if="o.barcode">
                                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('EAN13', o.barcode, 600, 120)"
                                             style="width: 100%; height: 10mm; display: block; margin: 0 auto;"/>
                                    </t>

                                    <div style="font-size: 7.5px; font-weight: bold; line-height: 1.1; margin-top: 1.5mm; height: 7mm; overflow: hidden; text-align: center; text-transform: uppercase;">
                                        <t t-esc="o.product_id.display_name or ''"/> /
                                        <t t-esc="o.product_tmpl_id.name"/>
                                    </div>

                                </td>
                            </tr>
                        </table>
                    </div>

                    <t t-if="o_index % 3 == 2">
                        <div style="clear: both; height: 1px; width: 100%;"></div>
                    </t>

                </t>
            </div>
        </t>
    </template>
</odoo>
