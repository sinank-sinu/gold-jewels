<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Record Rule for Salesman to see only their own Sales Orders -->
        <record id="rule_sale_order_salesman_own" model="ir.rule">
            <field name="name">Jewellery Salesman: Own Orders Only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('em_jewellery_management.group_jewellery_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule for Managers to see ALL Sales Orders -->
        <record id="rule_sale_order_manager_all" model="ir.rule">
            <field name="name">Jewellery Manager: All Orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('em_jewellery_management.group_jewellery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rule for Salesman to see only their own Sales Order Lines -->
        <record id="rule_sale_order_line_salesman_own" model="ir.rule">
            <field name="name">Jewellery Salesman: Own Order Lines Only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">['|', ('order_id.user_id', '=', user.id), ('order_id.user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('em_jewellery_management.group_jewellery_salesman'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule for Managers to see ALL Sales Order Lines -->
        <record id="rule_sale_order_line_manager_all" model="ir.rule">
            <field name="name">Jewellery Manager: All Order Lines</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('em_jewellery_management.group_jewellery_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>