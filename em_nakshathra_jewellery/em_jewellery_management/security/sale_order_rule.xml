            <field name="name">Jewellery Salesman: Own Invoices Only</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">['|', ('move_type', 'not in', ('out_invoice', 'out_refund', 'out_receipt')), ('invoice_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('em_jewellery_management.group_jewellery_salesman'))]"/>
