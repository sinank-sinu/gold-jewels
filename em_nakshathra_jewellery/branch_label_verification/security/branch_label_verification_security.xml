<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Module Category: Branch Label Verification                   -->
    <!-- ============================================================ -->
    <record id="module_category_branch_label_verification" model="ir.module.category">
        <field name="name">Branch Label Verification</field>
        <field name="description">User access levels for Branch Label Verification and Stock Audit</field>
        <field name="sequence">20</field>
    </record>

    <!-- ============================================================ -->
    <!-- User Groups: Billing & Branch Manager                        -->
    <!-- ============================================================ -->
    <record id="group_branch_label_verification_billing" model="res.groups">
        <field name="name">Billing</field>
        <field name="category_id" ref="module_category_branch_label_verification"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_branch_label_verification_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="category_id" ref="module_category_branch_label_verification"/>
        <field name="implied_ids" eval="[(4, ref('group_branch_label_verification_billing'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Multi-Branch Record Rules                                    -->
    <!-- ============================================================ -->
    <data noupdate="0">
        <!-- Branch Label Verification Session Rules -->
        <record id="rule_branch_label_verification_billing" model="ir.rule">
            <field name="name">Branch Label Verification: Billing Branch Access</field>
            <field name="model_id" ref="model_branch_label_verification"/>
            <field name="domain_force">['|', ('branch_id', '=', user.branch_id.id), ('branch_id', 'in', user.branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_billing'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_label_verification_branch_manager" model="ir.rule">
            <field name="name">Branch Label Verification: Branch Manager See All</field>
            <field name="model_id" ref="model_branch_label_verification"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_branch_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Branch Label Verification Line Rules -->
        <record id="rule_branch_label_verification_line_billing" model="ir.rule">
            <field name="name">Branch Label Verification Line: Billing Branch Access</field>
            <field name="model_id" ref="model_branch_label_verification_line"/>
            <field name="domain_force">['|', ('verification_id.branch_id', '=', user.branch_id.id), ('verification_id.branch_id', 'in', user.branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_billing'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_label_verification_line_branch_manager" model="ir.rule">
            <field name="name">Branch Label Verification Line: Branch Manager See All</field>
            <field name="model_id" ref="model_branch_label_verification_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_branch_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Product Template Summary Rules -->
        <record id="rule_branch_label_verification_summary_billing" model="ir.rule">
            <field name="name">Branch Label Verification Summary: Billing Branch Access</field>
            <field name="model_id" ref="model_branch_label_verification_template_summary"/>
            <field name="domain_force">['|', ('verification_id.branch_id', '=', user.branch_id.id), ('verification_id.branch_id', 'in', user.branch_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_billing'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_branch_label_verification_summary_branch_manager" model="ir.rule">
            <field name="name">Branch Label Verification Summary: Branch Manager See All</field>
            <field name="model_id" ref="model_branch_label_verification_template_summary"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_branch_label_verification_branch_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>

</odoo>
