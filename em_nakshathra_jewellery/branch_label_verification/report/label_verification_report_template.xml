<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_verification_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px;">
                        
                        <!-- Header Title -->
                        <div class="text-center mb-4 pb-2 border-bottom">
                            <h2 style="font-weight: bold; color: #1E293B; margin-bottom: 2px;">
                                BRANCH LABEL VERIFICATION &amp; STOCK AUDIT REPORT
                            </h2>
                            <span class="text-muted" style="font-size: 13px;">
                                Branch: <strong t-esc="doc.branch_id.name"/> | Date: <span t-esc="doc.date"/> | Ref: <span t-esc="doc.name"/>
                            </span>
                        </div>

                        <!-- Info Table -->
                        <table class="table table-sm table-bordered mb-4" style="border-collapse: collapse; width: 100%;">
                            <tr style="background-color: #F8FAFC;">
                                <td style="width: 20%; font-weight: bold;">Audit Ref:</td>
                                <td style="width: 30%;"><span t-field="doc.name"/></td>
                                <td style="width: 20%; font-weight: bold;">Auditor / Verifier:</td>
                                <td style="width: 30%;"><span t-field="doc.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Branch:</td>
                                <td><span t-field="doc.branch_id.name"/></td>
                                <td style="font-weight: bold;">Audit Status:</td>
                                <td><strong t-esc="(doc.state or '').upper()"/></td>
                            </tr>
                            <tr style="background-color: #F8FAFC;">
                                <td style="font-weight: bold;">Scope Filter:</td>
                                <td><span t-field="doc.label_filter"/></td>
                                <td style="font-weight: bold;">Completion Rate:</td>
                                <td><strong t-esc="doc.progress_rate"/>%</td>
                            </tr>
                        </table>

                        <!-- KPI Summary Boxes -->
                        <div class="row text-center mb-4" style="margin-left: -5px; margin-right: -5px;">
                            <div class="col" style="padding: 5px;">
                                <div style="border: 1px solid #CBD5E1; border-radius: 6px; padding: 10px; background-color: #F8FAFC;">
                                    <div style="font-size: 10px; color: #64748B; font-weight: bold;">TOTAL EXPECTED</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #0F172A;"><t t-esc="doc.total_expected_count"/></div>
                                    <div style="font-size: 10px; color: #64748B;"><t t-esc="'%.3f g' % doc.total_expected_gross_weight"/></div>
                                </div>
                            </div>
                            <div class="col" style="padding: 5px;">
                                <div style="border: 1px solid #A7F3D0; border-radius: 6px; padding: 10px; background-color: #ECFDF5;">
                                    <div style="font-size: 10px; color: #065F46; font-weight: bold;">VERIFIED</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #059669;"><t t-esc="doc.verified_count"/></div>
                                    <div style="font-size: 10px; color: #065F46;"><t t-esc="'%.3f g' % doc.verified_gross_weight"/></div>
                                </div>
                            </div>
                            <div class="col" style="padding: 5px;">
                                <div style="border: 1px solid #FDE68A; border-radius: 6px; padding: 10px; background-color: #FFFBEB;">
                                    <div style="font-size: 10px; color: #92400E; font-weight: bold;">PENDING</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #D97706;"><t t-esc="doc.pending_count"/></div>
                                    <div style="font-size: 10px; color: #92400E;"><t t-esc="'%.3f g' % doc.pending_gross_weight"/></div>
                                </div>
                            </div>
                            <div class="col" style="padding: 5px;">
                                <div style="border: 1px solid #FECACA; border-radius: 6px; padding: 10px; background-color: #FEF2F2;">
                                    <div style="font-size: 10px; color: #991B1B; font-weight: bold;">MISSING</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #DC2626;"><t t-esc="doc.missing_count"/></div>
                                    <div style="font-size: 10px; color: #991B1B;"><t t-esc="'%.3f g' % doc.missing_gross_weight"/></div>
                                </div>
                            </div>
                            <div class="col" style="padding: 5px;">
                                <div style="border: 1px solid #DDD6FE; border-radius: 6px; padding: 10px; background-color: #F5F3FF;">
                                    <div style="font-size: 10px; color: #5B21B6; font-weight: bold;">EXTRA / FOREIGN</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #7C3AED;"><t t-esc="doc.extra_count"/></div>
                                    <div style="font-size: 10px; color: #5B21B6;"><t t-esc="'%.3f g' % doc.extra_gross_weight"/></div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Template Summary Section -->
                        <t t-if="doc.template_summary_ids">
                            <h5 style="color: #1E293B; font-weight: bold; margin-top: 15px; border-bottom: 2px solid #0284C7; padding-bottom: 4px;">
                                📊 Product Template Summary
                            </h5>
                            <table class="table table-sm table-striped" style="font-size: 10px; width: 100%;">
                                <thead style="background-color: #F1F5F9;">
                                    <tr>
                                        <th>#</th>
                                        <th>Product Template</th>
                                        <th class="text-end">Total Labels</th>
                                        <th class="text-end">Total Weight</th>
                                        <th class="text-end">System Total Wt</th>
                                        <th class="text-end">Counted Labels</th>
                                        <th class="text-end">Counted Weight</th>
                                        <th class="text-end">Counted Total Wt</th>
                                        <th class="text-end">Diff Labels</th>
                                        <th class="text-end">Diff Total Wt</th>
                                        <th class="text-center">Matched</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sl" t-value="1"/>
                                    <t t-foreach="doc.template_summary_ids" t-as="sm">
                                        <tr>
                                            <td><t t-esc="sl"/></td>
                                            <td><strong><t t-esc="sm.product_tmpl_id.display_name"/></strong></td>
                                            <td class="text-end"><t t-esc="'%.0f' % sm.system_qty"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % sm.system_weight"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % sm.system_total_weight"/></td>
                                            <td class="text-end"><t t-esc="'%.0f' % sm.manual_qty"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % sm.manual_weight"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % sm.manual_total_weight"/></td>
                                            <td class="text-end" t-att-style="'color: #059669;' if sm.is_qty_matched else 'color: #DC2626; font-weight: bold;'"><t t-esc="'%.0f' % sm.difference_qty"/></td>
                                            <td class="text-end" t-att-style="'color: #059669;' if sm.is_total_weight_matched else 'color: #DC2626; font-weight: bold;'"><t t-esc="'%.3f' % sm.difference_total_weight"/></td>
                                            <td class="text-center">
                                                <t t-if="sm.is_matched">
                                                    <span style="color: #059669; font-weight: bold;">MATCHED</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color: #DC2626; font-weight: bold;">MISMATCH</span>
                                                </t>
                                            </td>
                                        </tr>
                                        <t t-set="sl" t-value="sl + 1"/>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Missing Labels Section (Critical Audit Finding) -->
                        <t t-set="missing_items" t-value="doc.line_ids.filtered(lambda l: l.status == 'missing')"/>
                        <t t-if="missing_items">
                            <h5 style="color: #DC2626; font-weight: bold; margin-top: 15px; border-bottom: 2px solid #DC2626; padding-bottom: 4px;">
                                ⚠️ Missing Labels Discrepancy (<t t-esc="len(missing_items)"/> items)
                            </h5>
                            <table class="table table-sm table-striped" style="font-size: 10px; width: 100%;">
                                <thead style="background-color: #F1F5F9;">
                                    <tr>
                                        <th>#</th>
                                        <th>Label Ref</th>
                                        <th>Barcode</th>
                                        <th>Product</th>
                                        <th>Location</th>
                                        <th>Purity</th>
                                        <th class="text-end">Gross Wt (g)</th>
                                        <th class="text-end">Net Wt (g)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="missing_items" t-as="m">
                                        <tr>
                                            <td><t t-esc="m_index + 1"/></td>
                                            <td><strong t-esc="m.name"/></td>
                                            <td><t t-esc="m.barcode"/></td>
                                            <td><t t-esc="m.product_id.display_name"/></td>
                                            <td><t t-esc="m.location_id.name"/></td>
                                            <td><t t-esc="m.purity_id.name"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % m.sale_gross_weight"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % m.sale_net_weight"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Extra / Wrong Branch Section -->
                        <t t-set="extra_items" t-value="doc.line_ids.filtered(lambda l: l.status == 'extra')"/>
                        <t t-if="extra_items">
                            <h5 style="color: #7C3AED; font-weight: bold; margin-top: 15px; border-bottom: 2px solid #7C3AED; padding-bottom: 4px;">
                                🚨 Extra / Foreign Branch Labels Found (<t t-esc="len(extra_items)"/> items)
                            </h5>
                            <table class="table table-sm table-striped" style="font-size: 10px; width: 100%;">
                                <thead style="background-color: #F1F5F9;">
                                    <tr>
                                        <th>#</th>
                                        <th>Label Ref</th>
                                        <th>Barcode</th>
                                        <th>Product</th>
                                        <th>Actual Branch</th>
                                        <th>Gross Wt (g)</th>
                                        <th>Remarks / Issue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="extra_items" t-as="e">
                                        <tr>
                                            <td><t t-esc="e_index + 1"/></td>
                                            <td><strong t-esc="e.name"/></td>
                                            <td><t t-esc="e.barcode"/></td>
                                            <td><t t-esc="e.product_id.display_name"/></td>
                                            <td><t t-esc="e.branch_id.name"/></td>
                                            <td><t t-esc="'%.3f' % e.sale_gross_weight"/></td>
                                            <td><t t-esc="e.notes"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Remarks -->
                        <div class="mt-3 p-2 bg-light border rounded" t-if="doc.notes">
                            <strong>Audit Remarks:</strong>
                            <p t-field="doc.notes" class="mb-0"/>
                        </div>

                        <!-- Signatures Box -->
                        <div class="row mt-5 pt-4 text-center">
                            <div class="col-4">
                                <div style="border-top: 1px solid #94A3B8; width: 80%; margin: 0 auto; padding-top: 5px;">
                                    <strong>Auditor Signature</strong><br/>
                                    <span class="text-muted small"><t t-esc="doc.user_id.name"/></span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #94A3B8; width: 80%; margin: 0 auto; padding-top: 5px;">
                                    <strong>Branch Manager</strong><br/>
                                    <span class="text-muted small">Name &amp; Stamp</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div style="border-top: 1px solid #94A3B8; width: 80%; margin: 0 auto; padding-top: 5px;">
                                    <strong>Stock Controller</strong><br/>
                                    <span class="text-muted small">Verification Officer</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <template id="report_missing_labels_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px;">
                        <div class="text-center mb-3 pb-2 border-bottom">
                            <h2 style="font-weight: bold; color: #DC2626; margin-bottom: 2px;">
                                MISSING LABELS REPORT
                            </h2>
                            <span class="text-muted" style="font-size: 12px;">
                                Branch: <strong t-esc="doc.branch_id.name"/> | Date: <span t-esc="doc.date"/> | Ref: <span t-esc="doc.name"/>
                            </span>
                        </div>

                        <table class="table table-sm table-bordered mb-3" style="width: 100%; font-size: 10px;">
                            <tr style="background-color: #F8FAFC;">
                                <td style="width: 18%; font-weight: bold;">Audit Ref:</td>
                                <td style="width: 32%;"><span t-field="doc.name"/></td>
                                <td style="width: 18%; font-weight: bold;">Auditor / Verifier:</td>
                                <td style="width: 32%;"><span t-field="doc.user_id.name"/></td>
                            </tr>
                            <tr>
                                <td style="font-weight: bold;">Branch:</td>
                                <td><span t-field="doc.branch_id.name"/></td>
                                <td style="font-weight: bold;">Audit Status:</td>
                                <td><strong t-esc="(doc.state or '').upper()"/></td>
                            </tr>
                            <tr t-if="doc.location_ids" style="background-color: #F8FAFC;">
                                <td style="font-weight: bold;">Target Locations:</td>
                                <td colspan="3"><span t-esc="', '.join(doc.location_ids.mapped('name'))"/></td>
                            </tr>
                        </table>

                        <t t-set="missing_items" t-value="doc.missing_line_ids"/>
                        <div class="row text-center mb-3" style="margin-left: -5px; margin-right: -5px;">
                            <div class="col-4" style="padding: 4px;">
                                <div style="border: 1px solid #FECACA; border-radius: 6px; padding: 8px; background-color: #FEF2F2;">
                                    <div style="font-size: 10px; color: #991B1B; font-weight: bold;">TOTAL MISSING LABELS</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #DC2626;"><t t-esc="len(missing_items)"/></div>
                                </div>
                            </div>
                            <div class="col-4" style="padding: 4px;">
                                <div style="border: 1px solid #FECACA; border-radius: 6px; padding: 8px; background-color: #FEF2F2;">
                                    <div style="font-size: 10px; color: #991B1B; font-weight: bold;">MISSING GROSS WT (g)</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #DC2626;"><t t-esc="'%.3f' % sum(missing_items.mapped('sale_gross_weight'))"/></div>
                                </div>
                            </div>
                            <div class="col-4" style="padding: 4px;">
                                <div style="border: 1px solid #FECACA; border-radius: 6px; padding: 8px; background-color: #FEF2F2;">
                                    <div style="font-size: 10px; color: #991B1B; font-weight: bold;">MISSING NET WT (g)</div>
                                    <div style="font-size: 16px; font-weight: bold; color: #DC2626;"><t t-esc="'%.3f' % sum(missing_items.mapped('sale_net_weight'))"/></div>
                                </div>
                            </div>
                        </div>

                        <t t-if="missing_items">
                            <table class="table table-sm table-striped table-bordered" style="font-size: 10px; width: 100%;">
                                <thead style="background-color: #FEE2E2; color: #991B1B;">
                                    <tr>
                                        <th style="width: 4%;">#</th>
                                        <th>Label Ref</th>
                                        <th>Barcode</th>
                                        <th>Variant</th>
                                        <th>Purity</th>
                                        <th>Location</th>
                                        <th class="text-end">Gross Wt (g)</th>
                                        <th class="text-end">Net Wt (g)</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="missing_items" t-as="m">
                                        <tr style="page-break-inside: avoid;">
                                            <td><t t-esc="m_index + 1"/></td>
                                            <td><strong t-esc="m.name"/></td>
                                            <td><t t-esc="m.barcode or ''"/></td>
                                            <td><t t-esc="m.product_id.display_name or ''"/></td>
                                            <td><t t-esc="m.purity_id.name or ''"/></td>
                                            <td><t t-esc="m.location_id.name or ''"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % (m.sale_gross_weight or 0.0)"/></td>
                                            <td class="text-end"><t t-esc="'%.3f' % (m.sale_net_weight or 0.0)"/></td>
                                            <td><t t-esc="m.notes or ''"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot style="background-color: #F8FAFC; font-weight: bold;">
                                    <tr>
                                        <td colspan="6" class="text-end">Total (<t t-esc="len(missing_items)"/> labels)</td>
                                        <td class="text-end"><t t-esc="'%.3f' % sum(missing_items.mapped('sale_gross_weight'))"/></td>
                                        <td class="text-end"><t t-esc="'%.3f' % sum(missing_items.mapped('sale_net_weight'))"/></td>
                                        <td/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="alert alert-success text-center mt-3">
                                No missing labels found for this audit.
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
