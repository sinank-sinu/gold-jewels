<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_diamond_rate_master_form" model="ir.ui.view">
        <field name="name">diamond.rate.master.form</field>
        <field name="model">diamond.rate.master</field>
        <field name="arch" type="xml">
            <form string="Diamond Rate">
                <header>
                    <button
                        name="action_set_active_rate"
                        type="object"
                        string="Set Active"
                        class="btn-primary"
                        invisible="active"
                    />
                    <button
                        name="action_log_rate_update"
                        type="object"
                        string="Update"
                        class="btn-primary"
                    />
                    <field name="active" widget="boolean_toggle"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_update_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-history"
                                invisible="log_count == 0">
                            <field name="log_count" widget="statinfo" string="Updates"/>
                        </button>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="rate_type"/>
                        <field name="rate_per_carat"/>
                        <field name="purity_id" readonly="1"/>
                        <field name="board_rate" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_diamond_rate_master_tree" model="ir.ui.view">
        <field name="name">diamond.rate.master.tree</field>
        <field name="model">diamond.rate.master</field>
        <field name="arch" type="xml">
            <tree string="Diamond Rates">
                <field name="date"/>
                <field name="rate_per_carat"/>
                <field name="rate_type"/>
                <field name="purity_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Action Window for Diamond Rate Master -->
    <record id="action_diamond_rate_master" model="ir.actions.act_window">
        <field name="name">Diamond Rates</field>
        <field name="res_model">diamond.rate.master</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up Diamond Rates!
            </p>
        </field>
    </record>

    <!-- Update Log Tree View -->
    <record id="view_diamond_rate_update_log_tree" model="ir.ui.view">
        <field name="name">diamond.rate.update.log.tree</field>
        <field name="model">diamond.rate.update.log</field>
        <field name="arch" type="xml">
            <tree string="Diamond Rate Updates" create="false">
                <field name="rate_datetime"/>
                <field name="rate_per_carat"/>
                <field name="rate_type"/>
                <field name="purity_id"/>
                <field name="user_id"/>
                <field name="master_id"/>
            </tree>
        </field>
    </record>

    <!-- Update Log Form View -->
    <record id="view_diamond_rate_update_log_form" model="ir.ui.view">
        <field name="name">diamond.rate.update.log.form</field>
        <field name="model">diamond.rate.update.log</field>
        <field name="arch" type="xml">
            <form string="Diamond Rate Update" create="false">
                <sheet>
                    <group>
                        <field name="rate_datetime" readonly="1"/>
                        <field name="rate_per_carat" readonly="1"/>
                        <field name="rate_type" readonly="1"/>
                        <field name="purity_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="master_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window for Update Logs -->
    <record id="action_diamond_rate_update_log" model="ir.actions.act_window">
        <field name="name">Diamond Rate Updates</field>
        <field name="res_model">diamond.rate.update.log</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
