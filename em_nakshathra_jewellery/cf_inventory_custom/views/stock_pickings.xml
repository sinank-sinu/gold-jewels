<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_form_inherit_responsible_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.responsible.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Validate button -->
           <xpath expr="//button[@name='button_validate'][1]" position="attributes">
                <attribute name="invisible"> not can_responsible_action or state in ('draft', 'confirmed', 'done', 'cancel')</attribute>

            </xpath>
            <xpath expr="//button[@name='button_validate'][2]" position="attributes">
                <attribute name="invisible"> not can_responsible_action or state in ('waiting', 'assigned', 'done', 'cancel')</attribute>

            </xpath>

            <xpath expr="//button[@name='action_assign']" position="attributes">
                <attribute name="invisible">not can_responsible_action or not show_check_availability</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="can_responsible_action" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="responsible_user_id" readonly="state not in ['draft']"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree//field[@name='product_id']" position="before">
                <field name="label_id" optional="hide"/>
            </xpath>

        </field>
    </record>


</odoo>