<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the Receive Voucher form to inject the barcode scanner widget -->
    <record id="view_receive_voucher_barcode_scanner_inherit" model="ir.ui.view">
        <field name="name">jewellery.receive.voucher.form.barcode.scanner</field>
        <field name="model">jewellery.receive.voucher</field>
        <field name="inherit_id" ref="em_jewellery_management.view_receive_voucher_form"/>
        <field name="arch" type="xml">
            <!--
                Inject the barcode scanner widget just before the Ornaments line field.
                The widget="barcode_scanner" is registered in view_widgets registry.
                The model attribute tells the widget which server method to call.
                Note: Odoo 17 forbids @string as an xpath selector; we target
                the field[@name='line_ids'] directly (unique in this form).
            -->
            <xpath expr="//notebook/page[1]/field[@name='line_ids']" position="before">
                <widget
                    name="barcode_scanner"
                    model="jewellery.receive.voucher"
                    invisible="state == 'done'"
                />
            </xpath>
        </field>
    </record>
</odoo>
