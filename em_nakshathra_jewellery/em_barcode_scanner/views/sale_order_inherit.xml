<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit the Sale Order form to inject the barcode scanner widget -->
    <record id="view_order_form_barcode_scanner_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.barcode.scanner</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Inject the barcode scanner widget just before the order_line field. -->
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']" position="before">
                <widget
                    name="barcode_scanner"
                    model="sale.order"
                    invisible="state in ('sale', 'cancel')"
                />
            </xpath>

            <!-- Inject the barcode scanner widget just before old_gold_line_ids -->
            <xpath expr="//field[@name='old_gold_line_ids']" position="before">
<!--                <widget-->
<!--                    name="barcode_scanner"-->
<!--                    model="sale.order"-->
<!--                    method="action_scan_barcode_old_gold"-->
<!--                    invisible="has_old_gold == False or old_gold_bill_id != False"-->
<!--                />-->
            </xpath>
        </field>
    </record>
</odoo>
