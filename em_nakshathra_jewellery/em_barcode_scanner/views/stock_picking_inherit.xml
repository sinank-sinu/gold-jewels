<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_barcode_scanner_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.barcode.scanner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page/field[@name='move_ids_without_package']" position="before">
                <widget
                    name="barcode_scanner"
                    model="stock.picking"
                    invisible="state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>
</odoo>
