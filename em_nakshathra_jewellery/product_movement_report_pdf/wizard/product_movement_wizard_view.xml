<odoo>
    <record id="view_product_movement_wizard" model="ir.ui.view">
        <field name="name">product.movement.wizard.form</field>
        <field name="model">product.movement.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Movement Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="source"/>
                    <field name="category_ids" widget="many2many_tags"/>
                </group>

                <footer>
                    <button name="action_print" string="Print PDF"
                            type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export XLSX" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_movement_wizard" model="ir.actions.act_window">
        <field name="name">Product Movement</field>
        <field name="res_model">product.movement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>