<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add branch_id to Employee Form View -->
    <record id="view_employee_form_inherit_transfer_branch" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.transfer.branch</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="after">
                <field name="branch_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Add branch_id to Employee Tree View -->
    <record id="view_employee_tree_inherit_transfer_branch" model="ir.ui.view">
        <field name="name">hr.employee.tree.inherit.transfer.branch</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][@optional='show']" position="after">
                <field name="branch_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
