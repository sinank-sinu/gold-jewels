<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_purchase_bulk_import" model="ir.module.category">
        <field name="name">Purchase Bulk Import</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_po_bulk_import_manager" model="res.groups">
