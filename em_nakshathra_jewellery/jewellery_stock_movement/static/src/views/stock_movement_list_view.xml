<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="jewellery_stock_movement.StockMovementListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='props.Renderer']" position="before">
            <div class="o_stock_movement_dashboard p-3">
                <!-- Filters Row -->
                <div class="o_sm_filter_card p-3 mb-3">
                    <div class="row g-3 align-items-end">
                        <!-- Warehouse Selector -->
                        <div class="col-12 col-md-4 col-lg-3">
                            <label class="form-label fw-bold text-secondary small mb-1">
                                <i class="fa fa-building text-primary me-1"/> Warehouse
                            </label>
                            <select class="form-select form-select-sm fw-semibold"
                                    t-att-value="state.selectedWarehouseId"
                                    t-on-change="onWarehouseChange">
                                <option value="">All Warehouses</option>
                                <t t-foreach="state.warehouses" t-as="wh" t-key="wh.id">
                                    <option t-att-value="wh.id"
                                            t-att-selected="state.selectedWarehouseId == wh.id ? 'selected' : undefined"
                                            t-esc="wh.name"/>
                                </t>
                            </select>
                        </div>

                        <!-- Date Range: From Date -->
                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label fw-bold text-secondary small mb-1">
                                <i class="fa fa-calendar text-info me-1"/> From Date
                            </label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   t-att-value="state.dateFrom"
                                   t-on-change="onDateFromChange"/>
                        </div>

                        <!-- Date Range: To Date -->
                        <div class="col-6 col-md-3 col-lg-2">
                            <label class="form-label fw-bold text-secondary small mb-1">
                                <i class="fa fa-calendar text-info me-1"/> To Date
                            </label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   t-att-value="state.dateTo"
                                   t-on-change="onDateToChange"/>
                        </div>

                        <!-- Action Buttons & Quick Presets -->
                        <div class="col-12 col-md-12 col-lg-5 d-flex align-items-center gap-2 flex-wrap">
                            <button class="btn btn-sm btn-primary px-3 shadow-sm fw-semibold"
                                    t-on-click="onApplyFilter"
                                    t-att-disabled="state.isLoading">
                                <i class="fa fa-filter me-1"/> Apply
                            </button>
                            <button class="btn btn-sm btn-outline-secondary px-3"
                                    t-on-click="onResetFilter"
                                    t-att-disabled="state.isLoading">
                                <i class="fa fa-undo me-1"/> Reset
                            </button>

                            <!-- Date Presets -->
                            <div class="btn-group btn-group-sm ms-auto" role="group">
                                <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="setFilterToday">Today</button>
                                <button type="button" class="btn btn-outline-primary btn-sm" t-on-click="setFilterThisMonth">This Month</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="setFilterAllDates">All Dates</button>
                            </div>

                            <span t-if="state.isLoading" class="spinner-border spinner-border-sm text-primary ms-2" role="status"/>
                        </div>
                    </div>
                </div>

                <!-- KPI Summary Cards Row -->
                <div class="row g-3">
                    <!-- Total Products Card -->
                    <div class="col-12 col-md-4">
                        <div class="o_sm_kpi_card d-flex align-items-center">
                            <div class="o_sm_kpi_icon primary me-3">
                                <i class="fa fa-cubes"/>
                            </div>
                            <div class="flex-grow-1">
                                <div class="o_sm_kpi_title">Total Products</div>
                                <div class="o_sm_kpi_value" t-esc="formatNumber(state.summary.total_products)"/>
                            </div>
                        </div>
                    </div>

                    <!-- Total Variants Card -->
                    <div class="col-12 col-md-4">
                        <div class="o_sm_kpi_card d-flex align-items-center">
                            <div class="o_sm_kpi_icon success me-3">
                                <i class="fa fa-tags"/>
                            </div>
                            <div class="flex-grow-1">
                                <div class="o_sm_kpi_title">Total Product Variants</div>
                                <div class="o_sm_kpi_value" t-esc="formatNumber(state.summary.total_variants)"/>
                            </div>
                        </div>
                    </div>

                    <!-- Total Stock Weight Card -->
                    <div class="col-12 col-md-4">
                        <div class="o_sm_kpi_card d-flex align-items-center">
                            <div class="o_sm_kpi_icon warning me-3">
                                <i class="fa fa-balance-scale"/>
                            </div>
                            <div class="flex-grow-1">
                                <div class="o_sm_kpi_title">Total Stock Weight</div>
                                <div class="d-flex align-items-baseline">
                                    <span class="o_sm_kpi_value" t-esc="formatWeight(state.summary.total_weight)"/>
                                    <span class="o_sm_kpi_unit">grams</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
