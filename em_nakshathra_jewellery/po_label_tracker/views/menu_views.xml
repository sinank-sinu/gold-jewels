<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_po_label_tracker" model="ir.actions.act_window">
        <field name="name">PO Labels</field>
        <field name="res_model">po.label.tracker</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Select or add a Purchase Order to track its product labels, total weight, current locations, remaining unlabelled weight, and active status.
            </p>
        </field>
    </record>

    <!-- Menu item next to Internal Transfers in Product Labels App -->
    <menuitem
        id="menu_po_label_tracker"
        name="PO Labels"
        parent="ornament_label.menu_product_label_app"
        action="action_po_label_tracker"
        sequence="35"
        groups="custom_label_user.group_product_label_user,base.group_system"
    />

</odoo>
