{
  "api_name": "E-commerce API",
  "version": "1.0",
  "base_url": "/api/ecommerce",
  "endpoints": [
    {
      "endpoint": "/register",
      "method": "POST",
      "description": "Register a new customer and receive authentication token",
      "authentication": "public",
      "cors": "*",
      "csrf": false,
      "step_by_step_flows": [
        {
          "flow_id": 1,
          "flow_name": "Customer Registration",
          "description": "Register a new customer and receive authentication token",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with customer details",
              "request": {
                "first_name": "John",
                "last_name": "Doe",
                "phone": "1234567890",
                "city": "Calicut",
                "email": "customer@example.com",
                "password": "password123",
                "confirm_password": "password123"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API validates input, checks for duplicate email, hashes password, creates customer, and generates authentication token"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get customer details and authentication token",
              "response": {
                "status": "success",
                "message": "Registration successful",
                "data": {
                  "customer_id": 1,
                  "name": "John Doe",
                  "email": "customer@example.com",
                  "phone": "1234567890",
                  "city": "Calicut",
                  "auth_token": "abc123xyz456...",
                  "token_expiry": "2026-08-09 10:30:00"
                }
              }
            }
          ]
        },
        {
          "flow_id": 2,
          "flow_name": "Error - Duplicate Email",
          "description": "Error handling when email already exists",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with existing email",
              "request": {
                "first_name": "Jane",
                "last_name": "Smith",
                "phone": "9876543210",
                "city": "Kochi",
                "email": "customer@example.com",
                "password": "password456",
                "confirm_password": "password456"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects duplicate email and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating email already exists",
              "response": {
                "status": "error",
                "message": "An account with this email already exists"
              }
            }
          ]
        },
        {
          "flow_id": 3,
          "flow_name": "Error - Password Mismatch",
          "description": "Error handling when passwords do not match",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with mismatched passwords",
              "request": {
                "first_name": "Jane",
                "last_name": "Smith",
                "phone": "9876543210",
                "city": "Kochi",
                "email": "jane@example.com",
                "password": "password456",
                "confirm_password": "password789"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects password mismatch and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating passwords do not match",
              "response": {
                "status": "error",
                "message": "Passwords do not match"
              }
            }
          ]
        },
        {
          "flow_id": 4,
          "flow_name": "Error - Missing Fields",
          "description": "Error handling when required fields are missing",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request without required fields",
              "request": {
                "first_name": "Jane",
                "last_name": "Smith"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects missing fields and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating missing fields",
              "response": {
                "status": "error",
                "message": "Missing fields: phone, city, email, password, confirm_password"
              }
            }
          ]
        }
      ],
      "request_parameters": {
        "required": [
          {
            "name": "first_name",
            "type": "string",
            "description": "Customer first name"
          },
          {
            "name": "last_name",
            "type": "string",
            "description": "Customer last name"
          },
          {
            "name": "phone",
            "type": "string",
            "description": "Customer phone number"
          },
          {
            "name": "city",
            "type": "string",
            "description": "Customer city"
          },
          {
            "name": "email",
            "type": "string",
            "description": "Customer email address"
          },
          {
            "name": "password",
            "type": "string",
            "description": "Customer password (minimum 6 characters)"
          },
          {
            "name": "confirm_password",
            "type": "string",
            "description": "Confirm password (must match password)"
          }
        ]
      },
      "response_fields": {
        "registration_data": {
          "customer_id": "Customer ID",
          "name": "Customer full name",
          "email": "Customer email",
          "phone": "Customer phone number",
          "city": "Customer city",
          "auth_token": "Authentication token (use this for subsequent API calls)",
          "token_expiry": "Token expiration date (30 days from registration)"
        }
      }
    },
    {
      "endpoint": "/branch_products",
      "method": "POST",
      "description": "Get products for a specific branch with location-wise stock information",
      "authentication": "public",
      "cors": "*",
      "csrf": false,
      "step_by_step_flows": [
        {
          "flow_id": 1,
          "flow_name": "Get All Branch Products with Location Stocks",
          "description": "Retrieve all products for a branch showing stock across all locations",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with branch name",
              "request": {
                "branch_name": "Calicut"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API resolves branch name to branch ID, gets all branch locations, and queries products"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get products with stock information across all locations",
              "response": {
                "status": "success",
                "branch": "Calicut",
                "count": 10,
                "data": [
                  {
                    "id": 123,
                    "name": "Gold Ring",
                    "price": 15000.0,
                    "description": "22K Gold Ring with diamonds",
                    "image_url": "/web/image/product.template/123/image_1920",
                    "branch_id": 1,
                    "branch_name": "Calicut",
                    "total_stock": 15,
                    "available_locations": ["wh/stock", "Rifan/stock"],
                    "location_stocks": [
                      {
                        "location_id": 5,
                        "location_name": "wh/stock",
                        "location_complete_name": "Calicut/wh/stock",
                        "product_name": "Gold Ring",
                        "price": 15000.0,
                        "description": "22K Gold Ring with diamonds",
                        "image_url": "/web/image/product.template/123/image_1920",
                        "quantity": 10
                      },
                      {
                        "location_id": 6,
                        "location_name": "Rifan/stock",
                        "location_complete_name": "Calicut/Rifan/stock",
                        "product_name": "Gold Ring",
                        "price": 15000.0,
                        "description": "22K Gold Ring with diamonds",
                        "image_url": "/web/image/product.template/123/image_1920",
                        "quantity": 5
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "flow_id": 2,
          "flow_name": "Filter Products by Location ID",
          "description": "Get products for a branch filtered by specific location ID",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with branch name and location ID",
              "request": {
                "branch_name": "Calicut",
                "location_id": 5
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API resolves branch, filters by specific location ID, and queries products with stock at that location"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get products filtered by specific location with location filter info",
              "response": {
                "status": "success",
                "branch": "Calicut",
                "count": 5,
                "location_filter": {
                  "location_id": 5,
                  "location_name": "wh/stock",
                  "location_complete_name": "Calicut/wh/stock"
                },
                "data": [
                  {
                    "id": 123,
                    "name": "Gold Ring",
                    "price": 15000.0,
                    "description": "22K Gold Ring with diamonds",
                    "image_url": "/web/image/product.template/123/image_1920",
                    "branch_id": 1,
                    "branch_name": "Calicut",
                    "total_stock": 10,
                    "available_locations": ["wh/stock"],
                    "location_stocks": [
                      {
                        "location_id": 5,
                        "location_name": "wh/stock",
                        "location_complete_name": "Calicut/wh/stock",
                        "product_name": "Gold Ring",
                        "price": 15000.0,
                        "description": "22K Gold Ring with diamonds",
                        "image_url": "/web/image/product.template/123/image_1920",
                        "quantity": 10
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "flow_id": 3,
          "flow_name": "Filter Products by Location Name",
          "description": "Get products for a branch filtered by location name",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with branch name and location name",
              "request": {
                "branch_name": "Calicut",
                "location_name": "Rifan/stock"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API resolves branch, filters by location name using case-insensitive search, and queries products"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get products filtered by location name with location filter info",
              "response": {
                "status": "success",
                "branch": "Calicut",
                "count": 3,
                "location_filter": {
                  "location_name": "Rifan/stock"
                },
                "data": [
                  {
                    "id": 124,
                    "name": "Gold Necklace",
                    "price": 25000.0,
                    "description": "24K Gold Necklace",
                    "image_url": "/web/image/product.template/124/image_1920",
                    "branch_id": 1,
                    "branch_name": "Calicut",
                    "total_stock": 8,
                    "available_locations": ["Rifan/stock"],
                    "location_stocks": [
                      {
                        "location_id": 6,
                        "location_name": "Rifan/stock",
                        "location_complete_name": "Calicut/Rifan/stock",
                        "product_name": "Gold Necklace",
                        "price": 25000.0,
                        "description": "24K Gold Necklace",
                        "image_url": "/web/image/product.template/124/image_1920",
                        "quantity": 8
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "flow_id": 4,
          "flow_name": "Using Branch ID Instead of Name",
          "description": "Get products using branch ID instead of branch name",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with branch ID instead of name",
              "request": {
                "branch_id": 1
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API uses branch ID directly, gets all branch locations, and queries products"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get products with stock information across all locations",
              "response": {
                "status": "success",
                "branch": "Calicut",
                "count": 10,
                "data": [
                  {
                    "id": 123,
                    "name": "Gold Ring",
                    "price": 15000.0,
                    "description": "22K Gold Ring with diamonds",
                    "image_url": "/web/image/product.template/123/image_1920",
                    "branch_id": 1,
                    "branch_name": "Calicut",
                    "total_stock": 15,
                    "available_locations": ["wh/stock", "Rifan/stock"],
                    "location_stocks": [
                      {
                        "location_id": 5,
                        "location_name": "wh/stock",
                        "location_complete_name": "Calicut/wh/stock",
                        "product_name": "Gold Ring",
                        "price": 15000.0,
                        "description": "22K Gold Ring with diamonds",
                        "image_url": "/web/image/product.template/123/image_1920",
                        "quantity": 10
                      },
                      {
                        "location_id": 6,
                        "location_name": "Rifan/stock",
                        "location_complete_name": "Calicut/Rifan/stock",
                        "product_name": "Gold Ring",
                        "price": 15000.0,
                        "description": "22K Gold Ring with diamonds",
                        "image_url": "/web/image/product.template/123/image_1920",
                        "quantity": 5
                      }
                    ]
                  }
                ]
              }
            }
          ]
        },
        {
          "flow_id": 5,
          "flow_name": "Error - Missing Branch Information",
          "description": "Error handling when neither branch_id nor branch_name is provided",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request without branch information",
              "request": {}
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects missing required parameters and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating missing branch information",
              "response": {
                "status": "error",
                "message": "branch_id or branch_name is required"
              }
            }
          ]
        },
        {
          "flow_id": 6,
          "flow_name": "Error - Branch Not Found",
          "description": "Error handling when branch name doesn't exist",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with non-existent branch name",
              "request": {
                "branch_name": "NonExistentBranch"
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API searches for branch but finds no match, returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating branch not found",
              "response": {
                "status": "error",
                "message": "Branch 'NonExistentBranch' not found"
              }
            }
          ]
        }
      ],
      "request_parameters": {
        "required": [
          {
            "name": "branch_id",
            "type": "integer",
            "description": "ID of the branch (required if branch_name not provided)"
          },
          {
            "name": "branch_name", 
            "type": "string",
            "description": "Name of the branch (required if branch_id not provided)"
          }
        ],
        "optional": [
          {
            "name": "location_id",
            "type": "integer", 
            "description": "Filter products by specific location ID"
          },
          {
            "name": "location_name",
            "type": "string",
            "description": "Filter products by location name (e.g., 'wh/stock', 'Rifan/stock')"
          }
        ]
      },
      "response_fields": {
        "product_data": {
          "id": "Product template ID",
          "name": "Product name",
          "price": "List price of the product",
          "description": "Product description (sale description or general description)",
          "image_url": "URL to product image",
          "branch_id": "Branch ID (null if shared across all branches)",
          "branch_name": "Branch name (or 'All Branches' if shared)",
          "total_stock": "Total stock quantity across all locations in the branch",
          "available_locations": "Array of location names where product has stock",
          "location_stocks": "Array of detailed stock information per location"
        },
        "location_stock": {
          "location_id": "Location ID",
          "location_name": "Location name (e.g., 'wh/stock')",
          "location_complete_name": "Full location path (e.g., 'Calicut/wh/stock')",
          "product_name": "Product name at this location",
          "price": "Product price",
          "description": "Product description",
          "image_url": "Product image URL",
          "quantity": "Stock quantity at this specific location"
        }
      }
    },
    {
      "endpoint": "/cart/add",
      "method": "POST",
      "description": "Add a product to the customer's shopping cart",
      "authentication": "public",
      "cors": "*",
      "csrf": false,
      "step_by_step_flows": [
        {
          "flow_id": 1,
          "flow_name": "Add Product to Cart",
          "description": "Add a product to customer's cart with specified quantity",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with authentication token, product ID, and quantity",
              "request": {
                "auth_token": "abc123xyz456...",
                "product_id": 123,
                "quantity": 2
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API validates token and customer, gets or creates cart, adds item to cart"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get success response with updated cart information",
              "response": {
                "status": "success",
                "message": "Item added to cart",
                "cart": {
                  "cart_id": 1,
                  "customer_id": 1,
                  "total_amount": 30000.0,
                  "items": [
                    {
                      "cart_line_id": 1,
                      "product_id": 123,
                      "product_name": "Gold Ring",
                      "image_url": "/web/image/product.template/123/image_1920",
                      "quantity": 2,
                      "unit_price": 15000.0,
                      "subtotal": 30000.0
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "flow_id": 2,
          "flow_name": "Add Product to Cart with Location",
          "description": "Add a product to cart from a specific location",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with customer ID, product ID, and location name",
              "request": {
                "customer_id": 1,
                "product_id": 113,
                "location_name": "wh/stock",
                "quantity": 2
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API validates customer, product, and location, checks stock at that location, adds item to cart"
            },
            {
              "step": 3,
              "action": "Receive Response",
              "description": "Get success response with cart showing product from specific location",
              "response": {
                "status": "success",
                "message": "Item added to cart",
                "cart": {
                  "cart_id": 1,
                  "customer_id": 1,
                  "total_amount": 30000.0,
                  "items": [
                    {
                      "cart_line_id": 1,
                      "product_id": 113,
                      "product_name": "Gold Ring",
                      "image_url": "/web/image/product.template/113/image_1920",
                      "location_id": 5,
                      "location_name": "wh/stock",
                      "quantity": 2,
                      "unit_price": 15000.0,
                      "subtotal": 30000.0
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "flow_id": 3,
          "flow_name": "Add Same Product from Different Locations",
          "description": "Add same product from different locations creates separate cart lines",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Add product from first location",
              "request": {
                "customer_id": 1,
                "product_id": 113,
                "location_name": "wh/stock",
                "quantity": 2
              }
            },
            {
              "step": 2,
              "action": "Prepare Request",
              "description": "Add same product from second location",
              "request": {
                "customer_id": 1,
                "product_id": 113,
                "location_name": "Rifan/stock",
                "quantity": 1
              }
            },
            {
              "step": 3,
              "action": "API Processing",
              "description": "API creates separate cart lines for each location"
            },
            {
              "step": 4,
              "action": "Receive Response",
              "description": "Get cart with two lines for same product from different locations",
              "response": {
                "status": "success",
                "message": "Item added to cart",
                "cart": {
                  "cart_id": 1,
                  "customer_id": 1,
                  "total_amount": 45000.0,
                  "items": [
                    {
                      "cart_line_id": 1,
                      "product_id": 113,
                      "product_name": "Gold Ring",
                      "image_url": "/web/image/product.template/113/image_1920",
                      "location_id": 5,
                      "location_name": "wh/stock",
                      "quantity": 2,
                      "unit_price": 15000.0,
                      "subtotal": 30000.0
                    },
                    {
                      "cart_line_id": 2,
                      "product_id": 113,
                      "product_name": "Gold Ring",
                      "image_url": "/web/image/product.template/113/image_1920",
                      "location_id": 6,
                      "location_name": "Rifan/stock",
                      "quantity": 1,
                      "unit_price": 15000.0,
                      "subtotal": 15000.0
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "flow_id": 4,
          "flow_name": "Error - Insufficient Stock at Location",
          "description": "Error handling when requested quantity exceeds stock at specific location",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with quantity exceeding stock at location",
              "request": {
                "customer_id": 1,
                "product_id": 113,
                "location_name": "wh/stock",
                "quantity": 20
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API checks stock at specific location and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating insufficient stock at location",
              "response": {
                "status": "error",
                "message": "Only 10 units available at wh/stock"
              }
            }
          ]
        },
        {
          "flow_id": 5,
          "flow_name": "Error - Missing Required Parameters",
          "description": "Error handling when required parameters are missing",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request without auth_token or product_id",
              "request": {
                "quantity": 2
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects missing required parameters and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating missing parameters",
              "response": {
                "status": "error",
                "message": "auth_token and product_id are required"
              }
            }
          ]
        },
        {
          "flow_id": 6,
          "flow_name": "Error - Invalid Quantity",
          "description": "Error handling when quantity is zero or negative",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request with invalid quantity",
              "request": {
                "customer_id": 1,
                "product_id": 123,
                "quantity": 0
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API detects invalid quantity and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating invalid quantity",
              "response": {
                "status": "error",
                "message": "Quantity must be greater than 0"
              }
            }
          ]
        },
        {
          "flow_id": 7,
          "flow_name": "Error - Product Out of Stock",
          "description": "Error handling when product has no stock available",
          "steps": [
            {
              "step": 1,
              "action": "Prepare Request",
              "description": "Create POST request for product with zero stock",
              "request": {
                "auth_token": "abc123xyz456...",
                "product_id": 999,
                "quantity": 1
              }
            },
            {
              "step": 2,
              "action": "API Processing",
              "description": "API checks stock availability and returns error"
            },
            {
              "step": 3,
              "action": "Receive Error Response",
              "description": "Get error message indicating product is out of stock",
              "response": {
                "status": "error",
                "message": "Product is out of stock"
              }
            }
          ]
        },
        {
          "flow_id": 8,
          "flow_name": "Error - Insufficient Stock",
          "description": "Error handling when requested quantity exceeds available stock",
          "steps": [
