<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- eCommerce API Control Form View -->
    <record id="ecommerce_api_control_view_form" model="ir.ui.view">
        <field name="name">ecommerce.api.control.form</field>
        <field name="model">ecommerce.api.control</field>
        <field name="arch" type="xml">
            <form string="eCommerce API Control" create="false" delete="false">
                <header>
                    <button name="action_disable_api"
                            type="object"
                            string="Stop eCommerce API"
                            class="btn-danger"
                            icon="fa-power-off"
                            invisible="not is_enabled"
                            confirm="Are you sure you want to stop the eCommerce API? All external requests will be rejected."/>
                    <button name="action_enable_api"
                            type="object"
                            string="Start eCommerce API"
                            class="btn-success"
                            icon="fa-play"
                            invisible="is_enabled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="API ACTIVE" bg_color="text-bg-success" invisible="not is_enabled"/>
                    <widget name="web_ribbon" title="API STOPPED" bg_color="text-bg-danger" invisible="is_enabled"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" invisible="1"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group string="API Operational Switch">
                        <group>
                            <field name="is_enabled" widget="boolean_toggle" string="API Switch (ON / OFF)"/>
                        </group>
                        <group>
                            <field name="status_badge" widget="badge" decoration-success="is_enabled" decoration-danger="not is_enabled"/>
                        </group>
                    </group>

                    <group string="Notice Message (Returned When Disabled)">
                        <field name="disabled_message" placeholder="Message to return in API response when disabled..."/>
                    </group>

                    <group string="Audit Information">
                        <group>
                            <field name="last_toggled_by"/>
                        </group>
                        <group>
                            <field name="last_toggled_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_ecommerce_api_control" model="ir.actions.act_window">
        <field name="name">eCommerce API Control</field>
        <field name="res_model">ecommerce.api.control</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="ecommerce_api.record_ecommerce_api_control"/>
        <field name="target">current</field>
    </record>

    <!-- Top-Level Menu: eCommerce API -->
    <menuitem id="menu_ecommerce_api_root"
              name="eCommerce API"
              web_icon="ecommerce_api,static/description/icon.png"
              sequence="85"
              groups="base.group_system"/>

    <!-- Sub-Menu: API Switch / Control -->
    <menuitem id="menu_ecommerce_api_control"
              name="API Switch / Control"
              parent="menu_ecommerce_api_root"
              action="action_ecommerce_api_control"
              sequence="1"/>
</odoo>
